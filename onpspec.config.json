{
  "testCommand": "powershell -ExecutionPolicy Bypass -File scripts/verify-spec.ps1",
  "reporter": "jest-json",
  "testGlobs": [
    "tests/**/*.cs"
  ],
  "srcGlobs": [
    "src/**/*.cs"
  ],
  "ignoreGlobs": [
    "node_modules/**",
    ".git/**",
    "dist/**",
    "build/**",
    "coverage/**",
    ".spec/**",
    "**/bin/**",
    "**/obj/**",
    "**/Migrations/**"
  ],
  "reporterOutputFile": ".spec/verification/test-results.json"
}
