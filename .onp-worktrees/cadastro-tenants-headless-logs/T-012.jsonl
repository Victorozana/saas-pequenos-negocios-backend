namespace Agendamento.Domain.Tenants;

/// <summary>
/// Brazilian CNPJ in its canonical fourteen-character representation.
/// </summary>
public sealed class Cnpj : IEquatable<Cnpj>
{
    private const int Length = 14;

    private Cnpj(string value)
    {
        Value = value;
    }

    public string Value { get; }

    public static Cnpj Create(string value) => Parse(value);

    public static Cnpj Parse(string value)
    {
        if (!TryParse(value, out var cnpj))
        {
            throw new ArgumentException("O CNPJ deve ter formato e dígitos verificadores válidos.", nameof(value));
        }

        return cnpj!;
    }

    public static bool TryParse(string? value, out Cnpj? cnpj)
    {
        cnpj = null;

        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        var normalized = NormalizeMaskAndCase(value);
        if (normalized is null || !HasValidCharacters(normalized) || !HasValidCheckDigits(normalized))
        {
            return false;
        }

        cnpj = new Cnpj(normalized);
        return true;
    }

    public static bool IsValid(string? value) => TryParse(value, out _);

    public override string ToString() => Value;

    public bool Equals(Cnpj? other) =>
        other is not null && string.Equals(Value, other.Value, StringComparison.Ordinal);

    public override bool Equals(object? obj) => obj is Cnpj other && Equals(other);

    public override int GetHashCode() => StringComparer.Ordinal.GetHashCode(Value);

    public static bool operator ==(Cnpj? left, Cnpj? right) => Equals(left, right);

    public static bool operator !=(Cnpj? left, Cnpj? right) => !Equals(left, right);

    private static string? NormalizeMaskAndCase(string value)
    {
        var normalized = new char[Length];
        var position = 0;

        foreach (var character in value.Trim())
        {
            if (character is '.' or '/' or '-')
            {
                continue;
            }

            if (position == Length || !IsAsciiLetterOrDigit(character))
            {
                return null;
            }

            normalized[position++] = char.ToUpperInvariant(character);
        }

        return position == Length ? new string(normalized) : null;
    }

    private static bool HasValidCharacters(string value)
    {
        for (var position = 0; position < Length - 2; position++)
        {
            if (!IsAsciiLetterOrDigit(value[position]))
            {
                return false;
            }
        }

        return char.IsAsciiDigit(value[Length - 2]) && char.IsAsciiDigit(value[Length - 1]);
    }

    private static bool HasValidCheckDigits(string value)
    {
        var firstCheckDigit = CalculateCheckDigit(value.AsSpan(0, Length - 2), 5);
        if (value[Length - 2] - '0' != firstCheckDigit)
        {
            return false;
        }

        var secondCheckDigit = CalculateCheckDigit(value.AsSpan(0, Length - 1), 6);
        return value[Length - 1] - '0' == secondCheckDigit;
    }

    private static int CalculateCheckDigit(ReadOnlySpan<char> value, int firstWeight)
    {
        var sum = 0;
        var weight = firstWeight;

        foreach (var character in value)
        {
            sum += (character - 48) * weight;
            weight = weight == 2 ? 9 : weight - 1;
        }

        var remainder = sum % 11;
        return remainder < 2 ? 0 : 11 - remainder;
    }

    private static bool IsAsciiLetterOrDigit(char value) =>
        char.IsAsciiLetter(value) || char.IsAsciiDigit(value);
}
using Agendamento.Application.Identity;
using Agendamento.Domain.Identity;

namespace Agendamento.Application.Identity.CreateSession;

public sealed class CreateSessionHandler(
    IIdentityAuthenticationStore identities,
    IPasswordService passwords,
    ISessionIssuer sessions)
{
    public async Task<CreateSessionOutcome> HandleAsync(
        CreateSessionCommand command,
        CancellationToken cancellationToken = default)
    {
        string normalizedEmail;
        try
        {
            normalizedEmail = User.NormalizeEmail(command.Email);
        }
        catch (ArgumentException)
        {
            return CreateSessionOutcome.InvalidCredentials;
        }
        var identity = await identities.FindByNormalizedEmailAsync(normalizedEmail, cancellationToken);

        if (identity is null || !passwords.Verify(identity.PasswordHash, command.Password) || !identity.IsActive)
        {
            return CreateSessionOutcome.InvalidCredentials;
        }

        if (!identity.IsEmailVerified)
        {
            return CreateSessionOutcome.EmailVerificationRequired;
        }

        if (identity.ActiveMembership is null)
        {
            return CreateSessionOutcome.InvalidCredentials;
        }

        var issued = sessions.Issue(new SessionPrincipal(
            identity.UserId,
            identity.ActiveMembership.TenantId,
            identity.ActiveMembership.Role));

        return new CreateSessionOutcome(issued.AccessToken, issued.ExpiresAt, null);
    }
}

public sealed record CreateSessionOutcome(string? AccessToken, DateTimeOffset? ExpiresAt, string? Error)
{
    public static readonly CreateSessionOutcome InvalidCredentials = new(null, null, "invalid_credentials");
    public static readonly CreateSessionOutcome EmailVerificationRequired = new(null, null, "email_verification_required");
}
namespace Agendamento.Application.Identity.CreateSession;

public sealed record CreateSessionResult(string AccessToken, DateTimeOffset ExpiresAt);
using Agendamento.Domain.Tenants;
using Xunit;

namespace Agendamento.UnitTests.Tenants;

public sealed class CnpjTests
{
    [Fact(DisplayName = "CNPJ numérico legado e alfanumérico válidos são aceitos @spec:AC-014")]
    public void Parse_AcceptsValidLegacyAndAlphanumericCnpjs()
    {
        var legacy = Cnpj.Parse("04.252.011/0001-10");
        var alphanumeric = Cnpj.Parse("12.ABC.345/01DE-35");

        Assert.Equal("04252011000110", legacy.Value);
        Assert.Equal("12ABC34501DE35", alphanumeric.Value);
    }

    [Theory(DisplayName = "CNPJ inválido é rejeitado localmente @spec:AC-014")]
    [InlineData("04.252.011/0001-11")]
    [InlineData("12ABC34501DE34")]
    [InlineData("12ABC34501DE3F")]
    [InlineData("12ABC34501DÉ35")]
    [InlineData("12ABC34501DE3")]
    public void Parse_RejectsInvalidFormatOrCheckDigits(string value)
    {
        Assert.False(Cnpj.TryParse(value, out _));
        Assert.Throws<ArgumentException>(() => Cnpj.Parse(value));
    }

    [Fact(DisplayName = "CNPJ normalizado impede duplicidade por máscara ou caixa @spec:AC-022")]
    public void Parse_NormalizesMaskAndCase_ForGlobalUniqueness()
    {
        var formatted = Cnpj.Parse("12.ABC.345/01DE-35");
        var unformatted = Cnpj.Parse("12abc34501de35");

        Assert.Equal(formatted, unformatted);
        Assert.Equal("12ABC34501DE35", unformatted.Value);
    }
}
