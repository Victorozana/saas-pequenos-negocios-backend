antId,\r\n        string? stateRegistration,\r\n        string? municipalRegistration,\r\n        bool isStateRegistrationExempt,\r\n        TaxRegime taxRegime,\r\n        string fiscalEmail)\r\n    {\r\n        TenantId = tenantId;\r\n        StateRegistration = stateRegistration;\r\n        MunicipalRegistration = municipalRegistration;\r\n        IsStateRegistrationExempt = isStateRegistrationExempt;\r\n        TaxRegime = taxRegime;\r\n        FiscalEmail = fiscalEmail;\r\n    }\r\n\r\n    public Guid TenantId { get; }\r\n\r\n    public string? StateRegistration { get; }\r\n\r\n    public string? MunicipalRegistration { get; }\r\n\r\n    public bool IsStateRegistrationExempt { get; }\r\n\r\n    public TaxRegime TaxRegime { get; }\r\n\r\n    public string FiscalEmail { get; }\r\n\r\n    public static TenantFiscalProfile Create(\r\n        Guid tenantId,\r\n        TaxRegime taxRegime,\r\n        string fiscalEmail,\r\n        string? stateRegistration = null,\r\n        string? municipalRegistration = null,\r\n        bool isStateRegistrationExempt = false)\r\n    {\r\n        if (tenantId == Guid.Empty)\r\n        {\r\n            throw new ArgumentException(\"O tenant é obrigatório.\", nameof(tenantId));\r\n        }\r\n\r\n        if (!Enum.IsDefined(taxRegime))\r\n        {\r\n            throw new ArgumentOutOfRangeException(nameof(taxRegime));\r\n        }\r\n\r\n        return new TenantFiscalProfile(\r\n            tenantId,\r\n            NormalizeOptional(stateRegistration),\r\n            NormalizeOptional(municipalRegistration),\r\n            isStateRegistrationExempt,\r\n            taxRegime,\r\n            Required(fiscalEmail, nameof(fiscalEmail)));\r\n    }\r\n\r\n    private static string Required(string value, string parameterName)\r\n    {\r\n        ArgumentException.ThrowIfNullOrWhiteSpace(value, parameterName);\r\n        return value.Trim();\r\n    }\r\n\r\n    private static string? NormalizeOptional(string? value) =>\r\n        string.IsNullOrWhiteSpace(value) ? null : value.Trim();\r\n}\r\n\r\nFILE src\\Agendamento.Api\\Domain\\Tenants\\TenantMembership.cs\r\nnamespace Agendamento.Domain.Tenants;\r\n\r\npublic sealed class TenantMembership\r\n{\r\n    private TenantMembership(\r\n        Guid id,\r\n        Guid tenantId,\r\n        Guid userId,\r\n        TenantRole role,\r\n        bool isLegalRepresentative,\r\n        string position,\r\n        DateTimeOffset createdAtUtc)\r\n    {\r\n        Id = id;\r\n        TenantId = tenantId;\r\n        UserId = userId;\r\n        Role = role;\r\n        IsLegalRepresentative = isLegalRepresentative;\r\n        Position = position;\r\n        CreatedAtUtc = createdAtUtc;\r\n    }\r\n\r\n    public Guid Id { get; }\r\n\r\n    public Guid TenantId { get; }\r\n\r\n    public Guid UserId { get; }\r\n\r\n    public TenantRole Role { get; }\r\n\r\n    public bool IsLegalRepresentative { get; }\r\n\r\n    public string Position { get; }\r\n\r\n    public DateTimeOffset CreatedAtUtc { get; }\r\n\r\n    public static TenantMembership CreateOwnerAdmin(\r\n        Guid tenantId,\r\n        Guid userId,\r\n        bool isLegalRepresentative,\r\n        string position)\r\n    {\r\n        if (tenantId == Guid.Empty)\r\n        {\r\n            throw new ArgumentException(\"O tenant é obrigatório.\", nameof(tenantId));\r\n        }\r\n\r\n        if (userId == Guid.Empty)\r\n        {\r\n            throw new ArgumentException(\"O usuário é obrigatório.\", nameof(userId));\r\n        }\r\n\r\n        ArgumentException.ThrowIfNullOrWhiteSpace(position);\r\n\r\n        return new TenantMembership(\r\n            Guid.NewGuid(),\r\n            tenantId,\r\n            userId,\r\n            TenantRole.OwnerAdmin,\r\n            isLegalRepresentative,\r\n            position.Trim(),\r\n            DateTimeOffset.UtcNow);\r\n    }\r\n}\r\n\r\nFILE src\\Agendamento.Api\\Domain\\Tenants\\TenantRole.cs\r\nnamespace Agendamento.Domain.Tenants;\r\n\r\npublic enum TenantRole\r\n{\r\n    OwnerAdmin = 0,\r\n}\r\n\r\nFILE src\\Agendamento.Api\\Domain\\Tenants\\TaxRegime.cs\r\nnamespace Agendamento.Domain.Tenants;\r\n\r\npublic enum TaxRegime\r\n{\r\n    SimplesNacional = 0,\r\n    LucroPresumido = 1,\r\n    LucroReal = 2,\r\n}\r\n\r\nFILE src\\Agendamento.Api\\Domain\\Tenants\\BusinessCategory.cs\r\nnamespace Agendamento.Domain.Tenants;\r\n\r\npublic enum BusinessCategory\r\n{\r\n    Restaurant = 0,\r\n    Supermarket = 1,\r\n    GroceryStore = 2,\r\n    Bakery = 3,\r\n}\r\n\r\nFILE src\\Agendamento.Api\\Domain\\Tenants\\Cnpj.cs\r\nnamespace Agendamento.Domain.Tenants;\r\n\r\n/// <summary>\r\n/// Brazilian CNPJ in its canonical fourteen-character representation.\r\n/// </summary>\r\npublic sealed class Cnpj : IEquatable<Cnpj>\r\n{\r\n    private const int Length = 14;\r\n\r\n    private Cnpj(string value)\r\n    {\r\n        Value = value;\r\n    }\r\n\r\n    public string Value { get; }\r\n\r\n    public static Cnpj Create(string value) => Parse(value);\r\n\r\n    public static Cnpj Parse(string value)\r\n    {\r\n        if (!TryParse(value, out var cnpj))\r\n        {\r\n            throw new ArgumentException(\"O CNPJ deve ter formato e dígitos verificadores válidos.\", nameof(value));\r\n        }\r\n\r\n        return cnpj!;\r\n    }\r\n\r\n    public static bool TryParse(string? value, out Cnpj? cnpj)\r\n    {\r\n        cnpj = null;\r\n\r\n        if (string.IsNullOrWhiteSpace(value))\r\n        {\r\n            return false;\r\n        }\r\n\r\n        var normalized = NormalizeMaskAndCase(value);\r\n        if (normalized is null || !HasValidCharacters(normalized) || !HasValidCheckDigits(normalized))\r\n        {\r\n            return false;\r\n        }\r\n\r\n        cnpj = new Cnpj(normalized);\r\n        return true;\r\n    }\r\n\r\n    public static bool IsValid(string? value) => TryParse(value, out _);\r\n\r\n    public override string ToString() => Value;\r\n\r\n    public bool Equals(Cnpj? other) =>\r\n        other is not null && string.Equals(Value, other.Value, StringComparison.Ordinal);\r\n\r\n    public override bool Equals(object? obj) => obj is Cnpj other && Equals(other);\r\n\r\n    public override int GetHashCode() => StringComparer.Ordinal.GetHashCode(Value);\r\n\r\n    public static bool operator ==(Cnpj? left, Cnpj? right) => Equals(left, right);\r\n\r\n    public static bool operator !=(Cnpj? left, Cnpj? right) => !Equals(left, right);\r\n\r\n    private static string? NormalizeMaskAndCase(string value)\r\n    {\r\n        var normalized = new char[Length];\r\n        var position = 0;\r\n\r\n        foreach (var character in value.Trim())\r\n        {\r\n            if (character is '.' or '/' or '-')\r\n            {\r\n                continue;\r\n            }\r\n\r\n            if (position == Length || !IsAsciiLetterOrDigit(character))\r\n            {\r\n                return null;\r\n            }\r\n\r\n            normalized[position++] = char.ToUpperInvariant(character);\r\n        }\r\n\r\n        return position == Length ? new string(normalized) : null;\r\n    }\r\n\r\n    private static bool HasValidCharacters(string value)\r\n    {\r\n        for (var position = 0; position < Length - 2; position++)\r\n        {\r\n            if (!IsAsciiLetterOrDigit(value[position]))\r\n            {\r\n                return false;\r\n            }\r\n        }\r\n\r\n        return char.IsAsciiDigit(value[Length - 2]) && char.IsAsciiDigit(value[Length - 1]);\r\n    }\r\n\r\n    private static bool HasValidCheckDigits(string value)\r\n    {\r\n        var firstCheckDigit = CalculateCheckDigit(value.AsSpan(0, Length - 2), 5);\r\n        if (value[Length - 2] - '0' != firstCheckDigit)\r\n        {\r\n            return false;\r\n        }\r\n\r\n        var secondCheckDigit = CalculateCheckDigit(value.AsSpan(0, Length - 1), 6);\r\n        return value[Length - 1] - '0' == secondCheckDigit;\r\n    }\r\n\r\n    private static int CalculateCheckDigit(ReadOnlySpan<char> value, int firstWeight)\r\n    {\r\n        var sum = 0;\r\n        var weight = firstWeight;\r\n\r\n        foreach (var character in value)\r\n        {\r\n            sum += (character - 48) * weight;\r\n            weight = weight == 2 ? 9 : weight - 1;\r\n        }\r\n\r\n        var remainder = sum % 11;\r\n        return remainder < 2 ? 0 : 11 - remainder;\r\n    }\r\n\r\n    private static bool IsAsciiLetterOrDigit(char value) =>\r\n        char.IsAsciiLetter(value) || char.IsAsciiDigit(value);\r\n}\r\n\r\nFILE src\\Agendamento.Api\\Domain\\Identity\\User.cs\r\nusing System.Globalization;\r\n\r\nnamespace Agendamento.Domain.Identity;\r\n\r\npublic sealed class User\r\n{\r\n    private User()\r\n    {\r\n    }\r\n\r\n    public Guid Id { get; private set; }\r\n\r\n    public string Cpf { get; private set; } = null!;\r\n\r\n    public string Email { get; private set; } = null!;\r\n\r\n    public string PasswordHash { get; private set; } = null!;\r\n\r\n    public UserStatus Status { get; private set; }\r\n\r\n    public DateTimeOffset CreatedAtUtc { get; private set; }\r\n\r\n    public DateTimeOffset? EmailVerifiedAtUtc { get; private set; }\r\n\r\n    public static User Create(\r\n        string cpf,\r\n        string email,\r\n        string passwordHash)\r\n    {\r\n        ArgumentException.ThrowIfNullOrWhiteSpace(cpf);\r\n        ArgumentException.ThrowIfNullOrWhiteSpace(email);\r\n        ArgumentException.ThrowIfNullOrWhiteSpace(passwordHash);\r\n\r\n        var user = new User\r\n        {\r\n            Id = Guid.NewGuid(),\r\n            Cpf = NormalizeCpf(cpf),\r\n            Email = NormalizeEmail(email),\r\n            PasswordHash = passwordHash,\r\n            Status = UserStatus.PendingEmailVerification,\r\n            CreatedAtUtc = DateTimeOffset.UtcNow,\r\n        };\r\n        return user;\r\n    }\r\n\r\n    public void ConfirmEmail(DateTimeOffset confirmedAtUtc)\r\n    {\r\n        if (EmailVerifiedAtUtc is not null)\r\n        {\r\n   