ration,\n+    bool IsStateRegistrationExempt);\n+\n+public sealed record RegisterTenantResult(RegisterTenantStatus Status, Guid? TenantId)\n+{\n+    public static RegisterTenantResult Created(Guid tenantId) => new(RegisterTenantStatus.Created, tenantId);\n+\n+    public static readonly RegisterTenantResult Conflict = new(RegisterTenantStatus.Conflict, null);\n+\n+    public static readonly RegisterTenantResult Unauthenticated = new(RegisterTenantStatus.Unauthenticated, null);\n+\n+    public static readonly RegisterTenantResult InvalidCnpj = new(RegisterTenantStatus.InvalidCnpj, null);\n+\n+    public static readonly RegisterTenantResult CompanyInactive = new(RegisterTenantStatus.CompanyInactive, null);\n+\n+    public static readonly RegisterTenantResult IneligibleCnae = new(RegisterTenantStatus.IneligibleCnae, null);\n+\n+    public static readonly RegisterTenantResult DependencyUnavailable = new(RegisterTenantStatus.DependencyUnavailable, null);\n+}\n+\n+public enum RegisterTenantStatus\n+{\n+    Created,\n+    Conflict,\n+    Unauthenticated,\n+    InvalidCnpj,\n+    CompanyInactive,\n+    IneligibleCnae,\n+    DependencyUnavailable,\n+}\ndiff --git a/src/Agendamento.Api/Application/Tenants/RegisterTenant/RegisterTenantHandler.cs b/src/Agendamento.Api/Application/Tenants/RegisterTenant/RegisterTenantHandler.cs\nnew file mode 100644\nindex 0000000..1039d3f\n--- /dev/null\n+++ b/src/Agendamento.Api/Application/Tenants/RegisterTenant/RegisterTenantHandler.cs\n@@ -0,0 +1,186 @@\n+using System.Security.Cryptography;\n+using System.Text.Json;\n+using Agendamento.Application.Common;\n+using Agendamento.Application.Tenants.CompanyRegistry;\n+using Agendamento.Domain.Tenants;\n+\n+namespace Agendamento.Application.Tenants.RegisterTenant;\n+\n+public sealed class RegisterTenantHandler(\n+    ICurrentUser currentUser,\n+    IUnitOfWork unitOfWork,\n+    ICompanyRegistryGateway companyRegistryGateway,\n+    FoodCnaePolicy foodCnaePolicy)\n+{\n+    private const int CreatedStatusCode = 201;\n+\n+    public async Task<RegisterTenantResult> HandleAsync(\n+        RegisterTenantCommand command,\n+        CancellationToken cancellationToken = default)\n+    {\n+        ArgumentNullException.ThrowIfNull(command);\n+        ArgumentException.ThrowIfNullOrWhiteSpace(command.IdempotencyKey);\n+\n+        if (currentUser.UserId is not { } userId || userId == Guid.Empty)\n+        {\n+            return RegisterTenantResult.Unauthenticated;\n+        }\n+\n+        if (!Cnpj.TryParse(command.Cnpj, out var parsedCnpj))\n+        {\n+            return RegisterTenantResult.InvalidCnpj;\n+        }\n+\n+        var cnpj = parsedCnpj!;\n+        var idempotencyKey = command.IdempotencyKey.Trim();\n+        var requestHash = ComputeRequestHash(command, cnpj.Value);\n+\n+        await using var transaction = await unitOfWork.BeginTransactionAsync(cancellationToken);\n+        await transaction.AcquireRegistrationLocksAsync(\n+            userId,\n+            idempotencyKey,\n+            cnpj.Value,\n+            cancellationToken);\n+\n+        var storedRecord = await transaction.FindIdempotencyRecordAsync(\n+            userId,\n+            idempotencyKey,\n+            cancellationToken);\n+        if (storedRecord is not null)\n+        {\n+            return ReplayStoredResult(storedRecord, requestHash);\n+        }\n+\n+        CompanyRegistryResult company;\n+        try\n+        {\n+            company = await companyRegistryGateway.LookupAsync(cnpj, cancellationToken);\n+        }\n+        catch (CompanyRegistryUnavailableException)\n+        {\n+            return RegisterTenantResult.DependencyUnavailable;\n+        }\n+\n+        if (!string.Equals(company.RegistrationStatus, \"ATIVA\", StringComparison.Ordinal))\n+        {\n+            return RegisterTenantResult.CompanyInactive;\n+        }\n+\n+        if (!foodCnaePolicy.IsEligible(company))\n+        {\n+            return RegisterTenantResult.IneligibleCnae;\n+        }\n+\n+        if (await transaction.TenantExistsByCnpjAsync(cnpj.Value, cancellationToken))\n+        {\n+            return RegisterTenantResult.Conflict;\n+        }\n+\n+        var tenant = Tenant.Create(\n+            cnpj.Value,\n+            command.LegalName,\n+            command.Category,\n+            command.BusinessEmail,\n+            command.BusinessPhone,\n+            TenantAddress.Create(\n+                command.Address.Street,\n+                command.Address.Number,\n+                command.Address.District,\n+                command.Address.City,\n+                command.Address.State,\n+                command.Address.PostalCode,\n+                command.Address.Complement),\n+            command.TradeName,\n+            command.LegalNature,\n+            command.PrimaryCnae);\n+        var fiscalProfile = TenantFiscalProfile.Create(\n+            tenant.Id,\n+            command.FiscalProfile.TaxRegime,\n+            command.FiscalProfile.FiscalEmail,\n+            command.FiscalProfile.StateRegistration,\n+            command.FiscalProfile.MunicipalRegistration,\n+            command.FiscalProfile.IsStateRegistrationExempt);\n+        var membership = TenantMembership.CreateOwnerAdmin(\n+            tenant.Id,\n+            userId,\n+            command.IsLegalRepresentative,\n+            command.Position);\n+        var result = RegisterTenantResult.Created(tenant.Id);\n+        var responseBody = JsonSerializer.Serialize(result);\n+        var now = DateTimeOffset.UtcNow;\n+\n+        transaction.AddTenantRegistration(tenant, fiscalProfile, membership);\n+        transaction.AddIdempotencyRecord(userId, idempotencyKey, requestHash, now);\n+        transaction.CompleteIdempotencyRecord(CreatedStatusCode, responseBody, now);\n+\n+        try\n+        {\n+            await transaction.SaveChangesAsync(cancellationToken);\n+            await transaction.CommitAsync(cancellationToken);\n+        }\n+        catch (PersistenceConflictException)\n+        {\n+            return RegisterTenantResult.Conflict;\n+        }\n+\n+        return result;\n+    }\n+\n+    private static RegisterTenantResult ReplayStoredResult(\n+        StoredIdempotencyRecord storedRecord,\n+        string requestHash)\n+    {\n+        if (!string.Equals(storedRecord.RequestHash, requestHash, StringComparison.Ordinal) ||\n+            !storedRecord.IsCompleted ||\n+            storedRecord.ResponseStatusCode != CreatedStatusCode ||\n+            string.IsNullOrWhiteSpace(storedRecord.ResponseBody))\n+        {\n+            return RegisterTenantResult.Conflict;\n+        }\n+\n+        return JsonSerializer.Deserialize<RegisterTenantResult>(storedRecord.ResponseBody)\n+            ?? throw new InvalidOperationException(\"A resposta idempotente persistida é inválida.\");\n+    }\n+\n+    private static string ComputeRequestHash(RegisterTenantCommand command, string canonicalCnpj)\n+    {\n+        var canonicalPayload = new\n+        {\n+            Cnpj = canonicalCnpj,\n+            LegalName = NormalizeRequired(command.LegalName),\n+            TradeName = NormalizeOptional(command.TradeName),\n+            LegalNature = NormalizeOptional(command.LegalNature),\n+            PrimaryCnae = NormalizeOptional(command.PrimaryCnae),\n+            command.Category,\n+            BusinessEmail = NormalizeRequired(command.BusinessEmail),\n+            BusinessPhone = NormalizeRequired(command.BusinessPhone),\n+            Address = new\n+            {\n+                Street = NormalizeRequired(command.Address.Street),\n+                Number = NormalizeRequired(command.Address.Number),\n+                District = NormalizeRequired(command.Address.District),\n+                City = NormalizeRequired(command.Address.City),\n+                State = NormalizeRequired(command.Address.State),\n+                PostalCode = NormalizeRequired(command.Address.PostalCode),\n+                Complement = NormalizeOptional(command.Address.Complement),\n+            },\n+            FiscalProfile = new\n+            {\n+                command.FiscalProfile.TaxRegime,\n+                FiscalEmail = NormalizeRequired(command.FiscalProfile.FiscalEmail),\n+                StateRegistration = NormalizeOptional(command.FiscalProfile.StateRegistration),\n+                MunicipalRegistration = NormalizeOptional(command.FiscalProfile.MunicipalRegistration),\n+                command.FiscalProfile.IsStateRegistrationExempt,\n+            },\n+            command.IsLegalRepresentative,\n+            Position = NormalizeRequired(command.Position),\n+        };\n+        var serializedPayload = JsonSerializer.SerializeToUtf8Bytes(canonicalPayload);\n+        return Convert.ToHexString(SHA256.HashData(serializedPayload)).ToLowerInvariant();\n+    }\n+\n+    private static string NormalizeRequired(string value) => value?.Trim() ?? string.Empty;\n+\n+    private static string? NormalizeOptional(string? value) =>\n+        string.IsNullOrWhiteSpace(value) ? null : value.Trim();\n+}\ndiff --git a/src/Agendamento.Api/Infrastructure/Persistence/UnitOfWork.cs b/src/Agendamento.Api/Infrastructure/Persistence/UnitOfWork.cs\nnew file mode 100644\nindex 0000000..8b70cae\n--- /dev/null\n+++ b/src/Agendamento.Api/Infrastructure/Persistence/UnitOfWork.cs\n@@ -0,0 +1,145 @@\n+using Agendamento.Application.Common;\n+using Agendamento.Domain.Tenants;\n+using Microsoft.EntityFrameworkCore;\n+using Microsoft.EntityFrameworkCore.Storage;\n+using Npgsql;\n+\n+namespace Agendamento.Infrastructure.Persistence;\n+\n+public sealed class UnitOfWork(AgendamentoDbContext dbContext) : IUnitOfWork\n+{\n+    public async Task<IUnitOfWorkTransaction> BeginTransactionAsync(\n+        CancellationToken cancellationToken = default)\n+    {\n+        var databaseTransaction = await dbContext.Database.BeginTransactionAsync(cancellationToken);\n+        return new UnitOfWorkTransaction(dbContext, databaseTransaction);\n+    }\n+\n+    private sealed class UnitOfWorkTransaction(\n+        AgendamentoDbContext dbContext,\n+        IDbContextTransaction databaseTransaction) : IUnitOfWorkTransaction\n+    {\n+        private IdempotencyRecord? _newIdempotencyRecord;\n+        private bool _completed;\n+        private bool _disposed;\n+\n+        public async Task AcquireRegistrationLocksAsync(\n+            Guid userId,\n+            string idempotencyKey,\n+            string canonicalCnpj,\n+            CancellationToken cancellationToken = default)\n+        {\n+            var resources = new[]\n+            {\n+                $\"idempotency:{userId:N}:{idempotencyKey.Trim()}\",\n+                $\"tenant-cnpj:{canonicalCnpj}\",\n+            };\n+\n+            foreach (var resource in resources.Order(StringComparer.Ordinal))\n+            {\n+                await dbContext.Database.ExecuteSqlInterpolatedAsync(\n+                    $\"SELECT pg_advisory_xact_lock(hashtextextended({resource}, 0));\",\n+                    cancellationToken);\n+            }\n+        }\n+\n+        public Task<StoredIdempotencyRecord?> FindIdempotencyRecordAsync(\n+            Guid userId,\n+            string key,\n+            CancellationToken cancellationToken = default) =>\n+            dbContext.IdempotencyRecords\n+                .AsNoTracking()\n+                .Where(record => record.UserId == userId && record.Key == key.Trim())\n+                .Select(record => new StoredIdempotencyRecord(\n+                    record.RequestHash,\n+                    record.State == IdempotencyRecordState.Completed,\n+                    record.ResponseStatusCode,\n+                    record.ResponseBody))\n+                .SingleOrDefaultAsync(cancellationToken);\n+\n+        public Task<bool> TenantExistsByCnpjAsync(\n+            string canonicalCnpj,\n+            CancellationToken cancellationToken = default) =>\n+            dbContext.Tenants.AnyAsync(\n+                tenant => tenant.Cnpj == canonicalCnpj,\n+                cancellationToken);\n+\n+        public void AddTenantRegistration(\n+            Tenant tenant,\n+            TenantFiscalProfile fiscalProfile,\n+            TenantMembership membership) =>\n+            dbContext.AddRange(tenant, fiscalProfile, membership);\n+\n+        public void AddIdempotencyRecord(\n+            Guid userId,\n+            string key,\n+            string requestHash,\n+            DateTimeOffset createdAtUtc)\n+        {\n+            if (_newIdempotencyRecord is not null)\n+            {\n+                throw new InvalidOperationException(\"A transação já possui um registro de idempotência.\");\n+            }\n+\n+            _newIdempotencyRecord = IdempotencyRecord.Start(\n+                userId,\n+                key,\n+                requestHash,\n+                createdAtUtc);\n+            dbContext.IdempotencyRecords.Add(_newIdempotencyRecord);\n+        }\n+\n+        public void CompleteIdempotencyRecord(\n+            int responseStatusCode,\n+            string responseBody,\n+            DateTimeOffset completedAtUtc)\n+        {\n+            if (_newIdempotencyRecord is null)\n+            {\n+                throw new InvalidOperationException(\"Nenhum registro de idempotência foi iniciado.\");\n+            }\n+\n+            _newIdempotencyRecord.Complete(responseStatusCode, responseBody, completedAtUtc);\n+        }\n+\n+        public async Task SaveChangesAsync(CancellationToken cancellationToken = default)\n+        {\n+            try\n+            {\n+                await dbContext.SaveChangesAsync(cancellationToken);\n+            }\n+            catch (DbUpdateException exception)\n+                when (exception.InnerException is PostgresException\n+                {\n+                    SqlState: PostgresErrorCodes.UniqueViolation,\n+                })\n+            {\n+                throw new PersistenceConflictException(\n+                    \"Uma restrição global de unicidade impediu o cadastro do tenant.\",\n+                    exception);\n+            }\n+        }\n+\n+        public async Task CommitAsync(CancellationToken cancellationToken = default)\n+        {\n+            await databaseTransaction.CommitAsync(cancellationToken);\n+            _completed = true;\n+        }\n+\n+        public async ValueTask DisposeAsync()\n+        {\n+            if (_disposed)\n+            {\n+                return;\n+            }\n+\n+            if (!_completed)\n+            {\n+                await databaseTransaction.RollbackAsync();\n+            }\n+\n+            await databaseTransaction.DisposeAsync();\n+            _disposed = true;\n+        }\n+    }\n+}\n","exit_code":0,"status":"completed"}}
