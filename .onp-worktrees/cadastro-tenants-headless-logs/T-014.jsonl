{"type":"item.completed","item":{"id":"item_56","type":"command_execution","command":"\"C:\\\\Program Files\\\\WindowsApps\\\\Microsoft.PowerShell_7.6.4.0_x64__8wekyb3d8bbwe\\\\pwsh.exe\" -Command 'git diff --cached --no-ext-diff -- tests/Agendamento.IntegrationTests/Tenants/RegisterTenantTransactionTests.cs'","aggregated_output":"diff --git a/tests/Agendamento.IntegrationTests/Tenants/RegisterTenantTransactionTests.cs b/tests/Agendamento.IntegrationTests/Tenants/RegisterTenantTransactionTests.cs\nnew file mode 100644\nindex 0000000..156281e\n--- /dev/null\n+++ b/tests/Agendamento.IntegrationTests/Tenants/RegisterTenantTransactionTests.cs\n@@ -0,0 +1,300 @@\n+using Agendamento.Application.Common;\n+using Agendamento.Application.Tenants.CompanyRegistry;\n+using Agendamento.Application.Tenants.RegisterTenant;\n+using Agendamento.Domain.Identity;\n+using Agendamento.Domain.Tenants;\n+using Agendamento.Infrastructure.Persistence;\n+using Agendamento.Infrastructure.Persistence.Configurations;\n+using Agendamento.IntegrationTests.Infrastructure;\n+using Microsoft.EntityFrameworkCore;\n+using Xunit;\n+\n+namespace Agendamento.IntegrationTests.Tenants;\n+\n+[Collection(PostgreSqlCollection.Name)]\n+public sealed class RegisterTenantTransactionTests(PostgreSqlFixture fixture)\n+{\n+    [Fact(DisplayName = \"Transação cria tenant, perfil e owner_admin do usuário autenticado @spec:AC-021\")]\n+    public async Task Registration_persists_all_components_for_the_current_user()\n+    {\n+        await EnsureMigrationAsync();\n+        var user = await CreateUserAsync();\n+        var command = ValidCommand($\"register-{Guid.NewGuid():N}\");\n+\n+        try\n+        {\n+            RegisterTenantResult result;\n+            await using (var context = CreateDbContext())\n+            {\n+                result = await CreateHandler(context, user.Id).HandleAsync(command);\n+            }\n+\n+            await using var assertionContext = CreateDbContext();\n+            var tenant = await assertionContext.Tenants.AsNoTracking().SingleAsync(value => value.Id == result.TenantId);\n+            var profile = await assertionContext.TenantFiscalProfiles.AsNoTracking().SingleAsync(value => value.TenantId == tenant.Id);\n+            var membership = await assertionContext.TenantMemberships.AsNoTracking().SingleAsync(value => value.TenantId == tenant.Id);\n+            var idempotency = await assertionContext.IdempotencyRecords.AsNoTracking().SingleAsync(\n+                value => value.UserId == user.Id && value.Key == command.IdempotencyKey);\n+\n+            Assert.Equal(RegisterTenantStatus.Created, result.Status);\n+            Assert.Equal(Cnpj.Parse(command.Cnpj).Value, tenant.Cnpj);\n+            Assert.Equal(tenant.Id, profile.TenantId);\n+            Assert.Equal(user.Id, membership.UserId);\n+            Assert.Equal(TenantRole.OwnerAdmin, membership.Role);\n+            Assert.True(membership.IsLegalRepresentative);\n+            Assert.Equal(IdempotencyRecordState.Completed, idempotency.State);\n+            Assert.Equal(201, idempotency.ResponseStatusCode);\n+        }\n+        finally\n+        {\n+            await DeleteRegistrationAsync(user.Id);\n+            await DeleteUserAsync(user.Id);\n+        }\n+    }\n+\n+    [Fact(DisplayName = \"CNPJ global duplicado retorna conflito e preserva um cadastro @spec:AC-022\")]\n+    public async Task Duplicate_canonical_cnpj_returns_conflict_without_duplicate_rows()\n+    {\n+        await EnsureMigrationAsync();\n+        var user = await CreateUserAsync();\n+        var firstCommand = ValidCommand($\"register-{Guid.NewGuid():N}\", \"12.ABC.345/01DE-35\");\n+        var duplicateCommand = ValidCommand($\"register-{Guid.NewGuid():N}\", \"12abc34501de35\");\n+\n+        try\n+        {\n+            RegisterTenantResult first;\n+            RegisterTenantResult duplicate;\n+            await using (var firstContext = CreateDbContext())\n+            {\n+                first = await CreateHandler(firstContext, user.Id).HandleAsync(firstCommand);\n+            }\n+\n+            await using (var duplicateContext = CreateDbContext())\n+            {\n+                duplicate = await CreateHandler(duplicateContext, user.Id).HandleAsync(duplicateCommand);\n+            }\n+\n+            await using var assertionContext = CreateDbContext();\n+            var canonicalCnpj = Cnpj.Parse(firstCommand.Cnpj).Value;\n+            Assert.Equal(RegisterTenantStatus.Created, first.Status);\n+            Assert.Equal(RegisterTenantStatus.Conflict, duplicate.Status);\n+            Assert.Equal(1, await assertionContext.Tenants.CountAsync(value => value.Cnpj == canonicalCnpj));\n+            Assert.Equal(1, await assertionContext.TenantFiscalProfiles.CountAsync(value => value.TenantId == first.TenantId));\n+            Assert.Equal(1, await assertionContext.TenantMemberships.CountAsync(value => value.TenantId == first.TenantId));\n+            Assert.Equal(1, await assertionContext.IdempotencyRecords.CountAsync(value => value.UserId == user.Id));\n+        }\n+        finally\n+        {\n+            await DeleteRegistrationAsync(user.Id);\n+            await DeleteUserAsync(user.Id);\n+        }\n+    }\n+\n+    [Fact(DisplayName = \"PostgreSQL reaproveita resposta idempotente e rejeita payload diferente @spec:AC-023\")]\n+    public async Task Idempotency_replays_original_result_and_rejects_a_different_payload()\n+    {\n+        await EnsureMigrationAsync();\n+        var user = await CreateUserAsync();\n+        var gateway = new FakeCompanyRegistryGateway();\n+        var command = ValidCommand($\"register-{Guid.NewGuid():N}\");\n+\n+        try\n+        {\n+            RegisterTenantResult original;\n+            RegisterTenantResult replay;\n+            RegisterTenantResult conflict;\n+            await using (var originalContext = CreateDbContext())\n+            await using (var replayContext = CreateDbContext())\n+            {\n+                var concurrentResults = await Task.WhenAll(\n+                    CreateHandler(originalContext, user.Id, gateway).HandleAsync(command),\n+                    CreateHandler(replayContext, user.Id, gateway).HandleAsync(command));\n+                original = concurrentResults[0];\n+                replay = concurrentResults[1];\n+            }\n+\n+            await using (var conflictContext = CreateDbContext())\n+            {\n+                conflict = await CreateHandler(conflictContext, user.Id, gateway).HandleAsync(\n+                    command with { BusinessEmail = \"outro@exemplo.com\" });\n+            }\n+\n+            await using var assertionContext = CreateDbContext();\n+            Assert.Equal(original, replay);\n+            Assert.Equal(RegisterTenantStatus.Conflict, conflict.Status);\n+            Assert.Equal(1, gateway.CallCount);\n+            Assert.Equal(1, await assertionContext.Tenants.CountAsync(value => value.Id == original.TenantId));\n+            Assert.Equal(1, await assertionContext.TenantFiscalProfiles.CountAsync(value => value.TenantId == original.TenantId));\n+            Assert.Equal(1, await assertionContext.TenantMemberships.CountAsync(value => value.TenantId == original.TenantId));\n+            Assert.Equal(1, await assertionContext.IdempotencyRecords.CountAsync(\n+                value => value.UserId == user.Id && value.Key == command.IdempotencyKey));\n+        }\n+        finally\n+        {\n+            await DeleteRegistrationAsync(user.Id);\n+            await DeleteUserAsync(user.Id);\n+        }\n+    }\n+\n+    [Fact(DisplayName = \"Falha PostgreSQL parcial reverte tenant, perfil, membership e idempotência @spec:AC-024\")]\n+    public async Task Database_failure_rolls_back_every_registration_component()\n+    {\n+        await EnsureMigrationAsync();\n+        var user = await CreateUserAsync();\n+        var command = ValidCommand($\"register-{Guid.NewGuid():N}\") with { Position = \"force_t014_failure\" };\n+        await InstallMembershipFailureTriggerAsync();\n+\n+        try\n+        {\n+            await using (var context = CreateDbContext())\n+            {\n+                var handler = CreateHandler(context, user.Id);\n+                await Assert.ThrowsAsync<DbUpdateException>(() => handler.HandleAsync(command));\n+            }\n+\n+            await using var assertionContext = CreateDbContext();\n+            var canonicalCnpj = Cnpj.Parse(command.Cnpj).Value;\n+            Assert.False(await assertionContext.Tenants.AnyAsync(value => value.Cnpj == canonicalCnpj));\n+            Assert.False(await assertionContext.TenantFiscalProfiles.AnyAsync());\n+            Assert.False(await assertionContext.TenantMemberships.AnyAsync(value => value.UserId == user.Id));\n+            Assert.False(await assertionContext.IdempotencyRecords.AnyAsync(\n+                value => value.UserId == user.Id && value.Key == command.IdempotencyKey));\n+        }\n+        finally\n+        {\n+            await RemoveMembershipFailureTriggerAsync();\n+            await DeleteRegistrationAsync(user.Id);\n+            await DeleteUserAsync(user.Id);\n+        }\n+    }\n+\n+    private AgendamentoDbContext CreateDbContext()\n+    {\n+        var options = new DbContextOptionsBuilder<AgendamentoDbContext>()\n+            .UseNpgsql(fixture.ConnectionString)\n+            .Options;\n+        return new AgendamentoDbContext(options);\n+    }\n+\n+    private static RegisterTenantHandler CreateHandler(\n+        AgendamentoDbContext context,\n+        Guid userId,\n+        FakeCompanyRegistryGateway? gateway = null) =>\n+        new(\n+            new FixedCurrentUser(userId),\n+            new UnitOfWork(context),\n+            gateway ?? new FakeCompanyRegistryGateway(),\n+            new FoodCnaePolicy());\n+\n+    private async Task EnsureMigrationAsync()\n+    {\n+        await fixture.ExecuteScriptAsync(UserConfiguration.CreateTableSql);\n+        await using var context = CreateDbContext();\n+        await context.Database.MigrateAsync();\n+    }\n+\n+    private async Task<User> CreateUserAsync()\n+    {\n+        var cpf = string.Concat(Enumerable.Range(0, 11).Select(_ => Random.Shared.Next(10)));\n+        var user = User.Create(cpf, $\"registration-{Guid.NewGuid():N}@example.com\", \"test-password-hash\");\n+        await using var context = CreateDbContext();\n+        await context.Database.ExecuteSqlInterpolatedAsync($\"\"\"\n+            INSERT INTO \"Users\" (\"Id\", \"Cpf\", \"Email\", \"PasswordHash\", \"Status\", \"CreatedAtUtc\")\n+            VALUES ({user.Id}, {user.Cpf}, {user.Email}, {user.PasswordHash}, {(int)user.Status}, {user.CreatedAtUtc});\n+            \"\"\");\n+        return user;\n+    }\n+\n+    private Task InstallMembershipFailureTriggerAsync() => fixture.ExecuteScriptAsync(\"\"\"\n+        CREATE OR REPLACE FUNCTION fail_t014_membership_insert()\n+        RETURNS trigger AS $$\n+        BEGIN\n+            IF NEW.position = 'force_t014_failure' THEN\n+                RAISE EXCEPTION 'forced T-014 membership failure';\n+            END IF;\n+            RETURN NEW;\n+        END;\n+        $$ LANGUAGE plpgsql;\n+\n+        DROP TRIGGER IF EXISTS trg_t014_fail_membership ON tenant_memberships;\n+        CREATE TRIGGER trg_t014_fail_membership\n+        BEFORE INSERT ON tenant_memberships\n+        FOR EACH ROW EXECUTE FUNCTION fail_t014_membership_insert();\n+        \"\"\");\n+\n+    private Task RemoveMembershipFailureTriggerAsync() => fixture.ExecuteScriptAsync(\"\"\"\n+        DROP TRIGGER IF EXISTS trg_t014_fail_membership ON tenant_memberships;\n+        DROP FUNCTION IF EXISTS fail_t014_membership_insert();\n+        \"\"\");\n+\n+    private async Task DeleteRegistrationAsync(Guid userId)\n+    {\n+        await using var context = CreateDbContext();\n+        await context.IdempotencyRecords.Where(value => value.UserId == userId).ExecuteDeleteAsync();\n+        var tenantIds = context.TenantMemberships\n+            .Where(value => value.UserId == userId)\n+            .Select(value => value.TenantId);\n+        await context.Tenants.Where(value => tenantIds.Contains(value.Id)).ExecuteDeleteAsync();\n+    }\n+\n+    private async Task DeleteUserAsync(Guid userId)\n+    {\n+        await using var context = CreateDbContext();\n+        await context.Database.ExecuteSqlInterpolatedAsync($\"\"\"\n+            DELETE FROM \"Users\" WHERE \"Id\" = {userId};\n+            \"\"\");\n+    }\n+\n+    private static RegisterTenantCommand ValidCommand(string idempotencyKey, string cnpj = \"04.252.011/0001-10\") =>\n+        new(\n+            idempotencyKey,\n+            cnpj,\n+            \"Restaurante Exemplo Ltda\",\n+            \"Restaurante Exemplo\",\n+            \"Sociedade Empresária Limitada\",\n+            \"5611201\",\n+            BusinessCategory.Restaurant,\n+            \"contato@exemplo.com\",\n+            \"+55 11 99999-9999\",\n+            new RegisterTenantAddress(\n+                \"Rua das Flores\",\n+                \"100\",\n+                \"Centro\",\n+                \"São Paulo\",\n+                \"SP\",\n+                \"01001-000\",\n+                null),\n+            new RegisterTenantFiscalProfile(\n+                TaxRegime.SimplesNacional,\n+                \"fiscal@exemplo.com\",\n+                \"123.456.789.000\",\n+                \"987654\",\n+                false),\n+            true,\n+            \"Sócia administradora\");\n+\n+    private sealed class FixedCurrentUser(Guid userId) : ICurrentUser\n+    {\n+        public Guid? UserId { get; } = userId;\n+    }\n+\n+    private sealed class FakeCompanyRegistryGateway : ICompanyRegistryGateway\n+    {\n+        private int _callCount;\n+\n+        public int CallCount => _callCount;\n+\n+        public Task<CompanyRegistryResult> LookupAsync(Cnpj cnpj, CancellationToken cancellationToken = default)\n+        {\n+            Interlocked.Increment(ref _callCount);\n+            return Task.FromResult(new CompanyRegistryResult(\n+                \"Restaurante Exemplo Ltda\",\n+                \"Restaurante Exemplo\",\n+                \"Sociedade Empresária Limitada\",\n+                \"5611201\",\n+                [],\n+                \"ATIVA\",\n+                null));\n+        }\n+    }\n+}\n","exit_code":0,"status":"completed"}}
