    public Guid Id { get; private set; }\n\n    public string Cnpj { get; private set; } = null!;\n\n    public string LegalName { get; private set; } = null!;\n\n    public string? TradeName { get; private set; }\n\n    public string? LegalNature { get; private set; }\n\n    public string? PrimaryCnae { get; private set; }\n\n    public BusinessCategory Category { get; private set; }\n\n    public string BusinessEmail { get; private set; } = null!;\n\n    public string BusinessPhone { get; private set; } = null!;\n\n    public TenantAddress Address { get; private set; } = null!;\n\n    public DateTimeOffset CreatedAtUtc { get; private set; }\n\r\n    public static Tenant Create(\r\n        string cnpj,\r\n        string legalName,\r\n        BusinessCategory category,\r\n        string businessEmail,\r\n        string businessPhone,\r\n        TenantAddress address,\r\n        string? tradeName = null,\r\n        string? legalNature = null,\r\n        string? primaryCnae = null)\r\n    {\r\n        ArgumentNullException.ThrowIfNull(address);\r\n        if (!Enum.IsDefined(category))\r\n        {\r\n            throw new ArgumentOutOfRangeException(nameof(category));\r\n        }\r\n\r\n        return new Tenant(\r\n            Guid.NewGuid(),\r\n            Required(cnpj, nameof(cnpj)),\r\n            Required(legalName, nameof(legalName)),\r\n            NormalizeOptional(tradeName),\r\n            NormalizeOptional(legalNature),\r\n            NormalizeOptional(primaryCnae),\r\n            category,\r\n            Required(businessEmail, nameof(businessEmail)),\r\n            Required(businessPhone, nameof(businessPhone)),\r\n            address,\r\n            DateTimeOffset.UtcNow);\r\n    }\r\n\r\n    private static string Required(string value, string parameterName)\r\n    {\r\n        ArgumentException.ThrowIfNullOrWhiteSpace(value, parameterName);\r\n        return value.Trim();\r\n    }\r\n\r\n    private static string? NormalizeOptional(string? value) =>\r\n        string.IsNullOrWhiteSpace(value) ? null : value.Trim();\r\n}\r\n\r\n===== src/Agendamento.Api/Domain/Tenants/TenantAddress.cs =====\r\nnamespace Agendamento.Domain.Tenants;\r\n\r\npublic sealed class TenantAddress\n{\n    private TenantAddress()\n    {\n    }\n\n    private TenantAddress(\r\n        string street,\r\n        string number,\r\n        string district,\r\n        string city,\r\n        string state,\r\n        string postalCode,\r\n        string? complement)\r\n    {\r\n        Street = street;\r\n        Number = number;\r\n        District = district;\r\n        City = city;\r\n        State = state;\r\n        PostalCode = postalCode;\r\n        Complement = complement;\r\n    }\r\n\r\n    public string Street { get; private set; } = null!;\n\n    public string Number { get; private set; } = null!;\n\n    public string District { get; private set; } = null!;\n\n    public string City { get; private set; } = null!;\n\n    public string State { get; private set; } = null!;\n\n    public string PostalCode { get; private set; } = null!;\n\n    public string? Complement { get; private set; }\n\r\n    public static TenantAddress Create(\r\n        string street,\r\n        string number,\r\n        string district,\r\n        string city,\r\n        string state,\r\n        string postalCode,\r\n        string? complement = null)\r\n    {\r\n        return new TenantAddress(\r\n            Required(street, nameof(street)),\r\n            Required(number, nameof(number)),\r\n            Required(district, nameof(district)),\r\n            Required(city, nameof(city)),\r\n            Required(state, nameof(state)),\r\n            Required(postalCode, nameof(postalCode)),\r\n            NormalizeOptional(complement));\r\n    }\r\n\r\n    private static string Required(string value, string parameterName)\r\n    {\r\n        ArgumentException.ThrowIfNullOrWhiteSpace(value, parameterName);\r\n        return value.Trim();\r\n    }\r\n\r\n    private static string? NormalizeOptional(string? value) =>\r\n        string.IsNullOrWhiteSpace(value) ? null : value.Trim();\r\n}\r\n\r\n===== src/Agendamento.Api/Domain/Tenants/TenantFiscalProfile.cs =====\r\nnamespace Agendamento.Domain.Tenants;\r\n\r\npublic sealed class TenantFiscalProfile\n{\n    private TenantFiscalProfile()\n    {\n    }\n\n    private TenantFiscalProfile(\r\n        Guid tenantId,\r\n        string? stateRegistration,\r\n        string? municipalRegistration,\r\n        bool isStateRegistrationExempt,\r\n        TaxRegime taxRegime,\r\n        string fiscalEmail)\r\n    {\r\n        TenantId = tenantId;\r\n        StateRegistration = stateRegistration;\r\n        MunicipalRegistration = municipalRegistration;\r\n        IsStateRegistrationExempt = isStateRegistrationExempt;\r\n        TaxRegime = taxRegime;\r\n        FiscalEmail = fiscalEmail;\r\n    }\r\n\r\n    public Guid TenantId { get; private set; }\n\n    public string? StateRegistration { get; private set; }\n\n    public string? MunicipalRegistration { get; private set; }\n\n    public bool IsStateRegistrationExempt { get; private set; }\n\n    public TaxRegime TaxRegime { get; private set; }\n\n    public string FiscalEmail { get; private set; } = null!;\n\r\n    public static TenantFiscalProfile Create(\r\n        Guid tenantId,\r\n        TaxRegime taxRegime,\r\n        string fiscalEmail,\r\n        string? stateRegistration = null,\r\n        string? municipalRegistration = null,\r\n        bool isStateRegistrationExempt = false)\r\n    {\r\n        if (tenantId == Guid.Empty)\r\n        {\r\n            throw new ArgumentException(\"O tenant é obrigatório.\", nameof(tenantId));\r\n        }\r\n\r\n        if (!Enum.IsDefined(taxRegime))\r\n        {\r\n            throw new ArgumentOutOfRangeException(nameof(taxRegime));\r\n        }\r\n\r\n        return new TenantFiscalProfile(\r\n            tenantId,\r\n            NormalizeOptional(stateRegistration),\r\n            NormalizeOptional(municipalRegistration),\r\n            isStateRegistrationExempt,\r\n            taxRegime,\r\n            Required(fiscalEmail, nameof(fiscalEmail)));\r\n    }\r\n\r\n    private static string Required(string value, string parameterName)\r\n    {\r\n        ArgumentException.ThrowIfNullOrWhiteSpace(value, parameterName);\r\n        return value.Trim();\r\n    }\r\n\r\n    private static string? NormalizeOptional(string? value) =>\r\n        string.IsNullOrWhiteSpace(value) ? null : value.Trim();\r\n}\r\n\r\n===== src/Agendamento.Api/Domain/Tenants/TenantMembership.cs =====\r\nnamespace Agendamento.Domain.Tenants;\r\n\r\npublic sealed class TenantMembership\n{\n    private TenantMembership()\n    {\n    }\n\n    private TenantMembership(\r\n        Guid id,\r\n        Guid tenantId,\r\n        Guid userId,\r\n        TenantRole role,\r\n        bool isLegalRepresentative,\r\n        string position,\r\n        DateTimeOffset createdAtUtc)\r\n    {\r\n        Id = id;\r\n        TenantId = tenantId;\r\n        UserId = userId;\r\n        Role = role;\r\n        IsLegalRepresentative = isLegalRepresentative;\r\n        Position = position;\r\n        CreatedAtUtc = createdAtUtc;\r\n    }\r\n\r\n    public Guid Id { get; private set; }\n\n    public Guid TenantId { get; private set; }\n\n    public Guid UserId { get; private set; }\n\n    public TenantRole Role { get; private set; }\n\n    public bool IsLegalRepresentative { get; private set; }\n\n    public string Position { get; private set; } = null!;\n\n    public DateTimeOffset CreatedAtUtc { get; private set; }\n\r\n    public static TenantMembership CreateOwnerAdmin(\r\n        Guid tenantId,\r\n        Guid userId,\r\n        bool isLegalRepresentative,\r\n        string position)\r\n    {\r\n        if (tenantId == Guid.Empty)\r\n        {\r\n            throw new ArgumentException(\"O tenant é obrigatório.\", nameof(tenantId));\r\n        }\r\n\r\n        if (userId == Guid.Empty)\r\n        {\r\n            throw new ArgumentException(\"O usuário é obrigatório.\", nameof(userId));\r\n        }\r\n\r\n        ArgumentException.ThrowIfNullOrWhiteSpace(position);\r\n\r\n        return new TenantMembership(\r\n            Guid.NewGuid(),\r\n            tenantId,\r\n            userId,\r\n            TenantRole.OwnerAdmin,\r\n            isLegalRepresentative,\r\n            position.Trim(),\r\n            DateTimeOffset.UtcNow);\r\n    }\r\n}\r\n\r\n===== src/Agendamento.Api/Domain/Tenants/Cnpj.cs =====\r\nnamespace Agendamento.Domain.Tenants;\r\n\r\n/// <summary>\r\n/// Brazilian CNPJ in its canonical fourteen-character representation.\r\n/// </summary>\r\npublic sealed class Cnpj : IEquatable<Cnpj>\r\n{\r\n    private const int Length = 14;\r\n\r\n    private Cnpj(string value)\r\n    {\r\n        Value = value;\r\n    }\r\n\r\n    public string Value { get; }\r\n\r\n    public static Cnpj Create(string value) => Parse(value);\r\n\r\n    public static Cnpj Parse(string value)\r\n    {\r\n        if (!TryParse(value, out var cnpj))\r\n        {\r\n            throw new ArgumentException(\"O CNPJ deve ter formato e dígitos verificadores válidos.\", nameof(value));\r\n        }\r\n\r\n        return cnpj!;\r\n    }\r\n\r\n    public static bool TryParse(string? value, out Cnpj? cnpj)\r\n    {\r\n        cnpj = null;\r\n\r\n        if (string.IsNullOrWhiteSpace(value))\r\n        {\r\n            return false;\r\n        }\r\n\r\n        var normalized = NormalizeMaskAndCase(value);\r\n        if (normalized is null || !HasValidCharacters(normalized) || !HasValidCheckDigits(normalized))\r\n        {\r\n            return false;\r\n        }\r\n\r\n        cnpj = new Cnpj(normalized);\r\n        return true;\r\n    }\r\n\r\n    public static bool IsValid(string? value) => TryParse(value, out _);\r\n\r\n    public override string ToString() => Value;\r\n\r\n    public bool Equals(Cnpj? other) =>\r\n        other is not null && string.Equals(Value, other.Value, StringComparison.Ordinal);\r\n\r\n    public override bool Equals(object? obj) => obj is Cnpj other && Equals(other);\r\n\r\n    public override int GetHashCode() => StringComparer.Ordinal.GetHashCode(Value);\r\n\r\n    public static bool operator ==(Cnpj? left, Cnpj? right) => Equals(left, right);\r\n\r\n    public static bool operator !=(Cnpj? left, Cnpj? right) => !Equals(left, right);\r\n\r\n    private static string? NormalizeMaskAndCase(string value)\r\n    {\r\n        var normalized = new char[Length];\r\n        var position = 0;\r\n\r\n        foreach (var character in value.Trim())\r\n        {\r\n            if (character is '.' or '/' or '-')\r\n            {\r\n                continue;\r\n            }\r\n\r\n            if (position == Length || !IsAsciiLetterOrDigit(character))\r\n            {\r\n                return null;\r\n            }\r\n\r\n            normalized[position++] = char.ToUpperInvariant(character);\r\n        }\r\n\r\n        return position == Length ? new string(normalized) : null;\r\n    }\r\n\r\n    private static bool HasValidCharacters(string value)\r\n    {\r\n        for (var position = 0; position < Length - 2; position++)\r\n        {\r\n            if (!IsAsciiLetterOrDigit(value[position]))\r\n            {\r\n                return false;\r\n            }\r\n        }\r\n\r\n        return char.IsAsciiDigit(value[Length - 2]) && char.IsAsciiDigit(value[Length - 1]);\r\n    }\r\n\r\n    private static bool HasValidCheckDigits(string value)\r\n    {\r\n        var firstCheckDigit = CalculateCheckDigit(value.AsSpan(0, Length - 2), 5);\r\n        if (value[Length - 2] - '0' != firstCheckDigit)\r\n        {\r\n            return false;\r\n        }\r\n\r\n        var secondCheckDigit = CalculateCheckDigit(value.AsSpan(0, Length - 1), 6);\r\n        return value[Length - 1] - '0' == secondCheckDigit;\r\n    }\r\n\r\n    private static int CalculateCheckDigit(ReadOnlySpan<char> value, int firstWeight)\r\n    {\r\n        var sum = 0;\r\n        var weight = firstWeight;\r\n\r\n        foreach (var character in value)\r\n        {\r\n            sum += (character - 48) * weight;\r\n            weight = weight == 2 ? 9 : weight - 1;\r\n        }\r\n\r\n        var remainder = sum % 11;\r\n        return remainder < 2 ? 0 : 11 - remainder;\r\n    }\r\n\r\n    private static bool IsAsciiLetterOrDigit(char value) =>\r\n        char.IsAsciiLetter(value) || char.IsAsciiDigit(value);\r\n}\r\n\r\n===== src/Agendamento.Api/Domain/Identity/User.cs =====\r\nusing System.Globalization;\r\n\r\nnamespace Agendamento.Domain.Identity;\r\n\r\npublic sealed class User\r\n{\r\n    private User()\r\n    {\r\n    }\r\n\r\n    public Guid Id { get; private set; }\r\n\r\n    public string Cpf { get; private set; } = null!;\r\n\r\n    public string Email { get; private set; } = null!;\r\n\r\n    public string PasswordHash { get; private set; } = null!;\r\n\r\n    public UserStatus Status { get; private set; }\r\n\r\n    public DateTimeOffset CreatedAtUtc { get; private set; }\r\n\r\n    public DateTimeOffset? EmailVerifiedAtUtc { get; private set; }\r\n\r\n    public static User Create(\r\n        string cpf,\r\n        string email,\r\n        string passwordHash)\r\n    {\r\n        ArgumentException.ThrowIfNullOrWhiteSpace(cpf);\r\n        ArgumentException.ThrowIfNullOrWhiteSpace(email);\r\n        ArgumentException.ThrowIfNullOrWhiteSpace(passwordHash);\r\n\r\n        var user = new User\r\n        {\r\n            Id = Guid.NewGuid(),\r\n            Cpf = NormalizeCpf(cpf),\r\n            Email = NormalizeEmail(email),\r\n            PasswordHash = passwordHash,\r\n            Status = UserStatus.PendingEmailVerification,\r\n            CreatedAtUtc = DateTimeOffset.UtcNow,\r\n        };\r\n        return user;\r\n    }\r\n\r\n    public void ConfirmEmail(DateTimeOffset confirmedAtUtc)\r\n    {\r\n        if (EmailVerifiedAtUtc is not null)\r\n        {\r\n            return;\r\n        }\r\n\r\n        EmailVerifiedAtUtc = confirmedAtUtc;\r\n        Status = UserStatus.Active;\r\n    }\r\n\r\n    public static string NormalizeCpf(string cpf)\r\n    {\r\n        ArgumentException.ThrowIfNullOrWhiteSpace(cpf);\r\n\r\n        var normalized = new string(cpf.Where(char.IsDigit).ToArray());\r\n        if (normalized.Length != 11)\r\n        {\r\n            throw new ArgumentException(\"O CPF deve conter 11 dígitos.\", nameof(cpf));\r\n        }\r\n\r\n        return normalized;\r\n    }\r\n\r\n    public static string NormalizeEmail(string email)\r\n    {\r\n        ArgumentException.ThrowIfNullOrWhiteSpace(email);\r\n\r\n        var normalized = email.Trim().ToLower(CultureInfo.InvariantCulture);\r\n        if (!normalized.Contains('@', StringComparison.Ordinal))\r\n        {\r\n            throw new ArgumentException(\"O e-mail deve ser válido.\", nameof(email));\r\n        }\r\n\r\n        return normalized;\r\n    }\r\n}\r\n\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"\"C:\\\\Program Files\\\\WindowsApps\\\\Microsoft.PowerShell_7.6.4.0_x64__8wekyb3d8bbwe\\\\pwsh.exe\" -Command \"\\\"===== src/Agendamento.Api/Application/Tenants/LookupCompany/LookupCompanyQuery.cs =====\\\"; Get-Content -Raw 'src/Agendamento.Api/Application/Tenants/LookupCompany/LookupCompanyQuery.cs'; \\\"===== src/Agendamento.Api/Application/Tenants/LookupCompany/LookupCompanyHandler.cs =====\\\"; Get-Content -Raw 'src/Agendamento.Api/Application/Tenants/LookupCompany/LookupCompanyHandler.cs'; \\\"===== src/Agendamento.Api/Application/Tenants/CompanyRegistry/CompanyRegistryResult.cs =====\\\"; Get-Content -Raw 'src/Agendamento.Api/Application/Tenants/CompanyRegistry/CompanyRegistryResult.cs'; \\\"===== src/Agendamento.Api/Application/Tenants/CompanyRegistry/ICompanyRegistryGateway.cs =====\\\"; Get-Content -Raw 'src/Agendamento.Api/Application/Tenants/CompanyRegistry/ICompanyRegistryGateway.cs'; \\\"===== src/Agendamento.Api/Application/DependencyInjection.cs =====\\\"; Get-Content -Raw 'src/Agendamento.Api/Application/DependencyInjection.cs'; \\\"===== src/Agendamento.Api/Infrastructure/DependencyInjection.cs =====\\\"; Get-Content -Raw 'src/Agendamento.Api/Infrastructure/DependencyInjection.cs'\"","aggregated_output":"===== src/Agendamento.Api/Application/Tenants/LookupCompany/LookupCompanyQuery.cs =====\r\nnamespace Agendamento.Application.Tenants.LookupCompany;\n\npublic sealed record LookupCompanyQuery(string Cnpj);\n\r\n===== src/Agendamento.Api/Application/Tenants/LookupCompany/LookupCompanyHandler.cs =====\r\nusing Agendamento.Application.Tenants.CompanyRegistry;\nusing Agendamento.Domain.Tenants;\n\nnamespace Agendamento.Application.Tenants.LookupCompany;\n\npublic sealed class LookupCompanyHandler(\n    ICompanyRegistryGateway gateway,\n    FoodCnaePolicy foodCnaePolicy)\n{\n    public async Task<LookupCompanyResult> HandleAsync(\n        LookupCompanyQuery query,\n        CancellationToken cancellationToken = default)\n    {\n        if (!Cnpj.TryParse(query.Cnpj, out var cnpj))\n        {\n            return LookupCompanyResult.InvalidCnpj;\n        }\n\n        var validCnpj = cnpj!;\n\n        CompanyRegistryResult company;\n        try\n        {\n            company = await gateway.LookupAsync(validCnpj, cancellationToken);\n        }\n        catch (CompanyRegistryUnavailableException)\n        {\n            return LookupCompanyResult.DependencyUnavailable;\n        }\n\n        if (!string.Equals(company.RegistrationStatus, \"ATIVA\", StringComparison.Ordinal))\n        {\n            return new LookupCompanyResult(LookupCompanyStatus.CompanyInactive, validCnpj.Value, company);\n        }\n\n        if (!foodCnaePolicy.IsEligible(company))\n        {\n            return new LookupCompanyResult(LookupCompanyStatus.IneligibleCnae, validCnpj.Value, company);\n        }\n\n        return new LookupCompanyResult(LookupCompanyStatus.Eligible, validCnpj.Value, company);\n    }\n}\n\npublic enum LookupCompanyStatus\n{\n    InvalidCnpj,\n    CompanyInactive,\n    IneligibleCnae,\n    Eligible,\n    DependencyUnavailable,\n}\n\npublic sealed record LookupCompanyResult(\n    LookupCompanyStatus Status,\n    string? Cnpj,\n    CompanyRegistryResult? Company)\n{\n    public static readonly LookupCompanyResult InvalidCnpj = new(LookupCompanyStatus.InvalidCnpj, null, null);\n    public static readonly LookupCompanyResult DependencyUnavailable = new(LookupCompanyStatus.DependencyUnavailable, null, null);\n}\n\r\n===== src/Agendamento.Api/Application/Tenants/CompanyRegistry/CompanyRegistryResult.cs =====\r\nnamespace Agendamento.Application.Tenants.CompanyRegistry;\n\npublic sealed record CompanyRegistryResult(\n    string LegalName,\n    string? TradeName,\n    string? LegalNature,\n    string PrimaryCnae,\n    IReadOnlyCollection<string> SecondaryCnaes,\n    string RegistrationStatus,\n    CompanyRegistryAddress? Address);\n\npublic sealed record CompanyRegistryAddress(\n    string? Street,\n    string? Number,\n    string? Complement,\n    string? District,\n    string? City,\n    string? State,\n    string? PostalCode);\n\r\n===== src/Agendamento.Api/Application/Tenants/CompanyRegistry/ICompanyRegistryGateway.cs =====\r\nusing Agendamento.Domain.Tenants;\n\nnamespace Agendamento.Application.Tenants.CompanyRegistry;\n\n/// <summary>\n/// Port for consulting the official registration data of a company.\n/// </summary>\npublic interface ICompanyRegistryGateway\n{\n    Task<CompanyRegistryResult> LookupAsync(Cnpj cnpj, CancellationToken cancellationToken = default);\n}\n\npublic sealed class CompanyRegistryUnavailableException(string message, Exception? innerException = null)\n    : Exception(message, innerException);\n\r\n===== src/Agendamento.Api/Application/DependencyInjection.cs =====\r\nusing Agendamento.Application.Identity.CreateSession;\r\nusing Agendamento.Application.Identity.VerifyEmail;\r\n\r\nnamespace Agendamento.Application;\r\n\r\npublic static class DependencyInjection\r\n{\r\n    public static IServiceCollection AddApplication(this IServiceCollection services)\r\n    {\r\n        services.AddTransient<VerifyEmailHandler>();\r\n        services.AddTransient<CreateSessionHandler>();\r\n        return services;\r\n    }\r\n}\r\n\r\n===== src/Agendamento.Api/Infrastructure/DependencyInjection.cs =====\r\nusing System.Security.Cryptography;\r\nusing Agendamento.Application.Identity;\r\nusing Agendamento.Application.Identity.CreateSession;\r\nusing Agendamento.Application.Identity.VerifyEmail;\r\nusing Agendamento.Infrastructure.Email;\r\nusing Agendamento.Infrastructure.Identity;\r\n\r\nnamespace Agendamento.Infrastructure;\r\n\r\npublic static class DependencyInjection\r\n{\r\n    public static IServiceCollection AddInfrastructure(\r\n        this IServiceCollection services,\r\n        IConfiguration configuration)\r\n    {\r\n        services.AddSingleton<InMemoryIdentityStore>();\r\n        services.AddSingleton<IIdentityAuthenticationStore>(provider => provider.GetRequiredService<InMemoryIdentityStore>());\r\n        services.AddSingleton<IEmailVerificationTokenRepository>(provider => provider.GetRequiredService<InMemoryIdentityStore>());\r\n        services.AddSingleton<IEmailVerificationUserRepository>(provider => provider.GetRequiredService<InMemoryIdentityStore>());\r\n        services.AddSingleton<IEmailOutbox>(provider => provider.GetRequiredService<InMemoryIdentityStore>());\r\n        services.AddSingleton<IPasswordService, AspNetPasswordService>();\r\n        services.AddSingleton<IClock, SystemClock>();\r\n        services.AddSingleton<IEmailVerificationSender, OutboxEmailVerificationSender>();\r\n\r\n        var signingKey = configuration[\"Authentication:SigningKey\"];\r\n        if (string.IsNullOrWhiteSpace(signingKey))\r\n        {\r\n            signingKey = Convert.ToBase64String(RandomNumberGenerator.GetBytes(32));\r\n        }\r\n\r\n        services.AddSingleton<ISessionIssuer>(new JwtSessionIssuer(JwtSessionIssuerOptions.Create(signingKey)));\r\n\r\n        if (configuration.GetValue<bool>(\"Database:RequirePostgreSql\"))\r\n        {\r\n            var connectionString = configuration.GetConnectionString(\"PostgreSql\");\r\n\r\n            if (string.IsNullOrWhiteSpace(connectionString))\r\n            {\r\n                throw new InvalidOperationException(\r\n                    \"PostgreSQL configuration is required. Set ConnectionStrings__PostgreSql.\");\r\n            }\r\n\r\n            try\r\n            {\r\n                var connectionStringBuilder = new System.Data.Common.DbConnectionStringBuilder\r\n                {\r\n                    ConnectionString = connectionString,\r\n                };\r\n\r\n                if (!connectionStringBuilder.TryGetValue(\"Host\", out var host) ||\r\n                    string.IsNullOrWhiteSpace(host?.ToString()))\r\n                {\r\n                    throw new ArgumentException(\"The PostgreSQL connection string must contain a Host.\");\r\n                }\r\n            }\r\n            catch (ArgumentException exception)\r\n            {\r\n                throw new InvalidOperationException(\r\n                    \"PostgreSQL configuration is invalid. Check ConnectionStrings__PostgreSql.\",\r\n                    exception);\r\n            }\r\n        }\r\n\r\n        return services;\r\n    }\r\n}\r\n\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"\"C:\\\\Program Files\\\\WindowsApps\\\\Microsoft.PowerShell_7.6.4.0_x64__8wekyb3d8bbwe\\\\pwsh.exe\" -Command \"\\\"===== src/Agendamento.Api/Infrastructure/Persistence/AgendamentoDbContext.cs =====\\\"; Get-Content -Raw 'src/Agendamento.Api/Infrastructure/Persistence/AgendamentoDbContext.cs'; \\\"===== src/Agendamento.Api/Infrastructure/Persistence/IdempotencyRecord.cs =====\\\"; Get-Content -Raw 'src/Agendamento.Api/Infrastructure/Persistence/IdempotencyRecord.cs'; \\\"===== src/Agendamento.Api/Infrastructure/Persistence/Configurations/TenantConfiguration.cs =====\\\"; Get-Content -Raw 'src/Agendamento.Api/Infrastructure/Persistence/Configurations/TenantConfiguration.cs'; \\\"===== src/Agendamento.Api/Infrastructure/Persistence/Configurations/TenantFiscalProfileConfiguration.cs =====\\\"; Get-Content -Raw 'src/Agendamento.Api/Infrastructure/Persistence/Configurations/TenantFiscalProfileConfiguration.cs'; \\\"===== src/Agendamento.Api/Infrastructure/Persistence/Configurations/TenantMembershipConfiguration.cs =====\\\"; Get-Content -Raw 'src/Agendamento.Api/Infrastructure/Persistence/Configurations/TenantMembershipConfiguration.cs'; \\\"===== src/Agendamento.Api/Infrastructure/Persistence/Configurations/IdempotencyRecordConfiguration.cs =====\\\"; Get-Content -Raw 'src/Agendamento.Api/Infrastructure/Persistence/Configurations/IdempotencyRecordConfiguration.cs'; \\\"===== src/Agendamento.Api/Infrastructure/Persistence/Configurations/UserConfiguration.cs =====\\\"; Get-Content -Raw 'src/Agendamento.Api/Infrastructure/Persistence/Configurations/UserConfiguration.cs'\"","aggregated_output":"===== src/Agendamento.Api/Infrastructure/Persistence/AgendamentoDbContext.cs =====\r\nusing Agendamento.Domain.Identity;\nusing Agendamento.Domain.Tenants;\nusing Microsoft.EntityFrameworkCore;\nusing Microsoft.EntityFrameworkCore.Design;\n\nnamespace Agendamento.Infrastructure.Persistence;\n\npublic sealed class AgendamentoDbContext(DbContextOptions<AgendamentoDbContext> options) : DbContext(options)\n{\n    public DbSet<Tenant> Tenants => Set<Tenant>();\n\n    public DbSet<TenantFiscalProfile> TenantFiscalProfiles => Set<TenantFiscalProfile>();\n\n    public DbSet<TenantMembership> TenantMemberships => Set<TenantMembership>();\n\n    public DbSet<IdempotencyRecord> IdempotencyRecords => Set<IdempotencyRecord>();\n\n    protected override void OnModelCreating(ModelBuilder modelBuilder)\n    {\n        base.OnModelCreating(modelBuilder);\n        modelBuilder.ApplyConfigurationsFromAssembly(typeof(AgendamentoDbContext).Assembly);\n        ConfigureExistingUsers(modelBuilder);\n    }\n\n    private static void ConfigureExistingUsers(ModelBuilder modelBuilder)\n    {\n        var users = modelBuilder.Entity<User>();\n        users.ToTable(\"Users\", table => table.ExcludeFromMigrations());\n        users.HasKey(user => user.Id);\n        users.Property(user => user.Id).HasColumnName(\"Id\").ValueGeneratedNever();\n        users.Property(user => user.Cpf).HasColumnName(\"Cpf\").HasMaxLength(11).IsRequired();\n        users.Property(user => user.Email).HasColumnName(\"Email\").HasMaxLength(320).IsRequired();\n        users.Property(user => user.PasswordHash).HasColumnName(\"PasswordHash\").IsRequired();\n        users.Property(user => user.Status).HasColumnName(\"Status\").IsRequired();\n        users.Property(user => user.CreatedAtUtc).HasColumnName(\"CreatedAtUtc\").IsRequired();\n        users.Property(user => user.EmailVerifiedAtUtc).HasColumnName(\"EmailVerifiedAtUtc\");\n    }\n}\n\ninternal sealed class AgendamentoDbContextFactory : IDesignTimeDbContextFactory<AgendamentoDbContext>\n{\n    public AgendamentoDbContext CreateDbContext(string[] args)\n    {\n        var options = new DbContextOptionsBuilder<AgendamentoDbContext>()\n            .UseNpgsql(\"Host=localhost;Database=agendamento\")\n            .Options;\n\n        return new AgendamentoDbContext(options);\n    }\n}\n\r\n===== src/Agendamento.Api/Infrastructure/Persistence/IdempotencyRecord.cs =====\r\nnamespace Agendamento.Infrastructure.Persistence;\n\npublic sealed class IdempotencyRecord\n{\n    private IdempotencyRecord()\n    {\n    }\n\n    private IdempotencyRecord(\n        Guid id,\n        Guid userId,\n        string key,\n        string requestHash,\n        DateTimeOffset createdAtUtc)\n    {\n        Id = id;\n        UserId = userId;\n        Key = key;\n        RequestHash = requestHash;\n        State = IdempotencyRecordState.InProgress;\n        CreatedAtUtc = createdAtUtc;\n        UpdatedAtUtc = createdAtUtc;\n    }\n\n    public Guid Id { get; private set; }\n\n    public Guid UserId { get; private set; }\n\n    public string Key { get; private set; } = null!;\n\n    public string RequestHash { get; private set; } = null!;\n\n    public IdempotencyRecordState State { get; private set; }\n\n    public int? ResponseStatusCode { get; private set; }\n\n    public string? ResponseBody { get; private set; }\n\n    public DateTimeOffset CreatedAtUtc { get; private set; }\n\n    public DateTimeOffset UpdatedAtUtc { get; private set; }\n\n    public static IdempotencyRecord Start(\n        Guid userId,\n        string key,\n        string requestHash,\n        DateTimeOffset createdAtUtc)\n    {\n        if (userId == Guid.Empty)\n        {\n            throw new ArgumentException(\"O usuário autenticado é obrigatório.\", nameof(userId));\n        }\n\n        ArgumentException.ThrowIfNullOrWhiteSpace(key);\n        ArgumentException.ThrowIfNullOrWhiteSpace(requestHash);\n\n        return new IdempotencyRecord(\n            Guid.NewGuid(),\n            userId,\n            key.Trim(),\n            requestHash.Trim().ToLowerInvariant(),\n            createdAtUtc);\n    }\n\n    public void Complete(int responseStatusCode, string responseBody, DateTimeOffset completedAtUtc)\n    {\n        ArgumentNullException.ThrowIfNull(responseBody);\n        State = IdempotencyRecordState.Completed;\n        ResponseStatusCode = responseStatusCode;\n        ResponseBody = responseBody;\n        UpdatedAtUtc = completedAtUtc;\n    }\n}\n\npublic enum IdempotencyRecordState\n{\n    InProgress = 0,\n    Completed = 1,\n}\n\r\n===== src/Agendamento.Api/Infrastructure/Persistence/Configurations/TenantConfiguration.cs =====\r\nusing Agendamento.Domain.Tenants;\nusing Microsoft.EntityFrameworkCore;\nusing Microsoft.EntityFrameworkCore.Metadata.Builders;\n\nnamespace Agendamento.Infrastructure.Persistence.Configurations;\n\npublic sealed class TenantConfiguration : IEntityTypeConfiguration<Tenant>\n{\n    public void Configure(EntityTypeBuilder<Tenant> builder)\n    {\n        builder.ToTable(\"tenants\", table =>\n        {\n            table.HasCheckConstraint(\n                \"ck_tenants_cnpj_canonical\",\n                \"cnpj ~ '^[A-Z0-9]{12}[0-9]{2}$'\");\n            table.HasCheckConstraint(\n                \"ck_tenants_category\",\n                \"category IN ('restaurant', 'supermarket', 'grocery_store', 'bakery')\");\n        });\n\n        builder.HasKey(tenant => tenant.Id).HasName(\"pk_tenants\");\n        builder.Property(tenant => tenant.Id).HasColumnName(\"id\").ValueGeneratedNever();\n        builder.Property(tenant => tenant.Cnpj).HasColumnName(\"cnpj\").HasMaxLength(14).IsRequired();\n        builder.Property(tenant => tenant.LegalName).HasColumnName(\"legal_name\").HasMaxLength(200).IsRequired();\n        builder.Property(tenant => tenant.TradeName).HasColumnName(\"trade_name\").HasMaxLength(200);\n        builder.Property(tenant => tenant.LegalNature).HasColumnName(\"legal_nature\").HasMaxLength(100);\n        builder.Property(tenant => tenant.PrimaryCnae).HasColumnName(\"primary_cnae\").HasMaxLength(7);\n        builder.Property(tenant => tenant.Category)\n            .HasColumnName(\"category\")\n            .HasConversion(category => SerializeCategory(category), value => DeserializeCategory(value))\n            .HasMaxLength(32)\n            .IsRequired();\n        builder.Property(tenant => tenant.BusinessEmail)\n            .HasColumnName(\"business_email\")\n            .HasMaxLength(320)\n            .IsRequired();\n        builder.Property(tenant => tenant.BusinessPhone)\n            .HasColumnName(\"business_phone\")\n            .HasMaxLength(32)\n            .IsRequired();\n        builder.Property(tenant => tenant.CreatedAtUtc).HasColumnName(\"created_at_utc\").IsRequired();\n\n        builder.HasIndex(tenant => tenant.Cnpj)\n            .IsUnique()\n            .HasDatabaseName(\"ux_tenants_cnpj\");\n\n        builder.OwnsOne(tenant => tenant.Address, address =>\n        {\n            address.Property(value => value.Street).HasColumnName(\"address_street\").HasMaxLength(200).IsRequired();\n            address.Property(value => value.Number).HasColumnName(\"address_number\").HasMaxLength(30).IsRequired();\n            address.Property(value => value.District).HasColumnName(\"address_district\").HasMaxLength(100).IsRequired();\n            address.Property(value => value.City).HasColumnName(\"address_city\").HasMaxLength(100).IsRequired();\n            address.Property(value => value.State).HasColumnName(\"address_state\").HasMaxLength(2).IsRequired();\n            address.Property(value => value.PostalCode).HasColumnName(\"address_postal_code\").HasMaxLength(9).IsRequired();\n            address.Property(value => value.Complement).HasColumnName(\"address_complement\").HasMaxLength(200);\n        });\n        builder.Navigation(tenant => tenant.Address).IsRequired();\n    }\n\n    private static string SerializeCategory(BusinessCategory category) => category switch\n    {\n        BusinessCategory.Restaurant => \"restaurant\",\n        BusinessCategory.Supermarket => \"supermarket\",\n        BusinessCategory.GroceryStore => \"grocery_store\",\n        BusinessCategory.Bakery => \"bakery\",\n        _ => throw new ArgumentOutOfRangeException(nameof(category)),\n    };\n\n    private static BusinessCategory DeserializeCategory(string value) => value switch\n    {\n        \"restaurant\" => BusinessCategory.Restaurant,\n        \"supermarket\" => BusinessCategory.Supermarket,\n        \"grocery_store\" => BusinessCategory.GroceryStore,\n        \"bakery\" => BusinessCategory.Bakery,\n        _ => throw new InvalidOperationException($\"Categoria persistida inválida: {value}.\"),\n    };\n}\n\r\n===== src/Agendamento.Api/Infrastructure/Persistence/Configurations/TenantFiscalProfileConfiguration.cs =====\r\nusing Agendamento.Domain.Tenants;\nusing Microsoft.EntityFrameworkCore;\nusing Microsoft.EntityFrameworkCore.Metadata.Builders;\n\nnamespace Agendamento.Infrastructure.Persistence.Configurations;\n\npublic sealed class TenantFiscalProfileConfiguration : IEntityTypeConfiguration<TenantFiscalProfile>\n{\n    public void Configure(EntityTypeBuilder<TenantFiscalProfile> builder)\n    {\n        builder.ToTable(\"tenant_fiscal_profiles\", table =>\n            table.HasCheckConstraint(\n                \"ck_tenant_fiscal_profiles_tax_regime\",\n                \"tax_regime IN ('simples_nacional', 'lucro_presumido', 'lucro_real')\"));\n\n        builder.HasKey(profile => profile.TenantId).HasName(\"pk_tenant_fiscal_profiles\");\n        builder.Property(profile => profile.TenantId).HasColumnName(\"tenant_id\").ValueGeneratedNever();\n        builder.Property(profile => profile.StateRegistration)\n            .HasColumnName(\"state_registration\")\n            .HasMaxLength(30);\n        builder.Property(profile => profile.MunicipalRegistration)\n            .HasColumnName(\"municipal_registration\")\n            .HasMaxLength(30);\n        builder.Property(profile => profile.IsStateRegistrationExempt)\n            .HasColumnName(\"is_state_registration_exempt\")\n            .IsRequired();\n        builder.Property(profile => profile.TaxRegime)\n            .HasColumnName(\"tax_regime\")\n            .HasConversion(regime => SerializeTaxRegime(regime), value => DeserializeTaxRegime(value))\n            .HasMaxLength(32)\n            .IsRequired();\n        builder.Property(profile => profile.FiscalEmail)\n            .HasColumnName(\"fiscal_email\")\n            .HasMaxLength(320)\n            .IsRequired();\n\n        builder.HasOne<Tenant>()\n            .WithOne()\n            .HasForeignKey<TenantFiscalProfile>(profile => profile.TenantId)\n            .HasConstraintName(\"fk_tenant_fiscal_profiles_tenants_tenant_id\")\n            .OnDelete(DeleteBehavior.Cascade);\n    }\n\n    private static string SerializeTaxRegime(TaxRegime regime) => regime switch\n    {\n        TaxRegime.SimplesNacional => \"simples_nacional\",\n        TaxRegime.LucroPresumido => \"lucro_presumido\",\n        TaxRegime.LucroReal => \"lucro_real\",\n        _ => throw new ArgumentOutOfRangeException(nameof(regime)),\n    };\n\n    private static TaxRegime DeserializeTaxRegime(string value) => value switch\n    {\n        \"simples_nacional\" => TaxRegime.SimplesNacional,\n        \"lucro_presumido\" => TaxRegime.LucroPresumido,\n        \"lucro_real\" => TaxRegime.LucroReal,\n        _ => throw new InvalidOperationException($\"Regime tributário persistido inválido: {value}.\"),\n    };\n}\n\r\n===== src/Agendamento.Api/Infrastructure/Persistence/Configurations/TenantMembershipConfiguration.cs =====\r\nusing Agendamento.Domain.Identity;\nusing Agendamento.Domain.Tenants;\nusing Microsoft.EntityFrameworkCore;\nusing Microsoft.EntityFrameworkCore.Metadata.Builders;\n\nnamespace Agendamento.Infrastructure.Persistence.Configurations;\n\npublic sealed class TenantMembershipConfiguration : IEntityTypeConfiguration<TenantMembership>\n{\n    public void Configure(EntityTypeBuilder<TenantMembership> builder)\n    {\n        builder.ToTable(\"tenant_memberships\", table =>\n            table.HasCheckConstraint(\"ck_tenant_memberships_role\", \"role = 'owner_admin'\"));\n\n        builder.HasKey(membership => membership.Id).HasName(\"pk_tenant_memberships\");\n        builder.Property(membership => membership.Id).HasColumnName(\"id\").ValueGeneratedNever();\n        builder.Property(membership => membership.TenantId).HasColumnName(\"tenant_id\").IsRequired();\n        builder.Property(membership => membership.UserId).HasColumnName(\"user_id\").IsRequired();\n        builder.Property(membership => membership.Role)\n            .HasColumnName(\"role\")\n            .HasConversion(role => SerializeRole(role), value => DeserializeRole(value))\n            .HasMaxLength(32)\n            .IsRequired();\n        builder.Property(membership => membership.IsLegalRepresentative)\n            .HasColumnName(\"is_legal_representative\")\n            .IsRequired();\n        builder.Property(membership => membership.Position)\n            .HasColumnName(\"position\")\n            .HasMaxLength(100)\n            .IsRequired();\n        builder.Property(membership => membership.CreatedAtUtc)\n            .HasColumnName(\"created_at_utc\")\n            .IsRequired();\n\n        builder.HasIndex(membership => new { membership.TenantId, membership.UserId })\n            .IsUnique()\n            .HasDatabaseName(\"ux_tenant_memberships_tenant_id_user_id\");\n        builder.HasIndex(membership => membership.UserId)\n            .HasDatabaseName(\"ix_tenant_memberships_user_id\");\n\n        builder.HasOne<Tenant>()\n            .WithMany()\n            .HasForeignKey(membership => membership.TenantId)\n            .HasConstraintName(\"fk_tenant_memberships_tenants_tenant_id\")\n            .OnDelete(DeleteBehavior.Cascade);\n        builder.HasOne<User>()\n            .WithMany()\n            .HasForeignKey(membership => membership.UserId)\n            .HasConstraintName(\"fk_tenant_memberships_users_user_id\")\n            .OnDelete(DeleteBehavior.Restrict);\n    }\n\n    private static string SerializeRole(TenantRole role) => role switch\n    {\n        TenantRole.OwnerAdmin => \"owner_admin\",\n        _ => throw new ArgumentOutOfRangeException(nameof(role)),\n    };\n\n    private static TenantRole DeserializeRole(string value) => value switch\n    {\n        \"owner_admin\" => TenantRole.OwnerAdmin,\n        _ => throw new InvalidOperationException($\"Papel persistido inválido: {value}.\"),\n    };\n}\n\r\n===== src/Agendamento.Api/Infrastructure/Persistence/Configurations/IdempotencyRecordConfiguration.cs =====\r\nusing Agendamento.Domain.Identity;\nusing Microsoft.EntityFrameworkCore;\nusing Microsoft.EntityFrameworkCore.Metadata.Builders;\n\nnamespace Agendamento.Infrastructure.Persistence.Configurations;\n\npublic sealed class IdempotencyRecordConfiguration : IEntityTypeConfiguration<IdempotencyRecord>\n{\n    public void Configure(EntityTypeBuilder<IdempotencyRecord> builder)\n    {\n        builder.ToTable(\"idempotency_records\", table =>\n        {\n            table.HasCheckConstraint(\n                \"ck_idempotency_records_request_hash\",\n                \"request_hash ~ '^[0-9a-f]{64}$'\");\n            table.HasCheckConstraint(\n                \"ck_idempotency_records_state\",\n                \"state IN ('in_progress', 'completed')\");\n        });\n\n        builder.HasKey(record => record.Id).HasName(\"pk_idempotency_records\");\n        builder.Property(record => record.Id).HasColumnName(\"id\").ValueGeneratedNever();\n        builder.Property(record => record.UserId).HasColumnName(\"user_id\").IsRequired();\n        builder.Property(record => record.Key).HasColumnName(\"key\").HasMaxLength(255).IsRequired();\n        builder.Property(record => record.RequestHash)\n            .HasColumnName(\"request_hash\")\n            .HasMaxLength(64)\n            .IsFixedLength()\n            .IsRequired();\n        builder.Property(record => record.State)\n            .HasColumnName(\"state\")\n            .HasConversion(state => SerializeState(state), value => DeserializeState(value))\n            .HasMaxLength(32)\n            .IsRequired();\n        builder.Property(record => record.ResponseStatusCode).HasColumnName(\"response_status_code\");\n        builder.Property(record => record.ResponseBody).HasColumnName(\"response_body\").HasColumnType(\"jsonb\");\n        builder.Property(record => record.CreatedAtUtc).HasColumnName(\"created_at_utc\").IsRequired();\n        builder.Property(record => record.UpdatedAtUtc).HasColumnName(\"updated_at_utc\").IsRequired();\n\n        builder.HasIndex(record => new { record.UserId, record.Key })\n            .IsUnique()\n            .HasDatabaseName(\"ux_idempotency_records_user_id_key\");\n\n        builder.HasOne<User>()\n            .WithMany()\n            .HasForeignKey(record => record.UserId)\n            .HasConstraintName(\"fk_idempotency_records_users_user_id\")\n            .OnDelete(DeleteBehavior.Restrict);\n    }\n\n    private static string SerializeState(IdempotencyRecordState state) => state switch\n    {\n        IdempotencyRecordState.InProgress => \"in_progress\",\n        IdempotencyRecordState.Completed => \"completed\",\n        _ => throw new ArgumentOutOfRangeException(nameof(state)),\n    };\n\n    private static IdempotencyRecordState DeserializeState(string value) => value switch\n    {\n        \"in_progress\" => IdempotencyRecordState.InProgress,\n        \"completed\" => IdempotencyRecordState.Completed,\n        _ => throw new InvalidOperationException($\"Estado idempotente persistido inválido: {value}.\"),\n    };\n}\n\r\n===== src/Agendamento.Api/Infrastructure/Persistence/Configurations/UserConfiguration.cs =====\r\nnamespace Agendamento.Infrastructure.Persistence.Configurations;\r\n\r\npublic static class UserConfiguration\r\n{\r\n    public const string CreateTableSql = \"\"\"\r\n        CREATE TABLE IF NOT EXISTS \"Users\" (\r\n            \"Id\" uuid PRIMARY KEY,\r\n            \"Cpf\" varchar(11) NOT NULL,\r\n            \"Email\" varchar(320) NOT NULL,\r\n            \"PasswordHash\" text NOT NULL,\r\n            \"Status\" integer NOT NULL,\r\n            \"CreatedAtUtc\" timestamptz NOT NULL,\r\n            \"EmailVerifiedAtUtc\" timestamptz NULL,\r\n            CONSTRAINT \"UX_Users_Cpf\" UNIQUE (\"Cpf\"),\r\n            CONSTRAINT \"UX_Users_Email\" UNIQUE (\"Email\")\r\n        );\r\n        \"\"\";\r\n}\r\n\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"\"C:\\\\Program Files\\\\WindowsApps\\\\Microsoft.PowerShell_7.6.4.0_x64__8wekyb3d8bbwe\\\\pwsh.exe\" -Command \"\\\"===== tests/Agendamento.IntegrationTests/Tenants/TenantPersistenceTests.cs =====\\\"; Get-Content -Raw 'tests/Agendamento.IntegrationTests/Tenants/TenantPersistenceTests.cs'; \\\"===== tests/Agendamento.IntegrationTests/Infrastructure/PostgreSqlFixture.cs =====\\\"; Get-Content -Raw 'tests/Agendamento.IntegrationTests/Infrastructure/PostgreSqlFixture.cs'; \\\"===== tests/Agendamento.IntegrationTests/Infrastructure/PostgreSqlCollection.cs =====\\\"; Get-Content -Raw 'tests/Agendamento.IntegrationTests/Infrastructure/PostgreSqlCollection.cs'; \\\"===== tests/Agendamento.UnitTests/Tenants/LookupCompanyHandlerTests.cs =====\\\"; Get-Content -Raw 'tests/Agendamento.UnitTests/Tenants/LookupCompanyHandlerTests.cs'\"","aggregated_output":"===== tests/Agendamento.IntegrationTests/Tenants/TenantPersistenceTests.cs =====\r\nusing Agendamento.Domain.Identity;\nusing Agendamento.Domain.Tenants;\nusing Agendamento.Infrastructure.Persistence;\nusing Agendamento.Infrastructure.Persistence.Configurations;\nusing Agendamento.IntegrationTests.Infrastructure;\nusing Microsoft.EntityFrameworkCore;\nusing Xunit;\n\nnamespace Agendamento.IntegrationTests.Tenants;\n\n[Collection(PostgreSqlCollection.Name)]\npublic sealed class TenantPersistenceTests(PostgreSqlFixture fixture)\n{\n    [Fact(DisplayName = \"Migration PostgreSQL aplica e mantém perfil fiscal 1:1 @spec:AC-019\")]\n    public async Task Migration_applies_and_persists_exactly_one_fiscal_profile_per_tenant()\n    {\n        await EnsureMigrationAsync();\n        var tenant = CreateTenant(Cnpj.Parse(\"04.252.011/0001-10\").Value);\n        var profile = CreateFiscalProfile(tenant.Id);\n\n        try\n        {\n            await using (var context = CreateDbContext())\n            {\n                context.AddRange(tenant, profile);\n                await context.SaveChangesAsync();\n            }\n\n            await using (var duplicateContext = CreateDbContext())\n            {\n                duplicateContext.TenantFiscalProfiles.Add(CreateFiscalProfile(tenant.Id));\n                await Assert.ThrowsAsync<DbUpdateException>(() => duplicateContext.SaveChangesAsync());\n            }\n\n            await using var assertionContext = CreateDbContext();\n            var persistedTenant = await assertionContext.Tenants.AsNoTracking().SingleAsync(value => value.Id == tenant.Id);\n            var persistedProfile = await assertionContext.TenantFiscalProfiles\n                .AsNoTracking()\n                .SingleAsync(value => value.TenantId == tenant.Id);\n            var appliedMigrations = await assertionContext.Database.GetAppliedMigrationsAsync();\n\n            Assert.Contains(appliedMigrations, migration => migration.EndsWith(\"_CreateTenantPersistence\", StringComparison.Ordinal));\n            Assert.Equal(\"Rua das Flores\", persistedTenant.Address.Street);\n            Assert.Equal(\"123.456.789.000\", persistedProfile.StateRegistration);\n            Assert.Equal(TaxRegime.SimplesNacional, persistedProfile.TaxRegime);\n            Assert.Equal(1, await assertionContext.TenantFiscalProfiles.CountAsync(value => value.TenantId == tenant.Id));\n        }\n        finally\n        {\n            await DeleteTenantAsync(tenant.Id);\n        }\n    }\n\n    [Fact(DisplayName = \"Membership owner_admin preserva usuário autenticado e FKs explícitas @spec:AC-021\")]\n    public async Task Membership_persists_for_existing_user_and_rejects_missing_tenant_or_user()\n    {\n        await EnsureMigrationAsync();\n        var user = await CreateUserAsync();\n        var tenant = CreateTenant(Cnpj.Parse(\"12.ABC.345/01DE-35\").Value);\n        var profile = CreateFiscalProfile(tenant.Id);\n        var membership = TenantMembership.CreateOwnerAdmin(tenant.Id, user.Id, true, \"Sócia administradora\");\n\n        try\n        {\n            await using (var context = CreateDbContext())\n            {\n                context.AddRange(tenant, profile, membership);\n                await context.SaveChangesAsync();\n            }\n\n            await using (var missingTenantContext = CreateDbContext())\n            {\n                missingTenantContext.TenantMemberships.Add(\n                    TenantMembership.CreateOwnerAdmin(Guid.NewGuid(), user.Id, false, \"Administradora\"));\n                await Assert.ThrowsAsync<DbUpdateException>(() => missingTenantContext.SaveChangesAsync());\n            }\n\n            await using (var missingUserContext = CreateDbContext())\n            {\n                missingUserContext.TenantMemberships.Add(\n                    TenantMembership.CreateOwnerAdmin(tenant.Id, Guid.NewGuid(), false, \"Administradora\"));\n                await Assert.ThrowsAsync<DbUpdateException>(() => missingUserContext.SaveChangesAsync());\n            }\n\n            await using var assertionContext = CreateDbContext();\n            var persisted = await assertionContext.TenantMemberships\n                .AsNoTracking()\n                .SingleAsync(value => value.Id == membership.Id);\n\n            Assert.Equal(tenant.Id, persisted.TenantId);\n            Assert.Equal(user.Id, persisted.UserId);\n            Assert.Equal(TenantRole.OwnerAdmin, persisted.Role);\n            Assert.True(persisted.IsLegalRepresentative);\n            Assert.Equal(1, await assertionContext.TenantMemberships.CountAsync(value => value.TenantId == tenant.Id));\n        }\n        finally\n        {\n            await DeleteTenantAsync(tenant.Id);\n            await DeleteUserAsync(user.Id);\n        }\n    }\n\n    [Fact(DisplayName = \"CNPJ canônico tem UNIQUE global sem duplicar tenant @spec:AC-022\")]\n    public async Task Duplicate_canonical_cnpj_fails_without_creating_another_tenant()\n    {\n        await EnsureMigrationAsync();\n        var canonicalCnpj = Cnpj.Parse(\"12.ABC.345/01DE-35\").Value;\n        var sameCanonicalCnpj = Cnpj.Parse(\"12abc34501de35\").Value;\n        var registeredTenant = CreateTenant(canonicalCnpj);\n        var duplicateTenant = CreateTenant(sameCanonicalCnpj);\n\n        try\n        {\n            await using (var context = CreateDbContext())\n            {\n                context.Tenants.Add(registeredTenant);\n                await context.SaveChangesAsync();\n            }\n\n            await using (var duplicateContext = CreateDbContext())\n            {\n                duplicateContext.Tenants.Add(duplicateTenant);\n                await Assert.ThrowsAsync<DbUpdateException>(() => duplicateContext.SaveChangesAsync());\n            }\n\n            await using var assertionContext = CreateDbContext();\n            Assert.Equal(1, await assertionContext.Tenants.CountAsync(value => value.Cnpj == canonicalCnpj));\n            Assert.False(await assertionContext.Tenants.AnyAsync(value => value.Id == duplicateTenant.Id));\n        }\n        finally\n        {\n            await DeleteTenantAsync(registeredTenant.Id);\n            await DeleteTenantAsync(duplicateTenant.Id);\n        }\n    }\n\n    [Fact(DisplayName = \"Falha idempotente reverte tenant, perfil, membership e registro @spec:AC-024\")]\n    public async Task Idempotency_conflict_rolls_back_all_registration_components()\n    {\n        await EnsureMigrationAsync();\n        var user = await CreateUserAsync();\n        var tenant = CreateTenant(Cnpj.Parse(\"04.252.011/0001-10\").Value);\n        var idempotencyKey = $\"register-tenant-{Guid.NewGuid():N}\";\n\n        try\n        {\n            await using (var context = CreateDbContext())\n            await using (var transaction = await context.Database.BeginTransactionAsync())\n            {\n                var record = IdempotencyRecord.Start(\n                    user.Id,\n                    idempotencyKey,\n                    new string('a', 64),\n                    DateTimeOffset.UtcNow);\n                record.Complete(201, $$\"\"\"{\"tenant_id\":\"{{tenant.Id}}\"}\"\"\", DateTimeOffset.UtcNow);\n\n                context.AddRange(\n                    tenant,\n                    CreateFiscalProfile(tenant.Id),\n                    TenantMembership.CreateOwnerAdmin(tenant.Id, user.Id, false, \"Administradora\"),\n                    record);\n                await context.SaveChangesAsync();\n\n                context.IdempotencyRecords.Add(IdempotencyRecord.Start(\n                    user.Id,\n                    idempotencyKey,\n                    new string('b', 64),\n                    DateTimeOffset.UtcNow));\n                await Assert.ThrowsAsync<DbUpdateException>(() => context.SaveChangesAsync());\n                await transaction.RollbackAsync();\n            }\n\n            await using var assertionContext = CreateDbContext();\n            Assert.False(await assertionContext.Tenants.AnyAsync(value => value.Id == tenant.Id));\n            Assert.False(await assertionContext.TenantFiscalProfiles.AnyAsync(value => value.TenantId == tenant.Id));\n            Assert.False(await assertionContext.TenantMemberships.AnyAsync(value => value.TenantId == tenant.Id));\n            Assert.False(await assertionContext.IdempotencyRecords.AnyAsync(\n                value => value.UserId == user.Id && value.Key == idempotencyKey));\n        }\n        finally\n        {\n            await DeleteTenantAsync(tenant.Id);\n            await DeleteIdempotencyRecordsAsync(user.Id);\n            await DeleteUserAsync(user.Id);\n        }\n    }\n\n    private AgendamentoDbContext CreateDbContext()\n    {\n        var options = new DbContextOptionsBuilder<AgendamentoDbContext>()\n            .UseNpgsql(fixture.ConnectionString)\n            .Options;\n        return new AgendamentoDbContext(options);\n    }\n\n    private async Task EnsureMigrationAsync()\n    {\n        await fixture.ExecuteScriptAsync(UserConfiguration.CreateTableSql);\n        await using var context = CreateDbContext();\n        await context.Database.MigrateAsync();\n    }\n\n    private async Task<User> CreateUserAsync()\n    {\n        var cpf = string.Concat(Enumerable.Range(0, 11).Select(_ => Random.Shared.Next(10)));\n        var user = User.Create(cpf, $\"tenant-test-{Guid.NewGuid():N}@example.com\", \"test-password-hash\");\n        await using var context = CreateDbContext();\n        await context.Database.ExecuteSqlInterpolatedAsync($\"\"\"\n            INSERT INTO \"Users\" (\"Id\", \"Cpf\", \"Email\", \"PasswordHash\", \"Status\", \"CreatedAtUtc\")\n            VALUES ({user.Id}, {user.Cpf}, {user.Email}, {user.PasswordHash}, {(int)user.Status}, {user.CreatedAtUtc});\n            \"\"\");\n        return user;\n    }\n\n    private async Task DeleteTenantAsync(Guid tenantId)\n    {\n        await using var context = CreateDbContext();\n        await context.Tenants.Where(value => value.Id == tenantId).ExecuteDeleteAsync();\n    }\n\n    private async Task DeleteIdempotencyRecordsAsync(Guid userId)\n    {\n        await using var context = CreateDbContext();\n        await context.IdempotencyRecords.Where(value => value.UserId == userId).ExecuteDeleteAsync();\n    }\n\n    private async Task DeleteUserAsync(Guid userId)\n    {\n        await using var context = CreateDbContext();\n        await context.Database.ExecuteSqlInterpolatedAsync($\"\"\"\n            DELETE FROM \"Users\" WHERE \"Id\" = {userId};\n            \"\"\");\n    }\n\n    private static Tenant CreateTenant(string cnpj) => Tenant.Create(\n        cnpj,\n        \"Restaurante Exemplo Ltda\",\n        BusinessCategory.Restaurant,\n        \"contato@exemplo.com\",\n        \"+55 11 99999-9999\",\n        TenantAddress.Create(\n            \"Rua das Flores\",\n            \"100\",\n            \"Centro\",\n            \"São Paulo\",\n            \"SP\",\n            \"01001-000\"),\n        \"Restaurante Exemplo\",\n        \"Sociedade Empresária Limitada\",\n        \"5611201\");\n\n    private static TenantFiscalProfile CreateFiscalProfile(Guid tenantId) => TenantFiscalProfile.Create(\n        tenantId,\n        TaxRegime.SimplesNacional,\n        \"fiscal@exemplo.com\",\n        \"123.456.789.000\",\n        \"987654\",\n        isStateRegistrationExempt: false);\n}\n\r\n===== tests/Agendamento.IntegrationTests/Infrastructure/PostgreSqlFixture.cs =====\r\nusing DotNet.Testcontainers.Containers;\r\nusing Testcontainers.PostgreSql;\r\nusing Xunit;\r\n\r\nnamespace Agendamento.IntegrationTests.Infrastructure;\r\n\r\npublic sealed class PostgreSqlFixture : IAsyncLifetime\r\n{\r\n    private const string FixtureMigration = \"\"\"\r\n        CREATE TABLE IF NOT EXISTS \"__FixtureMigrations\" (\r\n            \"MigrationId\" text PRIMARY KEY,\r\n            \"AppliedAtUtc\" timestamptz NOT NULL DEFAULT CURRENT_TIMESTAMP\r\n        );\r\n\r\n        CREATE TABLE IF NOT EXISTS \"FixtureIsolationProbe\" (\r\n            \"Value\" text PRIMARY KEY\r\n        );\r\n\r\n        INSERT INTO \"__FixtureMigrations\" (\"MigrationId\")\r\n        VALUES ('0001_fixture_infrastructure')\r\n        ON CONFLICT (\"MigrationId\") DO NOTHING;\r\n        \"\"\";\r\n\r\n    private readonly PostgreSqlContainer _container;\r\n\r\n    public PostgreSqlFixture()\r\n    {\r\n        DatabaseName = $\"agendamento_tests_{Guid.NewGuid():N}\";\r\n        _container = new PostgreSqlBuilder()\r\n            .WithImage(\"postgres:16-alpine\")\r\n            .WithDatabase(DatabaseName)\r\n            .WithUsername(\"postgres\")\r\n            .WithPassword($\"test_{Guid.NewGuid():N}\")\r\n            .Build();\r\n    }\r\n\r\n    public string DatabaseName { get; }\r\n\r\n    public string ConnectionString => _container.GetConnectionString();\r\n\r\n    public async Task InitializeAsync()\r\n    {\r\n        try\r\n        {\r\n            await _container.StartAsync();\r\n            await ExecuteScriptAsync(FixtureMigration);\r\n        }\r\n        catch\r\n        {\r\n            await _container.DisposeAsync();\r\n            throw;\r\n        }\r\n    }\r\n\r\n    public Task<ExecResult> ExecuteScriptAsync(string script) =>\r\n        _container.ExecScriptAsync(script).ThrowOnFailure();\r\n\r\n    public async Task DisposeAsync() => await _container.DisposeAsync();\r\n}\r\n\r\n===== tests/Agendamento.IntegrationTests/Infrastructure/PostgreSqlCollection.cs =====\r\nusing Xunit;\r\n\r\nnamespace Agendamento.IntegrationTests.Infrastructure;\r\n\r\n[CollectionDefinition(Name)]\r\npublic sealed class PostgreSqlCollection : ICollectionFixture<PostgreSqlFixture>\r\n{\r\n    public const string Name = \"PostgreSQL\";\r\n}\r\n\r\n===== tests/Agendamento.UnitTests/Tenants/LookupCompanyHandlerTests.cs =====\r\nusing Agendamento.Application.Tenants.CompanyRegistry;\nusing Agendamento.Application.Tenants.LookupCompany;\nusing Agendamento.Infrastructure.CompanyRegistry;\nusing Xunit;\n\nnamespace Agendamento.UnitTests.Tenants;\n\npublic sealed class LookupCompanyHandlerTests\n{\n    [Fact(DisplayName = \"CNPJ inválido é rejeitado localmente sem consultar provedor @spec:AC-014\")]\n    public async Task HandleAsync_rejects_invalid_cnpj_without_calling_gateway()\n    {\n        var gateway = new FakeGateway(EligibleCompany());\n        var handler = new LookupCompanyHandler(gateway, new FoodCnaePolicy());\n\n        var result = await handler.HandleAsync(new LookupCompanyQuery(\"04.252.011/0001-11\"));\n\n        Assert.Equal(LookupCompanyStatus.InvalidCnpj, result.Status);\n        Assert.Equal(0, gateway.CallCount);\n    }\n\n    [Fact(DisplayName = \"Empresa inativa não pode continuar @spec:AC-015\")]\n    public async Task HandleAsync_blocks_an_inactive_company()\n    {\n        var handler = new LookupCompanyHandler(\n            new FakeGateway(EligibleCompany(registrationStatus: \"BAIXADA\")),\n            new FoodCnaePolicy());\n\n        var result = await handler.HandleAsync(new LookupCompanyQuery(\"04.252.011/0001-10\"));\n\n        Assert.Equal(LookupCompanyStatus.CompanyInactive, result.Status);\n        Assert.Equal(\"04252011000110\", result.Cnpj);\n    }\n\n    [Fact(DisplayName = \"Empresa ativa sem CNAE alimentício não pode continuar @spec:AC-016\")]\n    public async Task HandleAsync_blocks_a_company_without_an_eligible_cnae()\n    {\n        var handler = new LookupCompanyHandler(\n            new FakeGateway(EligibleCompany(primaryCnae: \"6201501\", secondaryCnaes: [\"6202300\"])),\n            new FoodCnaePolicy());\n\n        var result = await handler.HandleAsync(new LookupCompanyQuery(\"04.252.011/0001-10\"));\n\n        Assert.Equal(LookupCompanyStatus.IneligibleCnae, result.Status);\n    }\n\n    [Fact(DisplayName = \"Consulta elegível retorna dados cadastrais completos @spec:AC-017\")]\n    public async Task HandleAsync_returns_normalized_cnpj_and_available_company_data()\n    {\n        var company = EligibleCompany();\n        var handler = new LookupCompanyHandler(new FakeGateway(company), new FoodCnaePolicy());\n\n        var result = await handler.HandleAsync(new LookupCompanyQuery(\"04.252.011/0001-10\"));\n\n        Assert.Equal(LookupCompanyStatus.Eligible, result.Status);\n        Assert.Equal(\"04252011000110\", result.Cnpj);\n        Assert.Equal(company, result.Company);\n        Assert.Equal(\"Razão Social Ltda.\", result.Company!.LegalName);\n        Assert.Equal(\"Nome Fantasia\", result.Company.TradeName);\n        Assert.Equal(\"206-2\", result.Company.LegalNature);\n        Assert.Equal(\"5611201\", result.Company.PrimaryCnae);\n        Assert.Equal([\"6201501\"], result.Company.SecondaryCnaes);\n        Assert.Equal(\"ATIVA\", result.Company.RegistrationStatus);\n        Assert.Equal(new CompanyRegistryAddress(\"Rua A\", \"123\", null, \"Centro\", \"São Paulo\", \"SP\", \"01001000\"), result.Company.Address);\n    }\n\n    [Fact(DisplayName = \"Indisponibilidade do provedor é dependência indisponível\")]\n    public async Task HandleAsync_distinguishes_an_unavailable_dependency()\n    {\n        var handler = new LookupCompanyHandler(new UnavailableCompanyRegistryGateway(), new FoodCnaePolicy());\n\n        var result = await handler.HandleAsync(new LookupCompanyQuery(\"04.252.011/0001-10\"));\n\n        Assert.Equal(LookupCompanyStatus.DependencyUnavailable, result.Status);\n    }\n\n    private static CompanyRegistryResult EligibleCompany(\n        string registrationStatus = \"ATIVA\",\n        string primaryCnae = \"5611201\",\n        IReadOnlyCollection<string>? secondaryCnaes = null) =>\n        new(\n            \"Razão Social Ltda.\",\n            \"Nome Fantasia\",\n            \"206-2\",\n            primaryCnae,\n            secondaryCnaes ?? [\"6201501\"],\n            registrationStatus,\n            new CompanyRegistryAddress(\"Rua A\", \"123\", null, \"Centro\", \"São Paulo\", \"SP\", \"01001000\"));\n\n    private sealed class FakeGateway(CompanyRegistryResult company) : ICompanyRegistryGateway\n    {\n        public int CallCount { get; private set; }\n\n        public Task<CompanyRegistryResult> LookupAsync(Agendamento.Domain.Tenants.Cnpj cnpj, CancellationToken cancellationToken = default)\n        {\n            CallCount++;\n            return Task.FromResult(company);\n        }\n    }\n}\n\r\n","exit_code":0,"status":"completed"}}
