{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"\"C:\\\\Program Files\\\\WindowsApps\\\\Microsoft.PowerShell_7.6.4.0_x64__8wekyb3d8bbwe\\\\pwsh.exe\" -Command \"Get-Content -Raw 'src/Agendamento.Api/Infrastructure/Persistence/Configurations/TenantConfiguration.cs'\"","aggregated_output":"using Agendamento.Domain.Tenants;\nusing Microsoft.EntityFrameworkCore;\nusing Microsoft.EntityFrameworkCore.Metadata.Builders;\n\nnamespace Agendamento.Infrastructure.Persistence.Configurations;\n\npublic sealed class TenantConfiguration : IEntityTypeConfiguration<Tenant>\n{\n    public void Configure(EntityTypeBuilder<Tenant> builder)\n    {\n        builder.ToTable(\"tenants\", table =>\n        {\n            table.HasCheckConstraint(\n                \"ck_tenants_cnpj_canonical\",\n                \"cnpj ~ '^[A-Z0-9]{12}[0-9]{2}$'\");\n            table.HasCheckConstraint(\n                \"ck_tenants_category\",\n                \"category IN ('restaurant', 'supermarket', 'grocery_store', 'bakery')\");\n        });\n\n        builder.HasKey(tenant => tenant.Id).HasName(\"pk_tenants\");\n        builder.Property(tenant => tenant.Id).HasColumnName(\"id\").ValueGeneratedNever();\n        builder.Property(tenant => tenant.Cnpj).HasColumnName(\"cnpj\").HasMaxLength(14).IsRequired();\n        builder.Property(tenant => tenant.LegalName).HasColumnName(\"legal_name\").HasMaxLength(200).IsRequired();\n        builder.Property(tenant => tenant.TradeName).HasColumnName(\"trade_name\").HasMaxLength(200);\n        builder.Property(tenant => tenant.LegalNature).HasColumnName(\"legal_nature\").HasMaxLength(100);\n        builder.Property(tenant => tenant.PrimaryCnae).HasColumnName(\"primary_cnae\").HasMaxLength(7);\n        builder.Property(tenant => tenant.Category)\n            .HasColumnName(\"category\")\n            .HasConversion(category => SerializeCategory(category), value => DeserializeCategory(value))\n            .HasMaxLength(32)\n            .IsRequired();\n        builder.Property(tenant => tenant.BusinessEmail)\n            .HasColumnName(\"business_email\")\n            .HasMaxLength(320)\n            .IsRequired();\n        builder.Property(tenant => tenant.BusinessPhone)\n            .HasColumnName(\"business_phone\")\n            .HasMaxLength(32)\n            .IsRequired();\n        builder.Property(tenant => tenant.CreatedAtUtc).HasColumnName(\"created_at_utc\").IsRequired();\n\n        builder.HasIndex(tenant => tenant.Cnpj)\n            .IsUnique()\n            .HasDatabaseName(\"ux_tenants_cnpj\");\n\n        builder.OwnsOne(tenant => tenant.Address, address =>\n        {\n            address.Property(value => value.Street).HasColumnName(\"address_street\").HasMaxLength(200).IsRequired();\n            address.Property(value => value.Number).HasColumnName(\"address_number\").HasMaxLength(30).IsRequired();\n            address.Property(value => value.District).HasColumnName(\"address_district\").HasMaxLength(100).IsRequired();\n            address.Property(value => value.City).HasColumnName(\"address_city\").HasMaxLength(100).IsRequired();\n            address.Property(value => value.State).HasColumnName(\"address_state\").HasMaxLength(2).IsRequired();\n            address.Property(value => value.PostalCode).HasColumnName(\"address_postal_code\").HasMaxLength(9).IsRequired();\n            address.Property(value => value.Complement).HasColumnName(\"address_complement\").HasMaxLength(200);\n        });\n        builder.Navigation(tenant => tenant.Address).IsRequired();\n    }\n\n    private static string SerializeCategory(BusinessCategory category) => category switch\n    {\n        BusinessCategory.Restaurant => \"restaurant\",\n        BusinessCategory.Supermarket => \"supermarket\",\n        BusinessCategory.GroceryStore => \"grocery_store\",\n        BusinessCategory.Bakery => \"bakery\",\n        _ => throw new ArgumentOutOfRangeException(nameof(category)),\n    };\n\n    private static BusinessCategory DeserializeCategory(string value) => value switch\n    {\n        \"restaurant\" => BusinessCategory.Restaurant,\n        \"supermarket\" => BusinessCategory.Supermarket,\n        \"grocery_store\" => BusinessCategory.GroceryStore,\n        \"bakery\" => BusinessCategory.Bakery,\n        _ => throw new InvalidOperationException($\"Categoria persistida inválida: {value}.\"),\n    };\n}\n\r\n","exit_code":0,"status":"completed"}}
