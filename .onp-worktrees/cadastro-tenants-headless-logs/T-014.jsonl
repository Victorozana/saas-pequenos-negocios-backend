{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"\"C:\\\\Program Files\\\\WindowsApps\\\\Microsoft.PowerShell_7.6.4.0_x64__8wekyb3d8bbwe\\\\pwsh.exe\" -Command \"Get-Content -Raw 'src/Agendamento.Api/Infrastructure/Persistence/Configurations/IdempotencyRecordConfiguration.cs'\"","aggregated_output":"using Agendamento.Domain.Identity;\nusing Microsoft.EntityFrameworkCore;\nusing Microsoft.EntityFrameworkCore.Metadata.Builders;\n\nnamespace Agendamento.Infrastructure.Persistence.Configurations;\n\npublic sealed class IdempotencyRecordConfiguration : IEntityTypeConfiguration<IdempotencyRecord>\n{\n    public void Configure(EntityTypeBuilder<IdempotencyRecord> builder)\n    {\n        builder.ToTable(\"idempotency_records\", table =>\n        {\n            table.HasCheckConstraint(\n                \"ck_idempotency_records_request_hash\",\n                \"request_hash ~ '^[0-9a-f]{64}$'\");\n            table.HasCheckConstraint(\n                \"ck_idempotency_records_state\",\n                \"state IN ('in_progress', 'completed')\");\n        });\n\n        builder.HasKey(record => record.Id).HasName(\"pk_idempotency_records\");\n        builder.Property(record => record.Id).HasColumnName(\"id\").ValueGeneratedNever();\n        builder.Property(record => record.UserId).HasColumnName(\"user_id\").IsRequired();\n        builder.Property(record => record.Key).HasColumnName(\"key\").HasMaxLength(255).IsRequired();\n        builder.Property(record => record.RequestHash)\n            .HasColumnName(\"request_hash\")\n            .HasMaxLength(64)\n            .IsFixedLength()\n            .IsRequired();\n        builder.Property(record => record.State)\n            .HasColumnName(\"state\")\n            .HasConversion(state => SerializeState(state), value => DeserializeState(value))\n            .HasMaxLength(32)\n            .IsRequired();\n        builder.Property(record => record.ResponseStatusCode).HasColumnName(\"response_status_code\");\n        builder.Property(record => record.ResponseBody).HasColumnName(\"response_body\").HasColumnType(\"jsonb\");\n        builder.Property(record => record.CreatedAtUtc).HasColumnName(\"created_at_utc\").IsRequired();\n        builder.Property(record => record.UpdatedAtUtc).HasColumnName(\"updated_at_utc\").IsRequired();\n\n        builder.HasIndex(record => new { record.UserId, record.Key })\n            .IsUnique()\n            .HasDatabaseName(\"ux_idempotency_records_user_id_key\");\n\n        builder.HasOne<User>()\n            .WithMany()\n            .HasForeignKey(record => record.UserId)\n            .HasConstraintName(\"fk_idempotency_records_users_user_id\")\n            .OnDelete(DeleteBehavior.Restrict);\n    }\n\n    private static string SerializeState(IdempotencyRecordState state) => state switch\n    {\n        IdempotencyRecordState.InProgress => \"in_progress\",\n        IdempotencyRecordState.Completed => \"completed\",\n        _ => throw new ArgumentOutOfRangeException(nameof(state)),\n    };\n\n    private static IdempotencyRecordState DeserializeState(string value) => value switch\n    {\n        \"in_progress\" => IdempotencyRecordState.InProgress,\n        \"completed\" => IdempotencyRecordState.Completed,\n        _ => throw new InvalidOperationException($\"Estado idempotente persistido inválido: {value}.\"),\n    };\n}\n\r\n","exit_code":0,"status":"completed"}}
