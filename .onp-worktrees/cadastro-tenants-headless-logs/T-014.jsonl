al_email\")\n            .HasMaxLength(320)\n            .IsRequired();\n\n        builder.HasOne<Tenant>()\n            .WithOne()\n            .HasForeignKey<TenantFiscalProfile>(profile => profile.TenantId)\n            .HasConstraintName(\"fk_tenant_fiscal_profiles_tenants_tenant_id\")\n            .OnDelete(DeleteBehavior.Cascade);\n    }\n\n    private static string SerializeTaxRegime(TaxRegime regime) => regime switch\n    {\n        TaxRegime.SimplesNacional => \"simples_nacional\",\n        TaxRegime.LucroPresumido => \"lucro_presumido\",\n        TaxRegime.LucroReal => \"lucro_real\",\n        _ => throw new ArgumentOutOfRangeException(nameof(regime)),\n    };\n\n    private static TaxRegime DeserializeTaxRegime(string value) => value switch\n    {\n        \"simples_nacional\" => TaxRegime.SimplesNacional,\n        \"lucro_presumido\" => TaxRegime.LucroPresumido,\n        \"lucro_real\" => TaxRegime.LucroReal,\n        _ => throw new InvalidOperationException($\"Regime tributário persistido inválido: {value}.\"),\n    };\n}\n\r\n","exit_code":0,"status":"completed"}}
