{"type":"item.completed","item":{"id":"item_55","type":"command_execution","command":"\"C:\\\\Program Files\\\\WindowsApps\\\\Microsoft.PowerShell_7.6.4.0_x64__8wekyb3d8bbwe\\\\pwsh.exe\" -Command 'git diff --cached --no-ext-diff -- tests/Agendamento.UnitTests/Tenants/RegisterTenantHandlerTests.cs'","aggregated_output":"diff --git a/tests/Agendamento.UnitTests/Tenants/RegisterTenantHandlerTests.cs b/tests/Agendamento.UnitTests/Tenants/RegisterTenantHandlerTests.cs\nnew file mode 100644\nindex 0000000..5eb6208\n--- /dev/null\n+++ b/tests/Agendamento.UnitTests/Tenants/RegisterTenantHandlerTests.cs\n@@ -0,0 +1,308 @@\n+using Agendamento.Application.Common;\n+using Agendamento.Application.Tenants.CompanyRegistry;\n+using Agendamento.Application.Tenants.RegisterTenant;\n+using Agendamento.Domain.Tenants;\n+using Xunit;\n+\n+namespace Agendamento.UnitTests.Tenants;\n+\n+public sealed class RegisterTenantHandlerTests\n+{\n+    [Fact(DisplayName = \"Cadastro exige usuário autenticado sem aceitar identidade no comando @spec:AC-021\")]\n+    public async Task HandleAsync_rejects_an_unauthenticated_caller_before_starting_work()\n+    {\n+        var unitOfWork = new FakeUnitOfWork();\n+        var gateway = new FakeCompanyRegistryGateway();\n+        var handler = new RegisterTenantHandler(\n+            new FakeCurrentUser(null),\n+            unitOfWork,\n+            gateway,\n+            new FoodCnaePolicy());\n+\n+        var result = await handler.HandleAsync(ValidCommand());\n+\n+        Assert.Equal(RegisterTenantStatus.Unauthenticated, result.Status);\n+        Assert.Equal(0, gateway.CallCount);\n+        Assert.Equal(0, unitOfWork.StartedTransactions);\n+    }\n+\n+    [Fact(DisplayName = \"Cadastro composto usa somente o usuário autenticado e cria owner_admin @spec:AC-021\")]\n+    public async Task HandleAsync_creates_registration_for_current_user_only()\n+    {\n+        var userId = Guid.NewGuid();\n+        var unitOfWork = new FakeUnitOfWork();\n+        var handler = CreateHandler(unitOfWork, userId);\n+\n+        var result = await handler.HandleAsync(ValidCommand());\n+\n+        Assert.Equal(RegisterTenantStatus.Created, result.Status);\n+        Assert.NotNull(result.TenantId);\n+        var tenant = Assert.Single(unitOfWork.Tenants);\n+        var fiscalProfile = Assert.Single(unitOfWork.FiscalProfiles);\n+        var membership = Assert.Single(unitOfWork.Memberships);\n+        Assert.Single(unitOfWork.IdempotencyRecords);\n+        Assert.Equal(tenant.Id, result.TenantId);\n+        Assert.Equal(tenant.Id, fiscalProfile.TenantId);\n+        Assert.Equal(tenant.Id, membership.TenantId);\n+        Assert.Equal(userId, membership.UserId);\n+        Assert.Equal(TenantRole.OwnerAdmin, membership.Role);\n+        Assert.True(membership.IsLegalRepresentative);\n+        Assert.DoesNotContain(\n+            typeof(RegisterTenantCommand).GetProperties(),\n+            property => property.Name is \"UserId\" or \"TenantId\");\n+    }\n+\n+    [Fact(DisplayName = \"CNPJ canônico duplicado retorna conflito sem criar outro tenant @spec:AC-022\")]\n+    public async Task HandleAsync_rejects_duplicate_canonical_cnpj()\n+    {\n+        var unitOfWork = new FakeUnitOfWork();\n+        var handler = CreateHandler(unitOfWork, Guid.NewGuid());\n+\n+        var first = await handler.HandleAsync(ValidCommand(cnpj: \"12.ABC.345/01DE-35\"));\n+        var duplicate = await handler.HandleAsync(\n+            ValidCommand(idempotencyKey: \"another-key\", cnpj: \"12abc34501de35\"));\n+\n+        Assert.Equal(RegisterTenantStatus.Created, first.Status);\n+        Assert.Equal(RegisterTenantStatus.Conflict, duplicate.Status);\n+        Assert.Single(unitOfWork.Tenants);\n+        Assert.Single(unitOfWork.FiscalProfiles);\n+        Assert.Single(unitOfWork.Memberships);\n+        Assert.Single(unitOfWork.IdempotencyRecords);\n+    }\n+\n+    [Fact(DisplayName = \"Idempotência reaproveita resultado e conteúdo diferente conflita sem duplicar @spec:AC-023\")]\n+    public async Task HandleAsync_replays_same_payload_and_rejects_a_different_payload_for_the_same_key()\n+    {\n+        var unitOfWork = new FakeUnitOfWork();\n+        var gateway = new FakeCompanyRegistryGateway();\n+        var handler = CreateHandler(unitOfWork, Guid.NewGuid(), gateway);\n+        var command = ValidCommand();\n+\n+        var original = await handler.HandleAsync(command);\n+        var replay = await handler.HandleAsync(command);\n+        var conflict = await handler.HandleAsync(command with { BusinessPhone = \"+55 11 98888-7777\" });\n+\n+        Assert.Equal(RegisterTenantStatus.Created, original.Status);\n+        Assert.Equal(original, replay);\n+        Assert.Equal(RegisterTenantStatus.Conflict, conflict.Status);\n+        Assert.Equal(1, gateway.CallCount);\n+        Assert.Single(unitOfWork.Tenants);\n+        Assert.Single(unitOfWork.FiscalProfiles);\n+        Assert.Single(unitOfWork.Memberships);\n+        Assert.Single(unitOfWork.IdempotencyRecords);\n+    }\n+\n+    [Fact(DisplayName = \"Falha parcial desfaz tenant, perfil, membership e idempotência @spec:AC-024\")]\n+    public async Task HandleAsync_rolls_back_every_component_when_persistence_fails()\n+    {\n+        var unitOfWork = new FakeUnitOfWork { ThrowOnSave = true };\n+        var handler = CreateHandler(unitOfWork, Guid.NewGuid());\n+\n+        await Assert.ThrowsAsync<InvalidOperationException>(() => handler.HandleAsync(ValidCommand()));\n+\n+        Assert.Empty(unitOfWork.Tenants);\n+        Assert.Empty(unitOfWork.FiscalProfiles);\n+        Assert.Empty(unitOfWork.Memberships);\n+        Assert.Empty(unitOfWork.IdempotencyRecords);\n+        Assert.Equal(1, unitOfWork.RolledBackTransactions);\n+    }\n+\n+    private static RegisterTenantHandler CreateHandler(\n+        FakeUnitOfWork unitOfWork,\n+        Guid userId,\n+        FakeCompanyRegistryGateway? gateway = null) =>\n+        new(\n+            new FakeCurrentUser(userId),\n+            unitOfWork,\n+            gateway ?? new FakeCompanyRegistryGateway(),\n+            new FoodCnaePolicy());\n+\n+    private static RegisterTenantCommand ValidCommand(\n+        string idempotencyKey = \"register-tenant-key\",\n+        string cnpj = \"04.252.011/0001-10\") =>\n+        new(\n+            idempotencyKey,\n+            cnpj,\n+            \"Restaurante Exemplo Ltda\",\n+            \"Restaurante Exemplo\",\n+            \"Sociedade Empresária Limitada\",\n+            \"5611201\",\n+            BusinessCategory.Restaurant,\n+            \"contato@exemplo.com\",\n+            \"+55 11 99999-9999\",\n+            new RegisterTenantAddress(\n+                \"Rua das Flores\",\n+                \"100\",\n+                \"Centro\",\n+                \"São Paulo\",\n+                \"SP\",\n+                \"01001-000\",\n+                null),\n+            new RegisterTenantFiscalProfile(\n+                TaxRegime.SimplesNacional,\n+                \"fiscal@exemplo.com\",\n+                \"123.456.789.000\",\n+                \"987654\",\n+                false),\n+            true,\n+            \"Sócia administradora\");\n+\n+    private sealed class FakeCurrentUser(Guid? userId) : ICurrentUser\n+    {\n+        public Guid? UserId { get; } = userId;\n+    }\n+\n+    private sealed class FakeCompanyRegistryGateway : ICompanyRegistryGateway\n+    {\n+        public int CallCount { get; private set; }\n+\n+        public Task<CompanyRegistryResult> LookupAsync(Cnpj cnpj, CancellationToken cancellationToken = default)\n+        {\n+            CallCount++;\n+            return Task.FromResult(new CompanyRegistryResult(\n+                \"Restaurante Exemplo Ltda\",\n+                \"Restaurante Exemplo\",\n+                \"Sociedade Empresária Limitada\",\n+                \"5611201\",\n+                [],\n+                \"ATIVA\",\n+                null));\n+        }\n+    }\n+\n+    private sealed class FakeUnitOfWork : IUnitOfWork\n+    {\n+        private readonly Dictionary<(Guid UserId, string Key), StoredIdempotencyRecord> _storedRecords = [];\n+\n+        public List<Tenant> Tenants { get; } = [];\n+\n+        public List<TenantFiscalProfile> FiscalProfiles { get; } = [];\n+\n+        public List<TenantMembership> Memberships { get; } = [];\n+\n+        public List<StoredIdempotencyRecord> IdempotencyRecords => [.. _storedRecords.Values];\n+\n+        public bool ThrowOnSave { get; init; }\n+\n+        public int StartedTransactions { get; private set; }\n+\n+        public int RolledBackTransactions { get; private set; }\n+\n+        public Task<IUnitOfWorkTransaction> BeginTransactionAsync(CancellationToken cancellationToken = default)\n+        {\n+            StartedTransactions++;\n+            return Task.FromResult<IUnitOfWorkTransaction>(new FakeTransaction(this));\n+        }\n+\n+        private sealed class FakeTransaction(FakeUnitOfWork owner) : IUnitOfWorkTransaction\n+        {\n+            private Tenant? _tenant;\n+            private TenantFiscalProfile? _fiscalProfile;\n+            private TenantMembership? _membership;\n+            private PendingIdempotencyRecord? _idempotencyRecord;\n+            private bool _committed;\n+\n+            public Task AcquireRegistrationLocksAsync(\n+                Guid userId,\n+                string idempotencyKey,\n+                string canonicalCnpj,\n+                CancellationToken cancellationToken = default) =>\n+                Task.CompletedTask;\n+\n+            public Task<StoredIdempotencyRecord?> FindIdempotencyRecordAsync(\n+                Guid userId,\n+                string key,\n+                CancellationToken cancellationToken = default)\n+            {\n+                owner._storedRecords.TryGetValue((userId, key.Trim()), out var record);\n+                return Task.FromResult(record);\n+            }\n+\n+            public Task<bool> TenantExistsByCnpjAsync(\n+                string canonicalCnpj,\n+                CancellationToken cancellationToken = default) =>\n+                Task.FromResult(owner.Tenants.Any(tenant => tenant.Cnpj == canonicalCnpj));\n+\n+            public void AddTenantRegistration(\n+                Tenant tenant,\n+                TenantFiscalProfile fiscalProfile,\n+                TenantMembership membership)\n+            {\n+                _tenant = tenant;\n+                _fiscalProfile = fiscalProfile;\n+                _membership = membership;\n+            }\n+\n+            public void AddIdempotencyRecord(\n+                Guid userId,\n+                string key,\n+                string requestHash,\n+                DateTimeOffset createdAtUtc) =>\n+                _idempotencyRecord = new PendingIdempotencyRecord(userId, key.Trim(), requestHash);\n+\n+            public void CompleteIdempotencyRecord(\n+                int responseStatusCode,\n+                string responseBody,\n+                DateTimeOffset completedAtUtc)\n+            {\n+                if (_idempotencyRecord is null)\n+                {\n+                    throw new InvalidOperationException(\"No idempotency record was started.\");\n+                }\n+\n+                _idempotencyRecord = _idempotencyRecord with\n+                {\n+                    ResponseStatusCode = responseStatusCode,\n+                    ResponseBody = responseBody,\n+                };\n+            }\n+\n+            public Task SaveChangesAsync(CancellationToken cancellationToken = default)\n+            {\n+                if (owner.ThrowOnSave)\n+                {\n+                    throw new InvalidOperationException(\"Simulated persistence failure.\");\n+                }\n+\n+                return Task.CompletedTask;\n+            }\n+\n+            public Task CommitAsync(CancellationToken cancellationToken = default)\n+            {\n+                if (_tenant is not null && _fiscalProfile is not null && _membership is not null && _idempotencyRecord is not null)\n+                {\n+                    owner.Tenants.Add(_tenant);\n+                    owner.FiscalProfiles.Add(_fiscalProfile);\n+                    owner.Memberships.Add(_membership);\n+                    owner._storedRecords.Add(\n+                        (_idempotencyRecord.UserId, _idempotencyRecord.Key),\n+                        new StoredIdempotencyRecord(\n+                            _idempotencyRecord.RequestHash,\n+                            true,\n+                            _idempotencyRecord.ResponseStatusCode,\n+                            _idempotencyRecord.ResponseBody));\n+                }\n+\n+                _committed = true;\n+                return Task.CompletedTask;\n+            }\n+\n+            public ValueTask DisposeAsync()\n+            {\n+                if (!_committed)\n+                {\n+                    owner.RolledBackTransactions++;\n+                }\n+\n+                return ValueTask.CompletedTask;\n+            }\n+        }\n+\n+        private sealed record PendingIdempotencyRecord(\n+            Guid UserId,\n+            string Key,\n+            string RequestHash,\n+            int? ResponseStatusCode = null,\n+            string? ResponseBody = null);\n+    }\n+}\n","exit_code":0,"status":"completed"}}
