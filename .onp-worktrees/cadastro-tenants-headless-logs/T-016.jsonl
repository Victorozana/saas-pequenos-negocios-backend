ionTests\\Infrastructure\\PostgreSqlCollection.cs\ntests/Agendamento.IntegrationTests\\Infrastructure\\PostgreSqlFixture.cs\ntests/Agendamento.IntegrationTests\\Health\\HealthEndpointTests.cs\nsrc/Agendamento.Api\\Application\\DependencyInjection.cs\nsrc/Agendamento.Api\\Infrastructure\\Identity\\JwtSessionIssuer.cs\nsrc/Agendamento.Api\\Infrastructure\\Identity\\JwtAuthenticationHandler.cs\nsrc/Agendamento.Api\\Infrastructure\\Identity\\HttpCurrentUser.cs\nsrc/Agendamento.Api\\Application\\Common\\ICurrentUser.cs\nsrc/Agendamento.Api\\Features\\Tenants\\TenantRegistrationEndpoints.cs\nsrc/Agendamento.Api\\Features\\Tenants\\CompanyRegistryEndpoints.cs\ntests/Agendamento.IntegrationTests\\Identity\\UserPersistenceTests.cs\ntests/Agendamento.IntegrationTests\\Identity\\SessionEndpointTests.cs\ntests/Agendamento.IntegrationTests\\Identity\\EmailVerificationOutboxTests.cs\ntests/Agendamento.IntegrationTests\\Identity\\EmailVerificationEndpointTests.cs\ntests/Agendamento.IntegrationTests\\Configuration\\DatabaseConfigurationTests.cs\nsrc/Agendamento.Api\\Application\\Identity\\CreateSession\\IIdentityAuthenticationStore.cs\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"\"C:\\\\Program Files\\\\WindowsApps\\\\Microsoft.PowerShell_7.6.4.0_x64__8wekyb3d8bbwe\\\\pwsh.exe\" -Command '$files=@('\"'src/Agendamento.Api/Program.cs','src/Agendamento.Api/Application/DependencyInjection.cs','src/Agendamento.Api/Infrastructure/DependencyInjection.cs','src/Agendamento.Api/Infrastructure/Identity/HttpCurrentUser.cs','src/Agendamento.Api/Infrastructure/Identity/JwtAuthenticationHandler.cs','src/Agendamento.Api/Infrastructure/Identity/JwtSessionIssuer.cs','src/Agendamento.Api/Application/Common/ICurrentUser.cs','src/Agendamento.Api/Infrastructure/Persistence/AgendamentoDbContext.cs','src/Agendamento.Api/Features/Tenants/TenantRegistrationEndpoints.cs','tests/Agendamento.IntegrationTests/Infrastructure/AgendamentoApiFactory.cs','tests/Agendamento.IntegrationTests/Infrastructure/PostgreSqlFixture.cs','tests/Agendamento.IntegrationTests/Tenants/TenantRegistrationEndpointTests.cs','src/Agendamento.Api/Domain/Tenants/Tenant.cs','src/Agendamento.Api/Domain/Tenants/TenantMembership.cs'); foreach(\"'$f in $files){ \"`n--- $f ---\"; Get-Content -Raw $f }'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"\"C:\\\\Program Files\\\\WindowsApps\\\\Microsoft.PowerShell_7.6.4.0_x64__8wekyb3d8bbwe\\\\pwsh.exe\" -Command '$files=@('\"'src/Agendamento.Api/Program.cs','src/Agendamento.Api/Application/DependencyInjection.cs','src/Agendamento.Api/Infrastructure/DependencyInjection.cs','src/Agendamento.Api/Infrastructure/Identity/HttpCurrentUser.cs','src/Agendamento.Api/Infrastructure/Identity/JwtAuthenticationHandler.cs','src/Agendamento.Api/Infrastructure/Identity/JwtSessionIssuer.cs','src/Agendamento.Api/Application/Common/ICurrentUser.cs','src/Agendamento.Api/Infrastructure/Persistence/AgendamentoDbContext.cs','src/Agendamento.Api/Features/Tenants/TenantRegistrationEndpoints.cs','tests/Agendamento.IntegrationTests/Infrastructure/AgendamentoApiFactory.cs','tests/Agendamento.IntegrationTests/Infrastructure/PostgreSqlFixture.cs','tests/Agendamento.IntegrationTests/Tenants/TenantRegistrationEndpointTests.cs','src/Agendamento.Api/Domain/Tenants/Tenant.cs','src/Agendamento.Api/Domain/Tenants/TenantMembership.cs'); foreach(\"'$f in $files){ \"`n--- $f ---\"; Get-Content -Raw $f }'","aggregated_output":"\n--- src/Agendamento.Api/Program.cs ---\r\nusing Agendamento.Application;\nusing Agendamento.Api.Features.Tenants;\nusing Agendamento.Api.Features.Identity;\nusing Agendamento.Infrastructure;\r\n\r\nvar builder = WebApplication.CreateBuilder(args);\r\n\r\nbuilder.Services\r\n    .AddApplication()\r\n    .AddInfrastructure(builder.Configuration);\r\n\r\nbuilder.Services.AddHealthChecks();\n\r\nvar app = builder.Build();\n\napp.UseAuthentication();\napp.UseAuthorization();\n\napp.MapHealthChecks(\"/health\");\napp.MapEmailVerificationEndpoints();\napp.MapSessionEndpoints();\napp.MapCompanyRegistryEndpoints();\napp.MapTenantRegistrationEndpoints();\napp.Run();\n\r\npublic partial class Program;\r\n\r\n\n--- src/Agendamento.Api/Application/DependencyInjection.cs ---\r\nusing Agendamento.Application.Identity.CreateSession;\nusing Agendamento.Application.Identity.VerifyEmail;\nusing Agendamento.Application.Tenants.CompanyRegistry;\nusing Agendamento.Application.Tenants.LookupCompany;\nusing Agendamento.Application.Tenants.RegisterTenant;\n\r\nnamespace Agendamento.Application;\r\n\r\npublic static class DependencyInjection\r\n{\r\n    public static IServiceCollection AddApplication(this IServiceCollection services)\r\n    {\r\n        services.AddTransient<VerifyEmailHandler>();\r\n        services.AddTransient<CreateSessionHandler>();\n        services.AddSingleton<FoodCnaePolicy>();\n        services.AddTransient<LookupCompanyHandler>();\n        services.AddTransient<RegisterTenantHandler>();\n        return services;\n    }\r\n}\r\n\r\n\n--- src/Agendamento.Api/Infrastructure/DependencyInjection.cs ---\r\nusing System.Security.Cryptography;\nusing System.Text;\nusing Agendamento.Application.Identity;\nusing Agendamento.Application.Identity.CreateSession;\nusing Agendamento.Application.Identity.VerifyEmail;\nusing Agendamento.Application.Common;\nusing Agendamento.Application.Tenants.CompanyRegistry;\nusing Agendamento.Application.Tenants.RegisterTenant;\nusing Agendamento.Infrastructure.CompanyRegistry;\nusing Agendamento.Infrastructure.Email;\nusing Agendamento.Infrastructure.Identity;\nusing Agendamento.Infrastructure.Persistence;\nusing Microsoft.EntityFrameworkCore;\n\r\nnamespace Agendamento.Infrastructure;\r\n\r\npublic static class DependencyInjection\r\n{\r\n    public static IServiceCollection AddInfrastructure(\r\n        this IServiceCollection services,\r\n        IConfiguration configuration)\r\n    {\r\n        services.AddSingleton<InMemoryIdentityStore>();\r\n        services.AddSingleton<IIdentityAuthenticationStore>(provider => provider.GetRequiredService<InMemoryIdentityStore>());\r\n        services.AddSingleton<IEmailVerificationTokenRepository>(provider => provider.GetRequiredService<InMemoryIdentityStore>());\r\n        services.AddSingleton<IEmailVerificationUserRepository>(provider => provider.GetRequiredService<InMemoryIdentityStore>());\r\n        services.AddSingleton<IEmailOutbox>(provider => provider.GetRequiredService<InMemoryIdentityStore>());\r\n        services.AddSingleton<IPasswordService, AspNetPasswordService>();\r\n        services.AddSingleton<IClock, SystemClock>();\r\n        services.AddSingleton<IEmailVerificationSender, OutboxEmailVerificationSender>();\r\n\r\n        var signingKey = configuration[\"Authentication:SigningKey\"];\r\n        if (string.IsNullOrWhiteSpace(signingKey))\r\n        {\r\n            signingKey = Convert.ToBase64String(RandomNumberGenerator.GetBytes(32));\r\n        }\r\n\r\n        services.AddSingleton<ISessionIssuer>(new JwtSessionIssuer(JwtSessionIssuerOptions.Create(signingKey)));\n        services.AddAuthentication(JwtAuthenticationHandler.SchemeName)\n            .AddScheme<JwtAuthenticationOptions, JwtAuthenticationHandler>(\n                JwtAuthenticationHandler.SchemeName,\n                options => options.SigningKey = signingKey);\n        services.AddAuthorization();\n        services.AddHttpContextAccessor();\n        services.AddScoped<ICurrentUser, HttpCurrentUser>();\n        services.AddSingleton<ICompanyRegistryGateway, UnavailableCompanyRegistryGateway>();\n        services.AddScoped<IUnitOfWork, UnavailableUnitOfWork>();\n\r\n        if (configuration.GetValue<bool>(\"Database:RequirePostgreSql\"))\r\n        {\r\n            var connectionString = configuration.GetConnectionString(\"PostgreSql\");\r\n\r\n            if (string.IsNullOrWhiteSpace(connectionString))\r\n            {\r\n                throw new InvalidOperationException(\r\n                    \"PostgreSQL configuration is required. Set ConnectionStrings__PostgreSql.\");\r\n            }\r\n\r\n            try\n            {\r\n                var connectionStringBuilder = new System.Data.Common.DbConnectionStringBuilder\r\n                {\r\n                    ConnectionString = connectionString,\r\n                };\r\n\r\n                if (!connectionStringBuilder.TryGetValue(\"Host\", out var host) ||\r\n                    string.IsNullOrWhiteSpace(host?.ToString()))\r\n                {\r\n                    throw new ArgumentException(\"The PostgreSQL connection string must contain a Host.\");\r\n                }\r\n            }\r\n            catch (ArgumentException exception)\r\n            {\r\n                throw new InvalidOperationException(\r\n                    \"PostgreSQL configuration is invalid. Check ConnectionStrings__PostgreSql.\",\r\n                    exception);\r\n            }\n\n            services.AddDbContext<AgendamentoDbContext>(options => options.UseNpgsql(connectionString));\n            services.AddScoped<IUnitOfWork, UnitOfWork>();\n        }\n\r\n        return services;\r\n    }\r\n}\r\n\r\n\n--- src/Agendamento.Api/Infrastructure/Identity/HttpCurrentUser.cs ---\r\nusing Agendamento.Application.Common;\n\nnamespace Agendamento.Infrastructure.Identity;\n\npublic sealed class HttpCurrentUser(IHttpContextAccessor httpContextAccessor) : ICurrentUser\n{\n    public Guid? UserId\n    {\n        get\n        {\n            var subject = httpContextAccessor.HttpContext?.User.FindFirst(\"sub\")?.Value;\n\n            return Guid.TryParse(subject, out var userId) ? userId : null;\n        }\n    }\n}\n\r\n\n--- src/Agendamento.Api/Infrastructure/Identity/JwtAuthenticationHandler.cs ---\r\nusing System.Security.Claims;\nusing System.Security.Cryptography;\nusing System.Text;\nusing System.Text.Json;\nusing Microsoft.AspNetCore.Authentication;\nusing Microsoft.Extensions.Options;\n\nnamespace Agendamento.Infrastructure.Identity;\n\npublic sealed class JwtAuthenticationOptions : AuthenticationSchemeOptions\n{\n    public string SigningKey { get; set; } = string.Empty;\n}\n\npublic sealed class JwtAuthenticationHandler(\n    IOptionsMonitor<JwtAuthenticationOptions> options,\n    ILoggerFactory logger,\n    System.Text.Encodings.Web.UrlEncoder encoder)\n    : AuthenticationHandler<JwtAuthenticationOptions>(options, logger, encoder)\n{\n    public const string SchemeName = \"Bearer\";\n\n    protected override Task<AuthenticateResult> HandleAuthenticateAsync()\n    {\n        var authorization = Request.Headers.Authorization.ToString();\n        if (!authorization.StartsWith(\"Bearer \", StringComparison.OrdinalIgnoreCase))\n        {\n            return Task.FromResult(AuthenticateResult.NoResult());\n        }\n\n        var token = authorization[\"Bearer \".Length..].Trim();\n        if (!TryReadSubject(token, Options.SigningKey, out var subject))\n        {\n            return Task.FromResult(AuthenticateResult.Fail(\"Token de acesso inválido.\"));\n        }\n\n        var identity = new ClaimsIdentity([new Claim(\"sub\", subject)], SchemeName);\n        return Task.FromResult(AuthenticateResult.Success(\n            new AuthenticationTicket(new ClaimsPrincipal(identity), SchemeName)));\n    }\n\n    private static bool TryReadSubject(string token, string signingKey, out string subject)\n    {\n        subject = string.Empty;\n        try\n        {\n            var segments = token.Split('.');\n            if (segments.Length != 3 || string.IsNullOrWhiteSpace(signingKey)) return false;\n\n            using var header = JsonDocument.Parse(DecodeBase64Url(segments[0]));\n            if (!header.RootElement.TryGetProperty(\"alg\", out var algorithm) ||\n                algorithm.GetString() != \"HS256\")\n            {\n                return false;\n            }\n\n            var unsignedToken = $\"{segments[0]}.{segments[1]}\";\n            using var hmac = new HMACSHA256(Encoding.UTF8.GetBytes(signingKey));\n            if (!CryptographicOperations.FixedTimeEquals(\n                    hmac.ComputeHash(Encoding.UTF8.GetBytes(unsignedToken)),\n                    DecodeBase64Url(segments[2]))) return false;\n\n            using var payload = JsonDocument.Parse(DecodeBase64Url(segments[1]));\n            if (!payload.RootElement.TryGetProperty(\"sub\", out var sub) ||\n                sub.ValueKind != JsonValueKind.String ||\n                !payload.RootElement.TryGetProperty(\"exp\", out var exp) ||\n                !exp.TryGetInt64(out var expiresAt) ||\n                DateTimeOffset.UtcNow.ToUnixTimeSeconds() >= expiresAt)\n            {\n                return false;\n            }\n\n            subject = sub.GetString()!;\n            return true;\n        }\n        catch (JsonException)\n        {\n            return false;\n        }\n        catch (FormatException)\n        {\n            return false;\n        }\n    }\n\n    private static byte[] DecodeBase64Url(string value)\n    {\n        var base64 = value.Replace('-', '+').Replace('_', '/');\n        return Convert.FromBase64String(base64.PadRight(base64.Length + ((4 - base64.Length % 4) % 4), '='));\n    }\n}\n\r\n\n--- src/Agendamento.Api/Infrastructure/Identity/JwtSessionIssuer.cs ---\r\nusing System.Security.Cryptography;\r\nusing System.Text;\r\nusing System.Text.Json;\r\nusing Agendamento.Application.Identity;\r\nusing Agendamento.Application.Identity.CreateSession;\r\n\r\nnamespace Agendamento.Infrastructure.Identity;\r\n\r\n/// <summary>Issues a short-lived, HS256 signed bearer token with only the session context claims.</summary>\r\npublic sealed class JwtSessionIssuer(JwtSessionIssuerOptions options) : ISessionIssuer\r\n{\r\n    public IssuedSession Issue(SessionPrincipal principal)\r\n    {\r\n        var now = DateTimeOffset.UtcNow;\r\n        var expiresAt = now.Add(options.Lifetime);\r\n        var header = Base64Url(JsonSerializer.SerializeToUtf8Bytes(new { alg = \"HS256\", typ = \"JWT\" }));\r\n        var payload = Base64Url(JsonSerializer.SerializeToUtf8Bytes(new\r\n        {\r\n            sub = principal.UserId,\r\n            tenant_id = principal.TenantId,\r\n            role = principal.Role,\r\n            iat = now.ToUnixTimeSeconds(),\r\n            exp = expiresAt.ToUnixTimeSeconds(),\r\n        }));\r\n        var unsignedToken = $\"{header}.{payload}\";\r\n        var signature = Sign(unsignedToken, options.SigningKey);\r\n\r\n        return new IssuedSession($\"{unsignedToken}.{signature}\", expiresAt);\r\n    }\r\n\r\n    private static string Sign(string content, string signingKey)\r\n    {\r\n        using var hmac = new HMACSHA256(Encoding.UTF8.GetBytes(signingKey));\r\n        return Base64Url(hmac.ComputeHash(Encoding.UTF8.GetBytes(content)));\r\n    }\r\n\r\n    private static string Base64Url(byte[] value) => Convert.ToBase64String(value)\r\n        .TrimEnd('=')\r\n        .Replace('+', '-')\r\n        .Replace('/', '_');\r\n}\r\n\r\npublic sealed record JwtSessionIssuerOptions(string SigningKey, TimeSpan Lifetime)\r\n{\r\n    public static JwtSessionIssuerOptions Create(string signingKey) => new(signingKey, TimeSpan.FromMinutes(15));\r\n}\r\n\r\n\n--- src/Agendamento.Api/Application/Common/ICurrentUser.cs ---\r\nnamespace Agendamento.Application.Common;\n\npublic interface ICurrentUser\n{\n    Guid? UserId { get; }\n}\n\r\n\n--- src/Agendamento.Api/Infrastructure/Persistence/AgendamentoDbContext.cs ---\r\nusing Agendamento.Domain.Identity;\nusing Agendamento.Domain.Tenants;\nusing Microsoft.EntityFrameworkCore;\nusing Microsoft.EntityFrameworkCore.Design;\n\nnamespace Agendamento.Infrastructure.Persistence;\n\npublic sealed class AgendamentoDbContext(DbContextOptions<AgendamentoDbContext> options) : DbContext(options)\n{\n    public DbSet<Tenant> Tenants => Set<Tenant>();\n\n    public DbSet<TenantFiscalProfile> TenantFiscalProfiles => Set<TenantFiscalProfile>();\n\n    public DbSet<TenantMembership> TenantMemberships => Set<TenantMembership>();\n\n    public DbSet<IdempotencyRecord> IdempotencyRecords => Set<IdempotencyRecord>();\n\n    protected override void OnModelCreating(ModelBuilder modelBuilder)\n    {\n        base.OnModelCreating(modelBuilder);\n        modelBuilder.ApplyConfigurationsFromAssembly(typeof(AgendamentoDbContext).Assembly);\n        ConfigureExistingUsers(modelBuilder);\n    }\n\n    private static void ConfigureExistingUsers(ModelBuilder modelBuilder)\n    {\n        var users = modelBuilder.Entity<User>();\n        users.ToTable(\"Users\", table => table.ExcludeFromMigrations());\n        users.HasKey(user => user.Id);\n        users.Property(user => user.Id).HasColumnName(\"Id\").ValueGeneratedNever();\n        users.Property(user => user.Cpf).HasColumnName(\"Cpf\").HasMaxLength(11).IsRequired();\n        users.Property(user => user.Email).HasColumnName(\"Email\").HasMaxLength(320).IsRequired();\n        users.Property(user => user.PasswordHash).HasColumnName(\"PasswordHash\").IsRequired();\n        users.Property(user => user.Status).HasColumnName(\"Status\").IsRequired();\n        users.Property(user => user.CreatedAtUtc).HasColumnName(\"CreatedAtUtc\").IsRequired();\n        users.Property(user => user.EmailVerifiedAtUtc).HasColumnName(\"EmailVerifiedAtUtc\");\n    }\n}\n\ninternal sealed class AgendamentoDbContextFactory : IDesignTimeDbContextFactory<AgendamentoDbContext>\n{\n    public AgendamentoDbContext CreateDbContext(string[] args)\n    {\n        var options = new DbContextOptionsBuilder<AgendamentoDbContext>()\n            .UseNpgsql(\"Host=localhost;Database=agendamento\")\n            .Options;\n\n        return new AgendamentoDbContext(options);\n    }\n}\n\r\n\n--- src/Agendamento.Api/Features/Tenants/TenantRegistrationEndpoints.cs ---\r\nusing Agendamento.Api.Features.Common;\nusing Agendamento.Application.Tenants.RegisterTenant;\nusing Agendamento.Domain.Tenants;\n\nnamespace Agendamento.Api.Features.Tenants;\n\npublic static class TenantRegistrationEndpoints\n{\n    public static IEndpointRouteBuilder MapTenantRegistrationEndpoints(this IEndpointRouteBuilder endpoints)\n    {\n        endpoints.MapPost(\"/api/v1/tenants\", RegisterAsync)\n            .RequireAuthorization();\n        return endpoints;\n    }\n\n    private static async Task<IResult> RegisterAsync(\n        RegisterTenantRequest request,\n        HttpRequest httpRequest,\n        RegisterTenantHandler handler,\n        CancellationToken cancellationToken)\n    {\n        var idempotencyKey = httpRequest.Headers[\"Idempotency-Key\"].ToString();\n        var errors = Validate(request, idempotencyKey);\n        if (errors.Count > 0)\n        {\n            return ProblemDetailsExtensions.ValidationProblem(errors);\n        }\n\n        var command = new RegisterTenantCommand(\n            idempotencyKey, request.Cnpj!, request.LegalName!, request.TradeName,\n            request.LegalNature, request.PrimaryCnae, Enum.Parse<BusinessCategory>(request.Category!, true),\n            request.BusinessEmail!, request.BusinessPhone!,\n            new RegisterTenantAddress(request.Address!.Street!, request.Address.Number!, request.Address.District!,\n                request.Address.City!, request.Address.State!, request.Address.PostalCode!, request.Address.Complement),\n            new RegisterTenantFiscalProfile(Enum.Parse<TaxRegime>(request.FiscalProfile!.TaxRegime!, true),\n                request.FiscalProfile.FiscalEmail!, request.FiscalProfile.StateRegistration,\n                request.FiscalProfile.MunicipalRegistration, request.FiscalProfile.IsStateRegistrationExempt!.Value),\n            request.IsLegalRepresentative!.Value, request.Position!);\n        var result = await handler.HandleAsync(command, cancellationToken);\n\n        return result.Status switch\n        {\n            RegisterTenantStatus.Created => Results.Created($\"/api/v1/tenants/{result.TenantId}\", new RegisterTenantResponse(result.TenantId!.Value)),\n            RegisterTenantStatus.Unauthenticated => ProblemDetailsExtensions.Problem(401, \"Autenticação obrigatória.\"),\n            RegisterTenantStatus.InvalidCnpj => ProblemDetailsExtensions.Problem(400, \"CNPJ inválido.\"),\n            RegisterTenantStatus.CompanyInactive => ProblemDetailsExtensions.Problem(422, \"A empresa não está ativa.\"),\n            RegisterTenantStatus.IneligibleCnae => ProblemDetailsExtensions.Problem(422, \"A atividade da empresa não é elegível.\"),\n            RegisterTenantStatus.DependencyUnavailable => ProblemDetailsExtensions.Problem(503, \"A consulta cadastral está indisponível.\"),\n            RegisterTenantStatus.Conflict => ProblemDetailsExtensions.Problem(409, \"O cadastro do tenant conflita com um registro existente.\"),\n            _ => throw new InvalidOperationException(\"Resultado de cadastro de tenant desconhecido.\"),\n        };\n    }\n\n    private static Dictionary<string, string[]> Validate(RegisterTenantRequest request, string? idempotencyKey)\n    {\n        var errors = new Dictionary<string, string[]>(StringComparer.Ordinal);\n        AddRequired(errors, \"idempotencyKey\", idempotencyKey);\n        AddRequired(errors, \"cnpj\", request.Cnpj);\n        AddRequired(errors, \"legalName\", request.LegalName);\n        AddRequired(errors, \"category\", request.Category);\n        AddRequired(errors, \"businessEmail\", request.BusinessEmail);\n        AddRequired(errors, \"businessPhone\", request.BusinessPhone);\n        AddRequired(errors, \"position\", request.Position);\n        if (!Enum.TryParse<BusinessCategory>(request.Category, true, out _)) Add(errors, \"category\", \"Categoria inválida.\");\n        if (request.Address is null) Add(errors, \"address\", \"O endereço é obrigatório.\");\n        else { AddRequired(errors, \"address.street\", request.Address.Street); AddRequired(errors, \"address.number\", request.Address.Number); AddRequired(errors, \"address.district\", request.Address.District); AddRequired(errors, \"address.city\", request.Address.City); AddRequired(errors, \"address.state\", request.Address.State); AddRequired(errors, \"address.postalCode\", request.Address.PostalCode); }\n        if (request.FiscalProfile is null) Add(errors, \"fiscalProfile\", \"O perfil fiscal é obrigatório.\");\n        else { AddRequired(errors, \"fiscalProfile.taxRegime\", request.FiscalProfile.TaxRegime); AddRequired(errors, \"fiscalProfile.fiscalEmail\", request.FiscalProfile.FiscalEmail); if (!Enum.TryParse<TaxRegime>(request.FiscalProfile.TaxRegime, true, out _)) Add(errors, \"fiscalProfile.taxRegime\", \"Regime tributário inválido.\"); if (request.FiscalProfile.IsStateRegistrationExempt is null) Add(errors, \"fiscalProfile.isStateRegistrationExempt\", \"Informe a isenção de inscrição estadual.\"); }\n        if (request.IsLegalRepresentative is null) Add(errors, \"isLegalRepresentative\", \"Informe a responsabilidade legal.\");\n        return errors;\n    }\n\n    private static void AddRequired(Dictionary<string, string[]> errors, string key, string? value)\n    {\n        if (string.IsNullOrWhiteSpace(value)) Add(errors, key, \"O campo é obrigatório.\");\n    }\n\n    private static void Add(Dictionary<string, string[]> errors, string key, string error) =>\n        errors[key] = errors.TryGetValue(key, out var values) ? [.. values, error] : [error];\n}\n\r\n\n--- tests/Agendamento.IntegrationTests/Infrastructure/AgendamentoApiFactory.cs ---\r\nusing Microsoft.AspNetCore.Mvc.Testing;\r\n\r\nnamespace Agendamento.IntegrationTests.Infrastructure;\r\n\r\npublic sealed class AgendamentoApiFactory : WebApplicationFactory<Program>;\r\n\r\n\n--- tests/Agendamento.IntegrationTests/Infrastructure/PostgreSqlFixture.cs ---\r\nusing DotNet.Testcontainers.Containers;\r\nusing Testcontainers.PostgreSql;\r\nusing Xunit;\r\n\r\nnamespace Agendamento.IntegrationTests.Infrastructure;\r\n\r\npublic sealed class PostgreSqlFixture : IAsyncLifetime\r\n{\r\n    private const string FixtureMigration = \"\"\"\r\n        CREATE TABLE IF NOT EXISTS \"__FixtureMigrations\" (\r\n            \"MigrationId\" text PRIMARY KEY,\r\n            \"AppliedAtUtc\" timestamptz NOT NULL DEFAULT CURRENT_TIMESTAMP\r\n        );\r\n\r\n        CREATE TABLE IF NOT EXISTS \"FixtureIsolationProbe\" (\r\n            \"Value\" text PRIMARY KEY\r\n        );\r\n\r\n        INSERT INTO \"__FixtureMigrations\" (\"MigrationId\")\r\n        VALUES ('0001_fixture_infrastructure')\r\n        ON CONFLICT (\"MigrationId\") DO NOTHING;\r\n        \"\"\";\r\n\r\n    private readonly PostgreSqlContainer _container;\r\n\r\n    public PostgreSqlFixture()\r\n    {\r\n        DatabaseName = $\"agendamento_tests_{Guid.NewGuid():N}\";\r\n        _container = new PostgreSqlBuilder()\r\n            .WithImage(\"postgres:16-alpine\")\r\n            .WithDatabase(DatabaseName)\r\n            .WithUsername(\"postgres\")\r\n            .WithPassword($\"test_{Guid.NewGuid():N}\")\r\n            .Build();\r\n    }\r\n\r\n    public string DatabaseName { get; }\r\n\r\n    public string ConnectionString => _container.GetConnectionString();\r\n\r\n    public async Task InitializeAsync()\r\n    {\r\n        try\r\n        {\r\n            await _container.StartAsync();\r\n            await ExecuteScriptAsync(FixtureMigration);\r\n        }\r\n        catch\r\n        {\r\n            await _container.DisposeAsync();\r\n            throw;\r\n        }\r\n    }\r\n\r\n    public Task<ExecResult> ExecuteScriptAsync(string script) =>\r\n        _container.ExecScriptAsync(script).ThrowOnFailure();\r\n\r\n    public async Task DisposeAsync() => await _container.DisposeAsync();\r\n}\r\n\r\n\n--- tests/Agendamento.IntegrationTests/Tenants/TenantRegistrationEndpointTests.cs ---\r\nusing System.Net;\nusing System.Net.Http.Json;\nusing System.Reflection;\nusing Agendamento.Api.Features.Tenants;\nusing Agendamento.Application.Common;\nusing Agendamento.Application.Tenants.CompanyRegistry;\nusing Agendamento.Domain.Identity;\nusing Agendamento.Infrastructure.Persistence;\nusing Agendamento.Infrastructure.Persistence.Configurations;\nusing Agendamento.IntegrationTests.Infrastructure;\nusing Microsoft.AspNetCore.Hosting;\nusing Microsoft.AspNetCore.TestHost;\nusing Microsoft.EntityFrameworkCore;\nusing Microsoft.Extensions.Configuration;\nusing Microsoft.Extensions.DependencyInjection;\nusing Microsoft.Extensions.Options;\nusing Xunit;\n\nnamespace Agendamento.IntegrationTests.Tenants;\n\n[Collection(PostgreSqlCollection.Name)]\npublic sealed class TenantRegistrationEndpointTests(PostgreSqlFixture fixture)\n{\n    [Fact(DisplayName = \"@spec:AC-018 endpoint valida dados obrigatórios antes de chamar o handler\")]\n    public async Task Invalid_registration_returns_validation_problem_without_calling_the_gateway()\n    {\n        var gateway = new CompanyRegistryEndpointTests.FakeGateway(CompanyRegistryEndpointTests.ActiveCompany());\n        using var client = CreateClient(gateway, Guid.NewGuid());\n\n        var response = await client.PostAsJsonAsync(\"/api/v1/tenants\", new { cnpj = \"04.252.011/0001-10\" });\n        var body = await response.Content.ReadAsStringAsync();\n\n        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);\n        Assert.Equal(\"application/problem+json\", response.Content.Headers.ContentType!.MediaType);\n        Assert.Contains(\"legalName\", body, StringComparison.Ordinal);\n        Assert.Equal(0, gateway.CallCount);\n    }\n\n    [Fact(DisplayName = \"@spec:AC-020 contrato público não expõe identidade nem itens financeiros, documentos, KYC, agenda ou catálogo\")]\n    public void Public_registration_contract_excludes_out_of_scope_fields()\n    {\n        var names = typeof(RegisterTenantRequest).GetProperties(BindingFlags.Instance | BindingFlags.Public)\n            .Select(property => property.Name).ToArray();\n        var prohibited = new[] { \"UserId\", \"TenantId\", \"BankAccount\", \"FiscalCertificate\", \"Rg\", \"Cnh\", \"SocialContract\", \"Permit\", \"KycFiles\", \"Schedule\", \"Catalog\" };\n\n        Assert.DoesNotContain(names, name => prohibited.Any(value => name.Contains(value, StringComparison.OrdinalIgnoreCase)));\n        Assert.DoesNotContain(typeof(RegisterTenantResponse).GetProperties(), property => property.Name.Equals(\"UserId\", StringComparison.OrdinalIgnoreCase));\n    }\n\n    [Fact(DisplayName = \"@spec:AC-021 @spec:AC-023 endpoint cria cadastro composto e reaproveita a mesma resposta idempotente\")]\n    public async Task Registration_persists_current_user_once_and_replays_the_created_response()\n    {\n        await EnsureMigrationAsync();\n        var user = await CreateUserAsync();\n        var gateway = new CompanyRegistryEndpointTests.FakeGateway(CompanyRegistryEndpointTests.ActiveCompany());\n        var key = $\"tenant-{Guid.NewGuid():N}\";\n        using var client = CreateClient(gateway, user.Id);\n        var request = ValidRequest();\n        client.DefaultRequestHeaders.Add(\"Idempotency-Key\", key);\n\n        try\n        {\n            var first = await client.PostAsJsonAsync(\"/api/v1/tenants\", request);\n            var replay = await client.PostAsJsonAsync(\"/api/v1/tenants\", request);\n            var firstBody = await first.Content.ReadFromJsonAsync<RegisterTenantResponse>();\n            var replayBody = await replay.Content.ReadFromJsonAsync<RegisterTenantResponse>();\n\n            Assert.Equal(HttpStatusCode.Created, first.StatusCode);\n            Assert.Equal(HttpStatusCode.Created, replay.StatusCode);\n            Assert.Equal(firstBody, replayBody);\n            Assert.Equal(1, gateway.CallCount);\n            await using var context = CreateDbContext();\n            Assert.Equal(1, await context.Tenants.CountAsync(value => value.Id == firstBody!.TenantId));\n            Assert.Equal(1, await context.TenantFiscalProfiles.CountAsync(value => value.TenantId == firstBody!.TenantId));\n            Assert.Equal(1, await context.TenantMemberships.CountAsync(value => value.TenantId == firstBody!.TenantId && value.UserId == user.Id));\n            Assert.Equal(1, await context.IdempotencyRecords.CountAsync(value => value.UserId == user.Id && value.Key == key));\n        }\n        finally\n        {\n            await DeleteRegistrationAsync(user.Id);\n            await DeleteUserAsync(user.Id);\n        }\n    }\n\n    [Fact(DisplayName = \"Cadastro de tenant autenticado retorna 401 sem bearer token\")]\n    public async Task Registration_requires_authentication()\n    {\n        using var client = CreateClient(new CompanyRegistryEndpointTests.FakeGateway(CompanyRegistryEndpointTests.ActiveCompany()), Guid.NewGuid(), authenticate: false);\n        client.DefaultRequestHeaders.Add(\"Idempotency-Key\", \"missing-token\");\n        Assert.Equal(HttpStatusCode.Unauthorized, (await client.PostAsJsonAsync(\"/api/v1/tenants\", ValidRequest())).StatusCode);\n    }\n\n    private HttpClient CreateClient(ICompanyRegistryGateway gateway, Guid? userId = null, bool authenticate = true)\n    {\n        var factory = new AgendamentoApiFactory().WithWebHostBuilder(builder =>\n        {\n            builder.ConfigureAppConfiguration(configuration => configuration.AddInMemoryCollection(new Dictionary<string, string?>\n            {\n                [\"Authentication:SigningKey\"] = TenantEndpointTestSupport.SigningKey,\n                [\"Database:RequirePostgreSql\"] = \"false\",\n            }));\n            builder.ConfigureTestServices(services =>\n            {\n                services.AddSingleton<ICompanyRegistryGateway>(gateway);\n                services.AddDbContext<AgendamentoDbContext>(options => options.UseNpgsql(fixture.ConnectionString));\n                services.AddScoped<IUnitOfWork, UnitOfWork>();\n                services.AddTransient<Agendamento.Application.Tenants.RegisterTenant.RegisterTenantHandler>();\n                services.PostConfigure<Agendamento.Infrastructure.Identity.JwtAuthenticationOptions>(options => options.SigningKey = TenantEndpointTestSupport.SigningKey);\n            });\n        });\n        var client = factory.CreateClient();\n        return client.WithAuthentication(authenticate && userId is not null ? userId.Value : null, factory.Services\n            .GetRequiredService<IOptionsMonitor<Agendamento.Infrastructure.Identity.JwtAuthenticationOptions>>()\n            .Get(Agendamento.Infrastructure.Identity.JwtAuthenticationHandler.SchemeName).SigningKey);\n    }\n\n    private AgendamentoDbContext CreateDbContext() => new(new DbContextOptionsBuilder<AgendamentoDbContext>().UseNpgsql(fixture.ConnectionString).Options);\n\n    private async Task EnsureMigrationAsync()\n    {\n        await fixture.ExecuteScriptAsync(UserConfiguration.CreateTableSql);\n        await using var context = CreateDbContext();\n        await context.Database.MigrateAsync();\n    }\n\n    private async Task<User> CreateUserAsync()\n    {\n        var user = User.Create(string.Concat(Enumerable.Range(0, 11).Select(_ => Random.Shared.Next(10))), $\"endpoint-{Guid.NewGuid():N}@example.com\", \"hash\");\n        await using var context = CreateDbContext();\n        await context.Database.ExecuteSqlInterpolatedAsync($\"\"\"INSERT INTO \"Users\" (\"Id\", \"Cpf\", \"Email\", \"PasswordHash\", \"Status\", \"CreatedAtUtc\") VALUES ({user.Id}, {user.Cpf}, {user.Email}, {user.PasswordHash}, {(int)user.Status}, {user.CreatedAtUtc});\"\"\");\n        return user;\n    }\n\n    private async Task DeleteRegistrationAsync(Guid userId)\n    {\n        await using var context = CreateDbContext();\n        await context.IdempotencyRecords.Where(value => value.UserId == userId).ExecuteDeleteAsync();\n        var tenantIds = context.TenantMemberships.Where(value => value.UserId == userId).Select(value => value.TenantId);\n        await context.Tenants.Where(value => tenantIds.Contains(value.Id)).ExecuteDeleteAsync();\n    }\n\n    private async Task DeleteUserAsync(Guid userId)\n    {\n        await using var context = CreateDbContext();\n        await context.Database.ExecuteSqlInterpolatedAsync($\"DELETE FROM \\\"Users\\\" WHERE \\\"Id\\\" = {userId};\");\n    }\n\n    private static object ValidRequest() => new\n    {\n        cnpj = \"04.252.011/0001-10\", legalName = \"Restaurante Exemplo Ltda\", tradeName = \"Restaurante Exemplo\", legalNature = \"Sociedade Empresária Limitada\", primaryCnae = \"5611201\", category = \"Restaurant\", businessEmail = \"contato@exemplo.com\", businessPhone = \"+55 11 99999-9999\",\n        address = new { street = \"Rua das Flores\", number = \"100\", district = \"Centro\", city = \"São Paulo\", state = \"SP\", postalCode = \"01001-000\" },\n        fiscalProfile = new { taxRegime = \"SimplesNacional\", fiscalEmail = \"fiscal@exemplo.com\", stateRegistration = \"123\", municipalRegistration = \"456\", isStateRegistrationExempt = false },\n        isLegalRepresentative = true, position = \"Sócia administradora\",\n    };\n}\n\ninternal static class TenantRegistrationAuthentication\n{\n    internal static HttpClient WithAuthentication(this HttpClient client, Guid? userId, string signingKey)\n    {\n        if (userId is { } value)\n        {\n            var token = new Agendamento.Infrastructure.Identity.JwtSessionIssuer(Agendamento.Infrastructure.Identity.JwtSessionIssuerOptions.Create(signingKey)).Issue(new Agendamento.Application.Identity.CreateSession.SessionPrincipal(value, Guid.Empty, \"administrator\"));\n            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue(\"Bearer\", token.AccessToken);\n        }\n        return client;\n    }\n}\n\r\n\n--- src/Agendamento.Api/Domain/Tenants/Tenant.cs ---\r\nnamespace Agendamento.Domain.Tenants;\r\n\r\npublic sealed class Tenant\n{\n    private Tenant()\n    {\n    }\n\n    private Tenant(\r\n        Guid id,\r\n        string cnpj,\r\n        string legalName,\r\n        string? tradeName,\r\n        string? legalNature,\r\n        string? primaryCnae,\r\n        BusinessCategory category,\r\n        string businessEmail,\r\n        string businessPhone,\r\n        TenantAddress address,\r\n        DateTimeOffset createdAtUtc)\r\n    {\r\n        Id = id;\r\n        Cnpj = cnpj;\r\n        LegalName = legalName;\r\n        TradeName = tradeName;\r\n        LegalNature = legalNature;\r\n        PrimaryCnae = primaryCnae;\r\n        Category = category;\r\n        BusinessEmail = businessEmail;\r\n        BusinessPhone = businessPhone;\r\n        Address = address;\r\n        CreatedAtUtc = createdAtUtc;\r\n    }\r\n\r\n    public Guid Id { get; private set; }\n\n    public string Cnpj { get; private set; } = null!;\n\n    public string LegalName { get; private set; } = null!;\n\n    public string? TradeName { get; private set; }\n\n    public string? LegalNature { get; private set; }\n\n    public string? PrimaryCnae { get; private set; }\n\n    public BusinessCategory Category { get; private set; }\n\n    public string BusinessEmail { get; private set; } = null!;\n\n    public string BusinessPhone { get; private set; } = null!;\n\n    public TenantAddress Address { get; private set; } = null!;\n\n    public DateTimeOffset CreatedAtUtc { get; private set; }\n\r\n    public static Tenant Create(\r\n        string cnpj,\r\n        string legalName,\r\n        BusinessCategory category,\r\n        string businessEmail,\r\n        string businessPhone,\r\n        TenantAddress address,\r\n        string? tradeName = null,\r\n        string? legalNature = null,\r\n        string? primaryCnae = null)\r\n    {\r\n        ArgumentNullException.ThrowIfNull(address);\r\n        if (!Enum.IsDefined(category))\r\n        {\r\n            throw new ArgumentOutOfRangeException(nameof(category));\r\n        }\r\n\r\n        return new Tenant(\r\n            Guid.NewGuid(),\r\n            Required(cnpj, nameof(cnpj)),\r\n            Required(legalName, nameof(legalName)),\r\n            NormalizeOptional(tradeName),\r\n            NormalizeOptional(legalNature),\r\n            NormalizeOptional(primaryCnae),\r\n            category,\r\n            Required(businessEmail, nameof(businessEmail)),\r\n            Required(businessPhone, nameof(businessPhone)),\r\n            address,\r\n            DateTimeOffset.UtcNow);\r\n    }\r\n\r\n    private static string Required(string value, string parameterName)\r\n    {\r\n        ArgumentException.ThrowIfNullOrWhiteSpace(value, parameterName);\r\n        return value.Trim();\r\n    }\r\n\r\n    private static string? NormalizeOptional(string? value) =>\r\n        string.IsNullOrWhiteSpace(value) ? null : value.Trim();\r\n}\r\n\r\n\n--- src/Agendamento.Api/Domain/Tenants/TenantMembership.cs ---\r\nnamespace Agendamento.Domain.Tenants;\r\n\r\npublic sealed class TenantMembership\n{\n    private TenantMembership()\n    {\n    }\n\n    private TenantMembership(\r\n        Guid id,\r\n        Guid tenantId,\r\n        Guid userId,\r\n        TenantRole role,\r\n        bool isLegalRepresentative,\r\n        string position,\r\n        DateTimeOffset createdAtUtc)\r\n    {\r\n        Id = id;\r\n        TenantId = tenantId;\r\n        UserId = userId;\r\n        Role = role;\r\n        IsLegalRepresentative = isLegalRepresentative;\r\n        Position = position;\r\n        CreatedAtUtc = createdAtUtc;\r\n    }\r\n\r\n    public Guid Id { get; private set; }\n\n    public Guid TenantId { get; private set; }\n\n    public Guid UserId { get; private set; }\n\n    public TenantRole Role { get; private set; }\n\n    public bool IsLegalRepresentative { get; private set; }\n\n    public string Position { get; private set; } = null!;\n\n    public DateTimeOffset CreatedAtUtc { get; private set; }\n\r\n    public static TenantMembership CreateOwnerAdmin(\r\n        Guid tenantId,\r\n        Guid userId,\r\n        bool isLegalRepresentative,\r\n        string position)\r\n    {\r\n        if (tenantId == Guid.Empty)\r\n        {\r\n            throw new ArgumentException(\"O tenant é obrigatório.\", nameof(tenantId));\r\n        }\r\n\r\n        if (userId == Guid.Empty)\r\n        {\r\n            throw new ArgumentException(\"O usuário é obrigatório.\", nameof(userId));\r\n        }\r\n\r\n        ArgumentException.ThrowIfNullOrWhiteSpace(position);\r\n\r\n        return new TenantMembership(\r\n            Guid.NewGuid(),\r\n            tenantId,\r\n            userId,\r\n            TenantRole.OwnerAdmin,\r\n            isLegalRepresentative,\r\n            position.Trim(),\r\n            DateTimeOffset.UtcNow);\r\n    }\r\n}\r\n\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"agent_message","text":"O mapeamento mostrou que o JWT já emite `tenant_id`, mas o autenticador descarta essa claim. Vou preservá-la na identidade autenticada e criar um contexto separado que só a lê/valida, mais um leitor PostgreSQL que cruza `tenant_memberships` com `tenants`. Os arquivos previstos ainda não existem; o próximo passo é adicionar primeiro os testes reais de endpoint com PostgreSQL e JWT assinado pela mesma chave."}}
