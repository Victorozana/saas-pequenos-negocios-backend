y);\n    }\n\n    [Fact(DisplayName = \"Consulta cadastral autenticada retorna 401 sem bearer token\")]\n    public async Task Lookup_requires_authentication()\n    {\n        using var client = CreateClient(new FakeGateway(ActiveCompany()), authenticate: false);\n        Assert.Equal(HttpStatusCode.Unauthorized, (await client.GetAsync(\"/api/v1/company-registry/cnpj/04.252.011/0001-10\")).StatusCode);\n    }\n\n    [Fact(DisplayName = \"@spec:AC-014 bearer malformado falha fechado com 401\")]\n    public async Task Malformed_bearer_token_is_rejected_without_an_unhandled_exception()\n    {\n        using var client = CreateClient(new FakeGateway(ActiveCompany()), authenticate: false);\n        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue(\"Bearer\", \"a.b.***\");\n\n        var response = await client.GetAsync(\"/api/v1/company-registry/cnpj/04.252.011/0001-10\");\n\n        Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);\n    }\n\n    internal static HttpClient CreateClient(ICompanyRegistryGateway gateway, bool authenticate = true)\n    {\n        var factory = new AgendamentoApiFactory().WithWebHostBuilder(builder =>\n        {\n            builder.ConfigureAppConfiguration(configuration => configuration.AddInMemoryCollection(new Dictionary<string, string?>\n            {\n                [\"Authentication:SigningKey\"] = TenantEndpointTestSupport.SigningKey,\n                [\"Database:RequirePostgreSql\"] = \"false\",\n            }));\n            builder.ConfigureTestServices(services =>\n            {\n                services.AddSingleton<ICompanyRegistryGateway>(gateway);\n                services.PostConfigure<JwtAuthenticationOptions>(options => options.SigningKey = TenantEndpointTestSupport.SigningKey);\n            });\n        });\n        var client = factory.CreateClient();\n        return client.WithAuthentication(authenticate, factory.Services\n            .GetRequiredService<IOptionsMonitor<JwtAuthenticationOptions>>()\n            .Get(JwtAuthenticationHandler.SchemeName).SigningKey);\n    }\n\n    internal static CompanyRegistryResult ActiveCompany(string status = \"ATIVA\", string cnae = \"5611201\") => new(\n        \"Restaurante Exemplo Ltda\", \"Restaurante Exemplo\", \"Sociedade Empresária Limitada\", cnae,\n        cnae == \"6201501\" ? [] : [\"4721102\"], status,\n        new CompanyRegistryAddress(\"Rua das Flores\", \"100\", null, \"Centro\", \"São Paulo\", \"SP\", \"01001-000\"));\n\n    internal sealed class FakeGateway(CompanyRegistryResult company) : ICompanyRegistryGateway\n    {\n        public int CallCount { get; private set; }\n        public Task<CompanyRegistryResult> LookupAsync(Cnpj cnpj, CancellationToken cancellationToken = default)\n        {\n            CallCount++;\n            return Task.FromResult(company);\n        }\n    }\n\n    private sealed record ProblemBody(string Title);\n    private sealed record CompanyBody(string Cnpj, string LegalName, string? TradeName, string? LegalNature, string PrimaryCnae, string[] SecondaryCnaes, string RegistrationStatus, AddressBody Address);\n    private sealed record AddressBody(string City);\n}\n\ninternal static class TenantEndpointTestSupport\n{\n    internal const string SigningKey = \"test-signing-key-for-tenant-endpoints\";\n\n    internal static HttpClient WithAuthentication(this HttpClient client, bool authenticate, string signingKey)\n    {\n        if (authenticate)\n        {\n            var token = new JwtSessionIssuer(JwtSessionIssuerOptions.Create(signingKey)).Issue(\n                new SessionPrincipal(Guid.Parse(\"b5578db1-1d94-4255-a4af-a9d2a60ce61b\"), Guid.Empty, \"administrator\"));\n            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue(\"Bearer\", token.AccessToken);\n        }\n\n        return client;\n    }\n}\n\r\nusing Xunit;\r\n\r\nnamespace Agendamento.IntegrationTests.Infrastructure;\r\n\r\n[CollectionDefinition(Name)]\r\npubli