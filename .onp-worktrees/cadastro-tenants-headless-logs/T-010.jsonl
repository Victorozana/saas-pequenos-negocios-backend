t; }\n\n    public DateTimeOffset CreatedAtUtc { get; }\n\n    public static Tenant Create(\n        string cnpj,\n        string legalName,\n        BusinessCategory category,\n        string businessEmail,\n        string businessPhone,\n        TenantAddress address,\n        string? tradeName = null,\n        string? legalNature = null,\n        string? primaryCnae = null)\n    {\n        ArgumentNullException.ThrowIfNull(address);\n        if (!Enum.IsDefined(category))\n        {\n            throw new ArgumentOutOfRangeException(nameof(category));\n        }\n\n        return new Tenant(\n            Guid.NewGuid(),\n            Required(cnpj, nameof(cnpj)),\n            Required(legalName, nameof(legalName)),\n            NormalizeOptional(tradeName),\n            NormalizeOptional(legalNature),\n            NormalizeOptional(primaryCnae),\n            category,\n            Required(businessEmail, nameof(businessEmail)),\n            Required(businessPhone, nameof(businessPhone)),\n            address,\n            DateTimeOffset.UtcNow);\n    }\n\n    private static string Required(string value, string parameterName)\n    {\n        ArgumentException.ThrowIfNullOrWhiteSpace(value, parameterName);\n        return value.Trim();\n    }\n\n    private static string? NormalizeOptional(string? value) =>\n        string.IsNullOrWhiteSpace(value) ? null : value.Trim();\n}\n\r\nnamespace Agendamento.Domain.Tenants;\n\npublic sealed class TenantAddress\n{\n    private TenantAddress(\n        string street,\n        string number,\n        string district,\n        string city,\n        string state,\n        string postalCode,\n        string? complement)\n    {\n        Street = street;\n        Number = number;\n        District = district;\n        City = city;\n        State = state;\n        PostalCode = postalCode;\n        Complement = complement;\n    }\n\n    public string Street { get; }\n\n    public string Number { get; }\n\n    public string District { get; }\n\n    public string City { get; }\n\n    public string State { get; }\n\n    public string PostalCode { get; }\n\n    public string? Complement { get; }\n\n    public static TenantAddress Create(\n        string street,\n        string number,\n        string district,\n        string city,\n        string state,\n        string postalCode,\n        string? complement = null)\n    {\n        return new TenantAddress(\n            Required(street, nameof(street)),\n            Required(number, nameof(number)),\n            Required(district, nameof(district)),\n            Required(city, nameof(city)),\n            Required(state, nameof(state)),\n            Required(postalCode, nameof(postalCode)),\n            NormalizeOptional(complement));\n    }\n\n    private static string Required(string value, string parameterName)\n    {\n        ArgumentException.ThrowIfNullOrWhiteSpace(value, parameterName);\n        return value.Trim();\n    }\n\n    private static string? NormalizeOptional(string? value) =>\n        string.IsNullOrWhiteSpace(value) ? null : value.Trim();\n}\n\r\nnamespace Agendamento.Domain.Tenants;\n\npublic sealed class TenantFiscalProfile\n{\n    private TenantFiscalProfile(\n        Guid tenantId,\n        string? stateRegistration,\n        string? municipalRegistration,\n        bool isStateRegistrationExempt,\n        TaxRegime taxRegime,\n        string fiscalEmail)\n    {\n        TenantId = tenantId;\n        StateRegistration = stateRegistration;\n        MunicipalRegistration = municipalRegistration;\n        IsStateRegistrationExempt = isStateRegistrationExempt;\n        TaxRegime = taxRegime;\n        FiscalEmail = fiscalEmail;\n    }\n\n    public Guid TenantId { get; }\n\n    public string? StateRegistration { get; }\n\n    public string? MunicipalRegistration { get; }\n\n    public bool IsStateRegistrationExempt { get; }\n\n    public TaxRegime TaxRegime { get; }\n\n    public string FiscalEmail { get; }\n\n    public static TenantFiscalProfile Create(\n        Guid tenantId,\n        TaxRegime taxRegime,\n        string fiscalEmail,\n        string? stateRegistration = null,\n        string? municipalRegistration = null,\n        bool isStateRegistrationExempt = false)\n    {\n        if (tenantId == Guid.Empty)\n        {\n            throw new ArgumentException(\"O tenant é obrigatório.\", nameof(tenantId));\n        }\n\n        if (!Enum.IsDefined(taxRegime))\n        {\n            throw new ArgumentOutOfRangeException(nameof(taxRegime));\n        }\n\n        return new TenantFiscalProfile(\n            tenantId,\n            NormalizeOptional(stateRegistration),\n            NormalizeOptional(municipalRegistration),\n            isStateRegistrationExempt,\n            taxRegime,\n            Required(fiscalEmail, nameof(fiscalEmail)));\n    }\n\n    private static string Required(string value, string parameterName)\n    {\n        ArgumentException.ThrowIfNullOrWhiteSpace(value, parameterName);\n        return value.Trim();\n    }\n\n    private static string? NormalizeOptional(string? value) =>\n        string.IsNullOrWhiteSpace(value) ? null : value.Trim();\n}\n\r\nnamespace Agendamento.Domain.Tenants;\n\npublic sealed class TenantMembership\n{\n    private TenantMembership(\n        Guid id,\n        Guid tenantId,\n        Guid userId,\n        TenantRole role,\n        bool isLegalRepresentative,\n        string position,\n        DateTimeOffset createdAtUtc)\n    {\n        Id = id;\n        TenantId = tenantId;\n        UserId = userId;\n        Role = role;\n        IsLegalRepresentative = isLegalRepresentative;\n        Position = position;\n        CreatedAtUtc = createdAtUtc;\n    }\n\n    public Guid Id { get; }\n\n    public Guid TenantId { get; }\n\n    public Guid UserId { get; }\n\n    public TenantRole Role { get; }\n\n    public bool IsLegalRepresentative { get; }\n\n    public string Position { get; }\n\n    public DateTimeOffset CreatedAtUtc { get; }\n\n    public static TenantMembership CreateOwnerAdmin(\n        Guid tenantId,\n        Guid userId,\n        bool isLegalRepresentative,\n        string position)\n    {\n        if (tenantId == Guid.Empty)\n        {\n            throw new ArgumentException(\"O tenant é obrigatório.\", nameof(tenantId));\n        }\n\n        if (userId == Guid.Empty)\n        {\n            throw new ArgumentException(\"O usuário é obrigatório.\", nameof(userId));\n        }\n\n        ArgumentException.ThrowIfNullOrWhiteSpace(position);\n\n        return new TenantMembership(\n            Guid.NewGuid(),\n            tenantId,\n            userId,\n            TenantRole.OwnerAdmin,\n            isLegalRepresentative,\n            position.Trim(),\n            DateTimeOffset.UtcNow);\n    }\n}\n\r\nusing Agendamento.Domain.Tenants;\nusing Xunit;\n\nnamespace Agendamento.UnitTests.Tenants;\n\npublic sealed class TenantTests\n{\n    [Theory(DisplayName = \"Dados empresariais e endereço obrigatórios são validados @spec:AC-018\")]\n    [InlineData(\"legalName\")]\n    [InlineData(\"businessEmail\")]\n    [InlineData(\"businessPhone\")]\n    [InlineData(\"category\")]\n    public void Create_rejects_missing_required_business_data(string missingField)\n    {\n        var address = CreateAddress();\n        var legalName = missingField == \"legalName\" ? \" \" : \"Restaurante Exemplo Ltda\";\n        var businessEmail = missingField == \"businessEmail\" ? \" \" : \"contato@exemplo.com\";\n        var businessPhone = missingField == \"businessPhone\" ? \" \" : \"+55 11 99999-9999\";\n        var category = missingField == \"category\" ? (BusinessCategory)(-1) : BusinessCategory.Restaurant;\n\n        Assert.Throws<ArgumentException>(() => Tenant.Create(\n            \"12345678000195\",\n            legalName,\n            category,\n            businessEmail,\n            businessPhone,\n            address));\n    }\n\n    [Fact(DisplayName = \"Endereço completo é obrigatório no cadastro do tenant @spec:AC-018\")]\n    public void Address_rejects_missing_required_fields()\n    {\n        Assert.Throws<ArgumentException>(() => TenantAddress.Create(\n            \"Rua das Flores\",\n            \"100\",\n            \" \",\n            \"São Paulo\",\n            \"SP\",\n            \"01001-000\"));\n    }\n\n    [Fact(DisplayName = \"Modelo público do tenant não coleta banco, documentos ou KYC @spec:AC-020\")]\n    public void Public_model_excludes_financial_document_and_kyc_data()\n    {\n        var publicProperties = typeof(Tenant).GetProperties().Select(property => property.Name)\n            .Concat(typeof(TenantAddress).GetProperties().Select(property => property.Name))\n            .Concat(typeof(TenantFiscalProfile).GetProperties().Select(property => property.Name))\n            .Concat(typeof(TenantMembership).GetProperties().Select(property => property.Name));\n        var forbiddenTerms = new[] { \"bank\", \"account\", \"certificate\", \"document\", \"rg\", \"cnh\", \"contract\", \"license\", \"file\", \"kyc\" };\n\n        Assert.DoesNotContain(publicProperties, property =>\n            forbiddenTerms.Any(forbidden => property.Contains(forbidden, StringComparison.OrdinalIgnoreCase)));\n    }\n\n    private static TenantAddress CreateAddress() => TenantAddress.Create(\n        \"Rua das Flores\",\n        \"100\",\n        \"Centro\",\n        \"São Paulo\",\n        \"SP\",\n        \"01001-000\");\n}\n\r\nusing Agendamento.Domain.Tenants;\nusing Xunit;\n\nnamespace Agendamento.UnitTests.Tenants;\n\npublic sealed class TenantFiscalProfileTests\n{\n    [Fact(DisplayName = \"Perfil fiscal é vinculado exclusivamente a um tenant @spec:AC-019\")]\n    public void Create_binds_fiscal_data_to_one_tenant()\n    {\n        var tenantId = Guid.NewGuid();\n\n        var profile = TenantFiscalProfile.Create(\n            tenantId,\n            TaxRegime.SimplesNacional,\n            \"fiscal@exemplo.com\",\n            \"123.456.789.000\",\n            \"987654\",\n            isStateRegistrationExempt: false);\n\n        Assert.Equal(tenantId, profile.TenantId);\n        Assert.Equal(\"123.456.789.000\", profile.StateRegistration);\n        Assert.Equal(\"987654\", profile.MunicipalRegistration);\n        Assert.False(profile.IsStateRegistrationExempt);\n        Assert.Equal(TaxRegime.SimplesNacional, profile.TaxRegime);\n        Assert.Equal(\"fiscal@exemplo.com\", profile.FiscalEmail);\n    }\n}\n\r\nusing Agendamento.Domain.Tenants;\nusing Xunit;\n\nnamespace Agendamento.UnitTests.Tenants;\n\npublic sealed class TenantMembershipTests\n{\n    [Fact(DisplayName = \"Membership inicial registra owner_admin e representante legal @spec:AC-021\")]\n    public void CreateOwnerAdmin_preserves_administrator_responsibility()\n    {\n        var tenantId = Guid.NewGuid();\n        var userId = Guid.NewGuid();\n\n        var membership = TenantMembership.CreateOwnerAdmin(tenantId, userId, true, \"Sócia administradora\");\n\n        Assert.Equal(tenantId, membership.TenantId);\n        Assert.Equal(userId, membership.UserId);\n        Assert.Equal(TenantRole.OwnerAdmin, membership.Role);\n        Assert.True(membership.IsLegalRepresentative);\n        Assert.Equal(\"Sócia administradora\", membership.Position);\n    }\n}\n\r\n","exit_code":0,"status":"completed"}}
