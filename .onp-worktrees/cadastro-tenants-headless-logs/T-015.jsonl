arameterName);\r\n        return value.Trim();\r\n    }\r\n\r\n    private static string? NormalizeOptional(string? value) =>\r\n        string.IsNullOrWhiteSpace(value) ? null : value.Trim();\r\n}\r\n\r\nnamespace Agendamento.Domain.Tenants;\r\n\r\npublic sealed class TenantAddress\n{\n    private TenantAddress()\n    {\n    }\n\n    private TenantAddress(\r\n        string street,\r\n        string number,\r\n        string district,\r\n        string city,\r\n        string state,\r\n        string postalCode,\r\n        string? complement)\r\n    {\r\n        Street = street;\r\n        Number = number;\r\n        District = district;\r\n        City = city;\r\n        State = state;\r\n        PostalCode = postalCode;\r\n        Complement = complement;\r\n    }\r\n\r\n    public string Street { get; private set; } = null!;\n\n    public string Number { get; private set; } = null!;\n\n    public string District { get; private set; } = null!;\n\n    public string City { get; private set; } = null!;\n\n    public string State { get; private set; } = null!;\n\n    public string PostalCode { get; private set; } = null!;\n\n    public string? Complement { get; private set; }\n\r\n    public static TenantAddress Create(\r\n        string street,\r\n        string number,\r\n        string district,\r\n        string city,\r\n        string state,\r\n        string postalCode,\r\n        string? complement = null)\r\n    {\r\n        return new TenantAddress(\r\n            Required(street, nameof(street)),\r\n            Required(number, nameof(number)),\r\n            Required(district, nameof(district)),\r\n            Required(city, nameof(city)),\r\n            Required(state, nameof(state)),\r\n            Required(postalCode, nameof(postalCode)),\r\n            NormalizeOptional(complement));\r\n    }\r\n\r\n    private static string Required(string value, string parameterName)\r\n    {\r\n        ArgumentException.ThrowIfNullOrWhiteSpace(value, parameterName);\r\n        return value.Trim();\r\n    }\r\n\r\n    private static string? NormalizeOptional(string? value) =>\r\n        string.IsNullOrWhiteSpace(value) ? null : value.Trim();\r\n}\r\n\r\nnamespace Agendamento.Domain.Tenants;\r\n\r\npublic sealed class TenantFiscalProfile\n{\n    private TenantFiscalProfile()\n    {\n    }\n\n    private TenantFiscalProfile(\r\n        Guid tenantId,\r\n        string? stateRegistration,\r\n        string? municipalRegistration,\r\n        bool isStateRegistrationExempt,\r\n        TaxRegime taxRegime,\r\n        string fiscalEmail)\r\n    {\r\n        TenantId = tenantId;\r\n        StateRegistration = stateRegistration;\r\n        MunicipalRegistration = municipalRegistration;\r\n        IsStateRegistrationExempt = isStateRegistrationExempt;\r\n        TaxRegime = taxRegime;\r\n        FiscalEmail = fiscalEmail;\r\n    }\r\n\r\n    public Guid TenantId { get; private set; }\n\n    public string? StateRegistration { get; private set; }\n\n    public string? MunicipalRegistration { get; private set; }\n\n    public bool IsStateRegistrationExempt { get; private set; }\n\n    public TaxRegime TaxRegime { get; private set; }\n\n    public string FiscalEmail { get; private set; } = null!;\n\r\n    public static TenantFiscalProfile Create(\r\n        Guid tenantId,\r\n        TaxRegime taxRegime,\r\n        string fiscalEmail,\r\n        string? stateRegistration = null,\r\n        string? municipalRegistration = null,\r\n        bool isStateRegistrationExempt = false)\r\n    {\r\n        if (tenantId == Guid.Empty)\r\n        {\r\n            throw new ArgumentException(\"O tenant é obrigatório.\", nameof(tenantId));\r\n        }\r\n\r\n        if (!Enum.IsDefined(taxRegime))\r\n        {\r\n            throw new ArgumentOutOfRangeException(nameof(taxRegime));\r\n        }\r\n\r\n        return new TenantFiscalProfile(\r\n            tenantId,\r\n            NormalizeOptional(stateRegistration),\r\n            NormalizeOptional(municipalRegistration),\r\n            isStateRegistrationExempt,\r\n            taxRegime,\r\n            Required(fiscalEmail, nameof(fiscalEmail)));\r\n    }\r\n\r\n    private static string Required(string value, string parameterName)\r\n    {\r\n        ArgumentException.ThrowIfNullOrWhiteSpace(value, parameterName);\r\n        return value.Trim();\r\n    }\r\n\r\n    private static string? NormalizeOptional(string? value) =>\r\n        string.IsNullOrWhiteSpace(value) ? null : value.Trim();\r\n}\r\n\r\nnamespace Agendamento.Domain.Tenants;\r\n\r\npublic sealed class TenantMembership\n{\n    private TenantMembership()\n    {\n    }\n\n    private TenantMembership(\r\n        Guid id,\r\n        Guid tenantId,\r\n        Guid userId,\r\n        TenantRole role,\r\n        bool isLegalRepresentative,\r\n        string position,\r\n        DateTimeOffset createdAtUtc)\r\n    {\r\n        Id = id;\r\n        TenantId = tenantId;\r\n        UserId = userId;\r\n        Role = role;\r\n        IsLegalRepresentative = isLegalRepresentative;\r\n        Position = position;\r\n        CreatedAtUtc = createdAtUtc;\r\n    }\r\n\r\n    public Guid Id { get; private set; }\n\n    public Guid TenantId { get; private set; }\n\n    public Guid UserId { get; private set; }\n\n    public TenantRole Role { get; private set; }\n\n    public bool IsLegalRepresentative { get; private set; }\n\n    public string Position { get; private set; } = null!;\n\n    public DateTimeOffset CreatedAtUtc { get; private set; }\n\r\n    public static TenantMembership CreateOwnerAdmin(\r\n        Guid tenantId,\r\n        Guid userId,\r\n        bool isLegalRepresentative,\r\n        string position)\r\n    {\r\n        if (tenantId == Guid.Empty)\r\n        {\r\n            throw new ArgumentException(\"O tenant é obrigatório.\", nameof(tenantId));\r\n        }\r\n\r\n        if (userId == Guid.Empty)\r\n        {\r\n            throw new ArgumentException(\"O usuário é obrigatório.\", nameof(userId));\r\n        }\r\n\r\n        ArgumentException.ThrowIfNullOrWhiteSpace(position);\r\n\r\n        return new TenantMembership(\r\n            Guid.NewGuid(),\r\n            tenantId,\r\n            userId,\r\n            TenantRole.OwnerAdmin,\r\n            isLegalRepresentative,\r\n            position.Trim(),\r\n            DateTimeOffset.UtcNow);\r\n    }\r\n}\r\n\r\nnamespace Agendamento.Domain.Tenants;\r\n\r\npublic enum BusinessCategory\r\n{\r\n    Restaurant = 0,\r\n    Supermarket = 1,\r\n    GroceryStore = 2,\r\n    Bakery = 3,\r\n}\r\n\r\nnamespace Agendamento.Domain.Tenants;\r\n\r\npublic enum TaxRegime\r\n{\r\n    SimplesNacional = 0,\r\n    LucroPresumido = 1,\r\n    LucroReal = 2,\r\n}\r\n\r\nusing Agendamento.Application.Common;\nusing Agendamento.Domain.Tenants;\nusing Microsoft.EntityFrameworkCore;\nusing Microsoft.EntityFrameworkCore.Storage;\nusing Npgsql;\n\nnamespace Agendamento.Infrastructure.Persistence;\n\npublic sealed class UnitOfWork(AgendamentoDbContext dbContext) : IUnitOfWork\n{\n    public async Task<IUnitOfWorkTransaction> BeginTransactionAsync(\n        CancellationToken cancellationToken = default)\n    {\n        var databaseTransaction = await dbContext.Database.BeginTransactionAsync(cancellationToken);\n        return new UnitOfWorkTransaction(dbContext, databaseTransaction);\n    }\n\n    private sealed class UnitOfWorkTransaction(\n        AgendamentoDbContext dbContext,\n        IDbContextTransaction databaseTransaction) : IUnitOfWorkTransaction\n    {\n        private IdempotencyRecord? _newIdempotencyRecord;\n        private bool _completed;\n        private bool _disposed;\n\n        public async Task AcquireRegistrationLocksAsync(\n            Guid userId,\n            string idempotencyKey,\n            string canonicalCnpj,\n            CancellationToken cancellationToken = default)\n        {\n            var resources = new[]\n            {\n                $\"idempotency:{userId:N}:{idempotencyKey.Trim()}\",\n                $\"tenant-cnpj:{canonicalCnpj}\",\n            };\n\n            foreach (var resource in resources.Order(StringComparer.Ordinal))\n            {\n                await dbContext.Database.ExecuteSqlInterpolatedAsync(\n                    $\"SELECT pg_advisory_xact_lock(hashtextextended({resource}, 0));\",\n                    cancellationToken);\n            }\n        }\n\n        public Task<StoredIdempotencyRecord?> FindIdempotencyRecordAsync(\n            Guid userId,\n            string key,\n            CancellationToken cancellationToken = default) =>\n            dbContext.IdempotencyRecords\n                .AsNoTracking()\n                .Where(record => record.UserId == userId && record.Key == key.Trim())\n                .Select(record => new StoredIdempotencyRecord(\n                    record.RequestHash,\n                    record.State == IdempotencyRecordState.Completed,\n                    record.ResponseStatusCode,\n                    record.ResponseBody))\n                .SingleOrDefaultAsync(cancellationToken);\n\n        public Task<bool> TenantExistsByCnpjAsync(\n            string canonicalCnpj,\n            CancellationToken cancellationToken = default) =>\n            dbContext.Tenants.AnyAsync(\n                tenant => tenant.Cnpj == canonicalCnpj,\n                cancellationToken);\n\n        public void AddTenantRegistration(\n            Tenant tenant,\n            TenantFiscalProfile fiscalProfile,\n            TenantMembership membership) =>\n            dbContext.AddRange(tenant, fiscalProfile, membership);\n\n        public void AddIdempotencyRecord(\n            Guid userId,\n            string key,\n            string requestHash,\n            DateTimeOffset createdAtUtc)\n        {\n            if (_newIdempotencyRecord is not null)\n            {\n                throw new InvalidOperationException(\"A transação já possui um registro de idempotência.\");\n            }\n\n            _newIdempotencyRecord = IdempotencyRecord.Start(\n                userId,\n                key,\n                requestHash,\n                createdAtUtc);\n            dbContext.IdempotencyRecords.Add(_newIdempotencyRecord);\n        }\n\n        public void CompleteIdempotencyRecord(\n            int responseStatusCode,\n            string responseBody,\n            DateTimeOffset completedAtUtc)\n        {\n            if (_newIdempotencyRecord is null)\n            {\n                throw new InvalidOperationException(\"Nenhum registro de idempotência foi iniciado.\");\n            }\n\n            _newIdempotencyRecord.Complete(responseStatusCode, responseBody, completedAtUtc);\n        }\n\n        public async Task SaveChangesAsync(CancellationToken cancellationToken = default)\n        {\n            try\n            {\n                await dbContext.SaveChangesAsync(cancellationToken);\n            }\n            catch (DbUpdateException exception)\n                when (exception.InnerException is PostgresException\n                {\n                    SqlState: PostgresErrorCodes.UniqueViolation,\n                })\n            {\n                throw new PersistenceConflictException(\n                    \"Uma restrição global de unicidade impediu o cadastro do tenant.\",\n                    exception);\n            }\n        }\n\n        public async Task CommitAsync(CancellationToken cancellationToken = default)\n        {\n            await databaseTransaction.CommitAsync(cancellationToken);\n            _completed = true;\n        }\n\n        public async ValueTask DisposeAsync()\n        {\n            if (_disposed)\n            {\n                return;\n            }\n\n            if (!_completed)\n            {\n                await databaseTransaction.RollbackAsync();\n            }\n\n            await databaseTransaction.DisposeAsync();\n            _disposed = true;\n        }\n    }\n}\n\r\nusing Agendamento.Application.Tenants.CompanyRegistry;\nusing Agendamento.Domain.Tenants;\n\nnamespace Agendamento.Infrastructure.CompanyRegistry;\n\n/// <summary>\n/// Explicit placeholder used until a production registry provider is configured.\n/// </summary>\npublic sealed class UnavailableCompanyRegistryGateway : ICompanyRegistryGateway\n{\n    public Task<CompanyRegistryResult> LookupAsync(Cnpj cnpj, CancellationToken cancellationToken = default) =>\n        Task.FromException<CompanyRegistryResult>(new CompanyRegistryUnavailableException(\n            \"A consulta cadastral está indisponível porque não há provedor configurado.\"));\n}\n\r\n{\r\n  \"Database\": {\r\n    \"RequirePostgreSql\": true\r\n  },\r\n  \"ConnectionStrings\": {}\r\n}\r\n\r\nusing Agendamento.Application.Common;\nusing Agendamento.Application.Tenants.CompanyRegistry;\nusing Agendamento.Application.Tenants.RegisterTenant;\nusing Agendamento.Domain.Identity;\nusing Agendamento.Domain.Tenants;\nusing Agendamento.Infrastructure.Persistence;\nusing Agendamento.Infrastructure.Persistence.Configurations;\nusing Agendamento.IntegrationTests.Infrastructure;\nusing Microsoft.EntityFrameworkCore;\nusing Xunit;\n\nnamespace Agendamento.IntegrationTests.Tenants;\n\n[Collection(PostgreSqlCollection.Name)]\npublic sealed class RegisterTenantTransactionTests(PostgreSqlFixture fixture)\n{\n    [Fact(DisplayName = \"Transação cria tenant, perfil e owner_admin do usuário autenticado @spec:AC-021\")]\n    public async Task Registration_persists_all_components_for_the_current_user()\n    {\n        await EnsureMigrationAsync();\n        var user = await CreateUserAsync();\n        var command = ValidCommand($\"register-{Guid.NewGuid():N}\");\n\n        try\n        {\n            RegisterTenantResult result;\n            await using (var context = CreateDbContext())\n            {\n                result = await CreateHandler(context, user.Id).HandleAsync(command);\n            }\n\n            await using var assertionContext = CreateDbContext();\n            var tenant = await assertionContext.Tenants.AsNoTracking().SingleAsync(value => value.Id == result.TenantId);\n            var profile = await assertionContext.TenantFiscalProfiles.AsNoTracking().SingleAsync(value => value.TenantId == tenant.Id);\n            var membership = await assertionContext.TenantMemberships.AsNoTracking().SingleAsync(value => value.TenantId == tenant.Id);\n            var idempotency = await assertionContext.IdempotencyRecords.AsNoTracking().SingleAsync(\n                value => value.UserId == user.Id && value.Key == command.IdempotencyKey);\n\n            Assert.Equal(RegisterTenantStatus.Created, result.Status);\n            Assert.Equal(Cnpj.Parse(command.Cnpj).Value, tenant.Cnpj);\n            Assert.Equal(tenant.Id, profile.TenantId);\n            Assert.Equal(user.Id, membership.UserId);\n            Assert.Equal(TenantRole.OwnerAdmin, membership.Role);\n            Assert.True(membership.IsLegalRepresentative);\n            Assert.Equal(IdempotencyRecordState.Completed, idempotency.State);\n            Assert.Equal(201, idempotency.ResponseStatusCode);\n        }\n        finally\n        {\n            await DeleteRegistrationAsync(user.Id);\n            await DeleteUserAsync(user.Id);\n        }\n    }\n\n    [Fact(DisplayName = \"CNPJ global duplicado retorna conflito e preserva um cadastro @spec:AC-022\")]\n    public async Task Duplicate_canonical_cnpj_returns_conflict_without_duplicate_rows()\n    {\n        await EnsureMigrationAsync();\n        var user = await CreateUserAsync();\n        var firstCommand = ValidCommand($\"register-{Guid.NewGuid():N}\", \"12.ABC.345/01DE-35\");\n        var duplicateCommand = ValidCommand($\"register-{Guid.NewGuid():N}\", \"12abc34501de35\");\n\n        try\n        {\n            RegisterTenantResult first;\n            RegisterTenantResult duplicate;\n            await using (var firstContext = CreateDbContext())\n            {\n                first = await CreateHandler(firstContext, user.Id).HandleAsync(firstCommand);\n            }\n\n            await using (var duplicateContext = CreateDbContext())\n            {\n                duplicate = await CreateHandler(duplicateContext, user.Id).HandleAsync(duplicateCommand);\n            }\n\n            await using var assertionContext = CreateDbContext();\n            var canonicalCnpj = Cnpj.Parse(firstCommand.Cnpj).Value;\n            Assert.Equal(RegisterTenantStatus.Created, first.Status);\n            Assert.Equal(RegisterTenantStatus.Conflict, duplicate.Status);\n            Assert.Equal(1, await assertionContext.Tenants.CountAsync(value => value.Cnpj == canonicalCnpj));\n            Assert.Equal(1, await assertionContext.TenantFiscalProfiles.CountAsync(value => value.TenantId == first.TenantId));\n            Assert.Equal(1, await assertionContext.TenantMemberships.CountAsync(value => value.TenantId == first.TenantId));\n            Assert.Equal(1, await assertionContext.IdempotencyRecords.CountAsync(value => value.UserId == user.Id));\n        }\n        finally\n        {\n            await DeleteRegistrationAsync(user.Id);\n            await DeleteUserAsync(user.Id);\n        }\n    }\n\n    [Fact(DisplayName = \"PostgreSQL reaproveita resposta idempotente e rejeita payload diferente @spec:AC-023\")]\n    public async Task Idempotency_replays_original_result_and_rejects_a_different_payload()\n    {\n        await EnsureMigrationAsync();\n        var user = await CreateUserAsync();\n        var gateway = new FakeCompanyRegistryGateway();\n        var command = ValidCommand($\"register-{Guid.NewGuid():N}\");\n\n        try\n        {\n            RegisterTenantResult original;\n            RegisterTenantResult replay;\n            RegisterTenantResult conflict;\n            await using (var originalContext = CreateDbContext())\n            await using (var replayContext = CreateDbContext())\n            {\n                var concurrentResults = await Task.WhenAll(\n                    CreateHandler(originalContext, user.Id, gateway).HandleAsync(command),\n                    CreateHandler(replayContext, user.Id, gateway).HandleAsync(command));\n                original = concurrentResults[0];\n                replay = concurrentResults[1];\n            }\n\n            await using (var conflictContext = CreateDbContext())\n            {\n                conflict = await CreateHandler(conflictContext, user.Id, gateway).HandleAsync(\n                    command with { BusinessEmail = \"outro@exemplo.com\" });\n            }\n\n            await using var assertionContext = CreateDbContext();\n            Assert.Equal(original, replay);\n            Assert.Equal(RegisterTenantStatus.Conflict, conflict.Status);\n            Assert.Equal(1, gateway.CallCount);\n            Assert.Equal(1, await assertionContext.Tenants.CountAsync(value => value.Id == original.TenantId));\n            Assert.Equal(1, await assertionContext.TenantFiscalProfiles.CountAsync(value => value.TenantId == original.TenantId));\n            Assert.Equal(1, await assertionContext.TenantMemberships.CountAsync(value => value.TenantId == original.TenantId));\n            Assert.Equal(1, await assertionContext.IdempotencyRecords.CountAsync(\n                value => value.UserId == user.Id && value.Key == command.IdempotencyKey));\n        }\n        finally\n        {\n            await DeleteRegistrationAsync(user.Id);\n            await DeleteUserAsync(user.Id);\n        }\n    }\n\n    [Fact(DisplayName = \"Falha PostgreSQL parcial reverte tenant, perfil, membership e idempotência @spec:AC-024\")]\n    public async Task Database_failure_rolls_back_every_registration_component()\n    {\n        await EnsureMigrationAsync();\n        var user = await CreateUserAsync();\n        var command = ValidCommand($\"register-{Guid.NewGuid():N}\") with { Position = \"force_t014_failure\" };\n        await InstallMembershipFailureTriggerAsync();\n\n        try\n        {\n            await using (var context = CreateDbContext())\n            {\n                var handler = CreateHandler(context, user.Id);\n                await Assert.ThrowsAsync<DbUpdateException>(() => handler.HandleAsync(command));\n            }\n\n            await using var assertionContext = CreateDbContext();\n            var canonicalCnpj = Cnpj.Parse(command.Cnpj).Value;\n            Assert.False(await assertionContext.Tenants.AnyAsync(value => value.Cnpj == canonicalCnpj));\n            Assert.False(await assertionContext.TenantFiscalProfiles.AnyAsync());\n            Assert.False(await assertionContext.TenantMemberships.AnyAsync(value => value.UserId == user.Id));\n            Assert.False(await assertionContext.IdempotencyRecords.AnyAsync(\n                value => value.UserId == user.Id && value.Key == command.IdempotencyKey));\n        }\n        finally\n        {\n            await RemoveMembershipFailureTriggerAsync();\n            await DeleteRegistrationAsync(user.Id);\n            await DeleteUserAsync(user.Id);\n        }\n    }\n\n    private AgendamentoDbContext CreateDbContext()\n    {\n        var options = new DbContextOptionsBuilder<AgendamentoDbContext>()\n            .UseNpgsql(fixture.ConnectionString)\n            .Options;\n        return new AgendamentoDbContext(options);\n    }\n\n    private static RegisterTenantHandler CreateHandler(\n        AgendamentoDbContext context,\n        Guid userId,\n        FakeCompanyRegistryGateway? gateway = null) =>\n        new(\n            new FixedCurrentUser(userId),\n            new UnitOfWork(context),\n            gateway ?? new FakeCompanyRegistryGateway(),\n            new FoodCnaePolicy());\n\n    private async Task EnsureMigrationAsync()\n    {\n        await fixture.ExecuteScriptAsync(UserConfiguration.CreateTableSql);\n        await using var context = CreateDbContext();\n        await context.Database.MigrateAsync();\n    }\n\n    private async Task<User> CreateUserAsync()\n    {\n        var cpf = string.Concat(Enumerable.Range(0, 11).Select(_ => Random.Shared.Next(10)));\n        var user = User.Create(cpf, $\"registration-{Guid.NewGuid():N}@example.com\", \"test-password-hash\");\n        await using var context = CreateDbContext();\n        await context.Database.ExecuteSqlInterpolatedAsync($\"\"\"\n            INSERT INTO \"Users\" (\"Id\", \"Cpf\", \"Email\", \"PasswordHash\", \"Status\", \"CreatedAtUtc\")\n            VALUES ({user.Id}, {user.Cpf}, {user.Email}, {user.PasswordHash}, {(int)user.Status}, {user.CreatedAtUtc});\n            \"\"\");\n        return user;\n    }\n\n    private Task InstallMembershipFailureTriggerAsync() => fixture.ExecuteScriptAsync(\"\"\"\n        CREATE OR REPLACE FUNCTION fail_t014_membership_insert()\n        RETURNS trigger AS $$\n        BEGIN\n            IF NEW.position = 'force_t014_failure' THEN\n                RAISE EXCEPTION 'forced T-014 membership failure';\n            END IF;\n            RETURN NEW;\n        END;\n        $$ LANGUAGE plpgsql;\n\n        DROP TRIGGER IF EXISTS trg_t014_fail_membership ON tenant_memberships;\n        CREATE TRIGGER trg_t014_fail_membership\n        BEFORE INSERT ON tenant_memberships\n        FOR EACH ROW EXECUTE FUNCTION fail_t014_membership_insert();\n        \"\"\");\n\n    private Task RemoveMembershipFailureTriggerAsync() => fixture.ExecuteScriptAsync(\"\"\"\n        DROP TRIGGER IF EXISTS trg_t014_fail_membership ON tenant_memberships;\n        DROP FUNCTION IF EXISTS fail_t014_membership_insert();\n        \"\"\");\n\n    private async Task DeleteRegistrationAsync(Guid userId)\n    {\n        await using var context = CreateDbContext();\n        await context.IdempotencyRecords.Where(value => value.UserId == userId).ExecuteDeleteAsync();\n        var tenantIds = context.TenantMemberships\n            .Where(value => value.UserId == userId)\n            .Select(value => value.TenantId);\n        await context.Tenants.Where(value => tenantIds.Contains(value.Id)).ExecuteDeleteAsync();\n    }\n\n    private async Task DeleteUserAsync(Guid userId)\n    {\n        await using var context = CreateDbContext();\n        await context.Database.ExecuteSqlInterpolatedAsync($\"\"\"\n            DELETE FROM \"Users\" WHERE \"Id\" = {userId};\n            \"\"\");\n    }\n\n    private static RegisterTenantCommand ValidCommand(string idempotencyKey, string cnpj = \"04.252.011/0001-10\") =>\n        new(\n            idempotencyKey,\n            cnpj,\n            \"Restaurante Exemplo Ltda\",\n            \"Restaurante Exemplo\",\n            \"Sociedade Empresária Limitada\",\n            \"5611201\",\n            BusinessCategory.Restaurant,\n            \"contato@exemplo.com\",\n            \"+55 11 99999-9999\",\n            new RegisterTenantAddress(\n                \"Rua das Flores\",\n                \"100\",\n                \"Centro\",\n                \"São Paulo\",\n                \"SP\",\n                \"01001-000\",\n                null),\n            new RegisterTenantFiscalProfile(\n                TaxRegime.SimplesNacional,\n                \"fiscal@exemplo.com\",\n                \"123.456.789.000\",\n                \"987654\",\n                false),\n            true,\n            \"Sócia administradora\");\n\n    private sealed class FixedCurrentUser(Guid userId) : ICurrentUser\n    {\n        public Guid? UserId { get; } = userId;\n    }\n\n    private sealed class FakeCompanyRegistryGateway : ICompanyRegistryGateway\n    {\n        private int _callCount;\n\n        public int CallCount => _callCount;\n\n        public Task<CompanyRegistryResult> LookupAsync(Cnpj cnpj, CancellationToken cancellationToken = default)\n        {\n            Interlocked.Increment(ref _callCount);\n            return Task.FromResult(new CompanyRegistryResult(\n                \"Restaurante Exemplo Ltda\",\n                \"Restaurante Exemplo\",\n                \"Sociedade Empresária Limitada\",\n                \"5611201\",\n                [],\n                \"ATIVA\",\n                null));\n        }\n    }\n}\n\r\nusing Agendamento.Domain.Identity;\nusing Agendamento.Domain.Tenants;\nusing Agendamento.Infrastructure.Persistence;\nusing Agendamento.Infrastructure.Persistence.Configurations;\nusing Agendamento.IntegrationTests.Infrastructure;\nusing Microsoft.EntityFrameworkCore;\nusing Xunit;\n\nnamespace Agendamento.IntegrationTests.Tenants;\n\n[Collection(PostgreSqlCollection.Name)]\npublic sealed class TenantPersistenceTests(PostgreSqlFixture fixture)\n{\n    [Fact(DisplayName = \"Migration PostgreSQL aplica e mantém perfil fiscal 1:1 @spec:AC-019\")]\n    public async Task Migration_applies_and_persists_exactly_one_fiscal_profile_per_tenant()\n    {\n        await EnsureMigrationAsync();\n        var tenant = CreateTenant(Cnpj.Parse(\"04.252.011/0001-10\").Value);\n        var profile = CreateFiscalProfile(tenant.Id);\n\n        try\n        {\n            await using (var context = CreateDbContext())\n            {\n                context.AddRange(tenant, profile);\n                await context.SaveChangesAsync();\n            }\n\n            await using (var duplicateContext = CreateDbContext())\n            {\n                duplicateContext.TenantFiscalProfiles.Add(CreateFiscalProfile(tenant.Id));\n                await Assert.ThrowsAsync<DbUpdateException>(() => duplicateContext.SaveChangesAsync());\n            }\n\n            await using var assertionContext = CreateDbContext();\n            var persistedTenant = await assertionContext.Tenants.AsNoTracking().SingleAsync(value => value.Id == tenant.Id);\n            var persistedProfile = await assertionContext.TenantFiscalProfiles\n                .AsNoTracking()\n                .SingleAsync(value => value.TenantId == tenant.Id);\n            var appliedMigrations = await assertionContext.Database.GetAppliedMigrationsAsync();\n\n            Assert.Contains(appliedMigrations, migration => migration.EndsWith(\"_CreateTenantPersistence\", StringComparison.Ordinal));\n            Assert.Equal(\"Rua das Flores\", persistedTenant.Address.Street);\n            Assert.Equal(\"123.456.789.000\", persistedProfile.StateRegistration);\n            Assert.Equal(TaxRegime.SimplesNacional, persistedProfile.TaxRegime);\n            Assert.Equal(1, await assertionContext.TenantFiscalProfiles.CountAsync(value => value.TenantId == tenant.Id));\n        }\n        finally\n        {\n            await DeleteTenantAsync(tenant.Id);\n        }\n    }\n\n    [Fact(DisplayName = \"Membership owner_admin preserva usuário autenticado e FKs explícitas @spec:AC-021\")]\n    public async Task Membership_persists_for_existing_user_and_rejects_missing_tenant_or_user()\n    {\n        await EnsureMigrationAsync();\n        var user = await CreateUserAsync();\n        var tenant = CreateTenant(Cnpj.Parse(\"12.ABC.345/01DE-35\").Value);\n        var profile = CreateFiscalProfile(tenant.Id);\n        var membership = TenantMembership.CreateOwnerAdmin(tenant.Id, user.Id, true, \"Sócia administradora\");\n\n        try\n        {\n            await using (var context = CreateDbContext())\n            {\n                context.AddRange(tenant, profile, membership);\n                await context.SaveChangesAsync();\n            }\n\n            await using (var missingTenantContext = CreateDbContext())\n            {\n                missingTenantContext.TenantMemberships.Add(\n                    TenantMembership.CreateOwnerAdmin(Guid.NewGuid(), user.Id, false, \"Administradora\"));\n                await Assert.ThrowsAsync<DbUpdateException>(() => missingTenantContext.SaveChangesAsync());\n            }\n\n            await using (var missingUserContext = CreateDbContext())\n            {\n                missingUserContext.TenantMemberships.Add(\n                    TenantMembership.CreateOwnerAdmin(tenant.Id, Guid.NewGuid(), false, \"Administradora\"));\n                await Assert.ThrowsAsync<DbUpdateException>(() => missingUserContext.SaveChangesAsync());\n            }\n\n            await using var assertionContext = CreateDbContext();\n            var persisted = await assertionContext.TenantMemberships\n                .AsNoTracking()\n                .SingleAsync(value => value.Id == membership.Id);\n\n            Assert.Equal(tenant.Id, persisted.TenantId);\n            Assert.Equal(user.Id, persisted.UserId);\n            Assert.Equal(TenantRole.OwnerAdmin, persisted.Role);\n            Assert.True(persisted.IsLegalRepresentative);\n            Assert.Equal(1, await assertionContext.TenantMemberships.CountAsync(value => value.TenantId == tenant.Id));\n        }\n        finally\n        {\n            await DeleteTenantAsync(tenant.Id);\n            await DeleteUserAsync(user.Id);\n        }\n    }\n\n    [Fact(DisplayName = \"CNPJ canônico tem UNIQUE global sem duplicar tenant @spec:AC-022\")]\n    public async Task Duplicate_canonical_cnpj_fails_without_creating_another_tenant()\n    {\n        await EnsureMigrationAsync();\n        var canonicalCnpj = Cnpj.Parse(\"12.ABC.345/01DE-35\").Value;\n        var sameCanonicalCnpj = Cnpj.Parse(\"12abc34501de35\").Value;\n        var registeredTenant = CreateTenant(canonicalCnpj);\n        var duplicateTenant = CreateTenant(sameCanonicalCnpj);\n\n        try\n        {\n            await using (var context = CreateDbContext())\n            {\n                context.Tenants.Add(registeredTenant);\n                await context.SaveChangesAsync();\n            }\n\n            await using (var duplicateContext = CreateDbContext())\n            {\n                duplicateContext.Tenants.Add(duplicateTenant);\n                await Assert.ThrowsAsync<DbUpdateException>(() => duplicateContext.SaveChangesAsync());\n            }\n\n            await using var assertionContext = CreateDbContext();\n            Assert.Equal(1, await assertionContext.Tenants.CountAsync(value => value.Cnpj == canonicalCnpj));\n            Assert.False(await assertionContext.Tenants.AnyAsync(value => value.Id == duplicateTenant.Id));\n        }\n        finally\n        {\n            await DeleteTenantAsync(registeredTenant.Id);\n            await DeleteTenantAsync(duplicateTenant.Id);\n        }\n    }\n\n    [Fact(DisplayName = \"Falha idempotente reverte tenant, perfil, membership e registro @spec:AC-024\")]\n    public async Task Idempotency_conflict_rolls_back_all_registration_components()\n    {\n        await EnsureMigrationAsync();\n        var user = await CreateUserAsync();\n        var tenant = CreateTenant(Cnpj.Parse(\"04.252.011/0001-10\").Value);\n        var idempotencyKey = $\"register-tenant-{Guid.NewGuid():N}\";\n\n        try\n        {\n            await using (var context = CreateDbContext())\n            await using (var transaction = await context.Database.BeginTransactionAsync())\n            {\n                var record = IdempotencyRecord.Start(\n                    user.Id,\n                    idempotencyKey,\n                    new string('a', 64),\n                    DateTimeOffset.UtcNow);\n                record.Complete(201, $$\"\"\"{\"tenant_id\":\"{{tenant.Id}}\"}\"\"\", DateTimeOffset.UtcNow);\n\n                context.AddRange(\n                    tenant,\n                    CreateFiscalProfile(tenant.Id),\n                    TenantMembership.CreateOwnerAdmin(tenant.Id, user.Id, false, \"Administradora\"),\n                    record);\n                await context.SaveChangesAsync();\n\n                context.IdempotencyRecords.Add(IdempotencyRecord.Start(\n                    user.Id,\n                    idempotencyKey,\n                    new string('b', 64),\n                    DateTimeOffset.UtcNow));\n                await Assert.ThrowsAsync<DbUpdateException>(() => context.SaveChangesAsync());\n                await transaction.RollbackAsync();\n            }\n\n            await using var assertionContext = CreateDbContext();\n            Assert.False(await assertionContext.Tenants.AnyAsync(value => value.Id == tenant.Id));\n            Assert.False(await assertionContext.TenantFiscalProfiles.AnyAsync(value => value.TenantId == tenant.Id));\n            Assert.False(await assertionContext.TenantMemberships.AnyAsync(value => value.TenantId == tenant.Id));\n            Assert.False(await assertionContext.IdempotencyRecords.AnyAsync(\n                value => value.UserId == user.Id && value.Key == idempotencyKey));\n        }\n        finally\n        {\n            await DeleteTenantAsync(tenant.Id);\n            await DeleteIdempotencyRecordsAsync(user.Id);\n            await DeleteUserAsync(user.Id);\n        }\n    }\n\n    private AgendamentoDbContext CreateDbContext()\n    {\n        var options = new DbContextOptionsBuilder<AgendamentoDbContext>()\n            .UseNpgsql(fixture.ConnectionString)\n            .Options;\n        return new AgendamentoDbContext(options);\n    }\n\n    private async Task EnsureMigrationAsync()\n    {\n        await fixture.ExecuteScriptAsync(UserConfiguration.CreateTableSql);\n        await using var context = CreateDbContext();\n        await context.Database.MigrateAsync();\n    }\n\n    private async Task<User> CreateUserAsync()\n    {\n        var cpf = string.Concat(Enumerable.Range(0, 11).Select(_ => Random.Shared.Next(10)));\n        var user = User.Create(cpf, $\"tenant-test-{Guid.NewGuid():N}@example.com\", \"test-password-hash\");\n        await using var context = CreateDbContext();\n        await context.Database.ExecuteSqlInterpolatedAsync($\"\"\"\n            INSERT INTO \"Users\" (\"Id\", \"Cpf\", \"Email\", \"PasswordHash\", \"Status\", \"CreatedAtUtc\")\n            VALUES ({user.Id}, {user.Cpf}, {user.Email}, {user.PasswordHash}, {(int)user.Status}, {user.CreatedAtUtc});\n            \"\"\");\n        return user;\n    }\n\n    private async Task DeleteTenantAsync(Guid tenantId)\n    {\n        await using var context = CreateDbContext();\n        await context.Tenants.Where(value => value.Id == tenantId).ExecuteDeleteAsync();\n    }\n\n    private async Task DeleteIdempotencyRecordsAsync(Guid userId)\n    {\n        await using var context = CreateDbContext();\n        await context.IdempotencyRecords.Where(value => value.UserId == userId).ExecuteDeleteAsync();\n    }\n\n    private async Task DeleteUserAsync(Guid userId)\n    {\n        await using var context = CreateDbContext();\n        await context.Database.ExecuteSqlInterpolatedAsync($\"\"\"\n            DELETE FROM \"Users\" WHERE \"Id\" = {userId};\n            \"\"\");\n    }\n\n    private static Tenant CreateTenant(string cnpj) => Tenant.Create(\n        cnpj,\n        \"Restaurante Exemplo Ltda\",\n        BusinessCategory.Restaurant,\n        \"contato@exemplo.com\",\n        \"+55 11 99999-9999\",\n        TenantAddress.Create(\n            \"Rua das Flores\",\n            \"100\",\n            \"Centro\",\n            \"São Paulo\",\n            \"SP\",\n            \"01001-000\"),\n        \"Restaurante Exemplo\",\n        \"Sociedade Empresária Limitada\",\n        \"5611201\");\n\n    private static TenantFiscalProfile CreateFiscalProfile(Guid tenantId) => TenantFiscalProfile.Create(\n        tenantId,\n        TaxRegime.SimplesNacional,\n        \"fiscal@exemplo.com\",\n        \"123.456.789.000\",\n        \"987654\",\n        isStateRegistrationExempt: false);\n}\n\r\n","exit_code":0,"status":"completed"}}
