 \"HS256\", typ = \"JWT\" }));\r\n        var payload = Base64Url(JsonSerializer.SerializeToUtf8Bytes(new\r\n        {\r\n            sub = principal.UserId,\r\n            tenant_id = principal.TenantId,\r\n            role = principal.Role,\r\n            iat = now.ToUnixTimeSeconds(),\r\n            exp = expiresAt.ToUnixTimeSeconds(),\r\n        }));\r\n        var unsignedToken = $\"{header}.{payload}\";\r\n        var signature = Sign(unsignedToken, options.SigningKey);\r\n\r\n        return new IssuedSession($\"{unsignedToken}.{signature}\", expiresAt);\r\n    }\r\n\r\n    private static string Sign(string content, string signingKey)\r\n    {\r\n        using var hmac = new HMACSHA256(Encoding.UTF8.GetBytes(signingKey));\r\n        return Base64Url(hmac.ComputeHash(Encoding.UTF8.GetBytes(content)));\r\n    }\r\n\r\n    private static string Base64Url(byte[] value) => Convert.ToBase64String(value)\r\n        .TrimEnd('=')\r\n        .Replace('+', '-')\r\n        .Replace('/', '_');\r\n}\r\n\r\npublic sealed record JwtSessionIssuerOptions(string SigningKey, TimeSpan Lifetime)\r\n{\r\n    public static JwtSessionIssuerOptions Create(string signingKey) => new(signingKey, TimeSpan.FromMinutes(15));\r\n}\r\n\r\nusing Agendamento.Application.Identity.CreateSession;\r\nusing Microsoft.AspNetCore.Http.HttpResults;\r\n\r\nnamespace Agendamento.Api.Features.Identity;\r\n\r\npublic static class SessionEndpoints\r\n{\r\n    public static IEndpointRouteBuilder MapSessionEndpoints(this IEndpointRouteBuilder endpoints)\r\n    {\r\n        endpoints.MapPost(\"/api/v1/auth/sessions\", CreateAsync);\r\n        return endpoints;\r\n    }\r\n\r\n    private static async Task<Results<Ok<SessionResponse>, ProblemHttpResult>> CreateAsync(\r\n        CreateSessionRequest request,\r\n        CreateSessionHandler handler,\r\n        CancellationToken cancellationToken)\r\n    {\r\n        if (string.IsNullOrWhiteSpace(request.Email) || string.IsNullOrWhiteSpace(request.Password))\r\n        {\r\n            return TypedResults.Problem(statusCode: StatusCodes.Status400BadRequest, title: \"Dados de acesso inválidos.\");\r\n        }\r\n\r\n        var outcome = await handler.HandleAsync(new CreateSessionCommand(request.Email, request.Password), cancellationToken);\r\n        if (outcome.Error == \"email_verification_required\")\r\n        {\r\n            return TypedResults.Problem(statusCode: StatusCodes.Status403Forbidden, title: \"Confirme seu e-mail antes de entrar.\");\r\n        }\r\n\r\n        if (outcome.Error is not null)\r\n        {\r\n            return TypedResults.Problem(statusCode: StatusCodes.Status401Unauthorized, title: \"Não foi possível iniciar a sessão.\");\r\n        }\r\n\r\n        return TypedResults.Ok(new SessionResponse(outcome.AccessToken!, outcome.ExpiresAt!.Value));\r\n    }\r\n}\r\n\r\npublic sealed record CreateSessionRequest(string Email, string Password);\r\n\r\npublic sealed record SessionResponse(string AccessToken, DateTimeOffset ExpiresAt);\r\n\r\nusing Agendamento.Application.Identity.VerifyEmail;\r\nusing Microsoft.AspNetCore.Http.HttpResults;\r\n\r\nnamespace Agendamento.Api.Features.Identity;\r\n\r\npublic static class EmailVerificationEndpoints\r\n{\r\n    public static IEndpointRouteBuilder MapEmailVerificationEndpoints(this IEndpointRouteBuilder endpoints)\r\n    {\r\n        endpoints.MapPost(\"/api/v1/auth/email-verifications\", ConfirmAsync);\r\n        return endpoints;\r\n    }\r\n\r\n    private static async Task<Results<NoContent, ProblemHttpResult>> ConfirmAsync(\r\n        VerifyEmailRequest request,\r\n        VerifyEmailHandler handler,\r\n        CancellationToken cancellationToken)\r\n    {\r\n        if (string.IsNullOrWhiteSpace(request.Token))\r\n        {\r\n            return TypedResults.Problem(\r\n                statusCode: StatusCodes.Status400BadRequest,\r\n                title: \"Não foi possível concluir a verificação.\");\r\n        }\r\n\r\n        var result = await handler.HandleAsync(new VerifyEmailCommand(request.Token), cancellationToken);\r\n        return result == VerifyEmailResult.Verified\r\n            ? TypedResults.NoContent()\r\n            : TypedResults.Problem(\r\n                statusCode: StatusCodes.Status400BadRequest,\r\n                title: \"Não foi possível concluir a verificação.\");\r\n    }\r\n}\r\n\r\nusing Agendamento.Application.Tenants.CompanyRegistry;\nusing Agendamento.Domain.Tenants;\n\nnamespace Agendamento.Application.Tenants.LookupCompany;\n\npublic sealed class LookupCompanyHandler(\n    ICompanyRegistryGateway gateway,\n    FoodCnaePolicy foodCnaePolicy)\n{\n    public async Task<LookupCompanyResult> HandleAsync(\n        LookupCompanyQuery query,\n        CancellationToken cancellationToken = default)\n    {\n        if (!Cnpj.TryParse(query.Cnpj, out var cnpj))\n        {\n            return LookupCompanyResult.InvalidCnpj;\n        }\n\n        var validCnpj = cnpj!;\n\n        CompanyRegistryResult company;\n        try\n        {\n            company = await gateway.LookupAsync(validCnpj, cancellationToken);\n        }\n        catch (CompanyRegistryUnavailableException)\n        {\n            return LookupCompanyResult.DependencyUnavailable;\n        }\n\n        if (!string.Equals(company.RegistrationStatus, \"ATIVA\", StringComparison.Ordinal))\n        {\n            return new LookupCompanyResult(LookupCompanyStatus.CompanyInactive, validCnpj.Value, company);\n        }\n\n        if (!foodCnaePolicy.IsEligible(company))\n        {\n            return new LookupCompanyResult(LookupCompanyStatus.IneligibleCnae, validCnpj.Value, company);\n        }\n\n        return new LookupCompanyResult(LookupCompanyStatus.Eligible, validCnpj.Value, company);\n    }\n}\n\npublic enum LookupCompanyStatus\n{\n    InvalidCnpj,\n    CompanyInactive,\n    IneligibleCnae,\n    Eligible,\n    DependencyUnavailable,\n}\n\npublic sealed record LookupCompanyResult(\n    LookupCompanyStatus Status,\n    string? Cnpj,\n    CompanyRegistryResult? Company)\n{\n    public static readonly LookupCompanyResult InvalidCnpj = new(LookupCompanyStatus.InvalidCnpj, null, null);\n    public static readonly LookupCompanyResult DependencyUnavailable = new(LookupCompanyStatus.DependencyUnavailable, null, null);\n}\n\r\nnamespace Agendamento.Application.Tenants.CompanyRegistry;\n\npublic sealed record CompanyRegistryResult(\n    string LegalName,\n    string? TradeName,\n    string? LegalNature,\n    string PrimaryCnae,\n    IReadOnlyCollection<string> SecondaryCnaes,\n    string RegistrationStatus,\n    CompanyRegistryAddress? Address);\n\npublic sealed record CompanyRegistryAddress(\n    string? Street,\n    string? Number,\n    string? Complement,\n    string? District,\n    string? City,\n    string? State,\n    string? PostalCode);\n\r\nusing Agendamento.Domain.Tenants;\n\nnamespace Agendamento.Application.Tenants.RegisterTenant;\n\npublic sealed record RegisterTenantCommand(\n    string IdempotencyKey,\n    string Cnpj,\n    string LegalName,\n    string? TradeName,\n    string? LegalNature,\n    string? PrimaryCnae,\n    BusinessCategory Category,\n    string BusinessEmail,\n    string BusinessPhone,\n    RegisterTenantAddress Address,\n    RegisterTenantFiscalProfile FiscalProfile,\n    bool IsLegalRepresentative,\n    string Position);\n\npublic sealed record RegisterTenantAddress(\n    string Street,\n    string Number,\n    string District,\n    string City,\n    string State,\n    string PostalCode,\n    string? Complement);\n\npublic sealed record RegisterTenantFiscalProfile(\n    TaxRegime TaxRegime,\n    string FiscalEmail,\n    string? StateRegistration,\n    string? MunicipalRegistration,\n    bool IsStateRegistrationExempt);\n\npublic sealed record RegisterTenantResult(RegisterTenantStatus Status, Guid? TenantId)\n{\n    public static RegisterTenantResult Created(Guid tenantId) => new(RegisterTenantStatus.Created, tenantId);\n\n    public static readonly RegisterTenantResult Conflict = new(RegisterTenantStatus.Conflict, null);\n\n    public static readonly RegisterTenantResult Unauthenticated = new(RegisterTenantStatus.Unauthenticated, null);\n\n    public static readonly RegisterTenantResult InvalidCnpj = new(RegisterTenantStatus.InvalidCnpj, null);\n\n    public static readonly RegisterTenantResult CompanyInactive = new(RegisterTenantStatus.CompanyInactive, null);\n\n    public static readonly RegisterTenantResult IneligibleCnae = new(RegisterTenantStatus.IneligibleCnae, null);\n\n    public static readonly RegisterTenantResult DependencyUnavailable = new(RegisterTenantStatus.DependencyUnavailable, null);\n}\n\npublic enum RegisterTenantStatus\n{\n    Created,\n    Conflict,\n    Unauthenticated,\n    InvalidCnpj,\n    CompanyInactive,\n    IneligibleCnae,\n    DependencyUnavailable,\n}\n\r\nusing System.Security.Cryptography;\nusing System.Text.Json;\nusing Agendamento.Application.Common;\nusing Agendamento.Application.Tenants.CompanyRegistry;\nusing Agendamento.Domain.Tenants;\n\nnamespace Agendamento.Application.Tenants.RegisterTenant;\n\npublic sealed class RegisterTenantHandler(\n    ICurrentUser currentUser,\n    IUnitOfWork unitOfWork,\n    ICompanyRegistryGateway companyRegistryGateway,\n    FoodCnaePolicy foodCnaePolicy)\n{\n    private const int CreatedStatusCode = 201;\n\n    public async Task<RegisterTenantResult> HandleAsync(\n        RegisterTenantCommand command,\n        CancellationToken cancellationToken = default)\n    {\n        ArgumentNullException.ThrowIfNull(command);\n        ArgumentException.ThrowIfNullOrWhiteSpace(command.IdempotencyKey);\n\n        if (currentUser.UserId is not { } userId || userId == Guid.Empty)\n        {\n            return RegisterTenantResult.Unauthenticated;\n        }\n\n        if (!Cnpj.TryParse(command.Cnpj, out var parsedCnpj))\n        {\n            return RegisterTenantResult.InvalidCnpj;\n        }\n\n        var cnpj = parsedCnpj!;\n        var idempotencyKey = command.IdempotencyKey.Trim();\n        var requestHash = ComputeRequestHash(command, cnpj.Value);\n\n        await using var transaction = await unitOfWork.BeginTransactionAsync(cancellationToken);\n        await transaction.AcquireRegistrationLocksAsync(\n            userId,\n            idempotencyKey,\n            cnpj.Value,\n            cancellationToken);\n\n        var storedRecord = await transaction.FindIdempotencyRecordAsync(\n            userId,\n            idempotencyKey,\n            cancellationToken);\n        if (storedRecord is not null)\n        {\n            return ReplayStoredResult(storedRecord, requestHash);\n        }\n\n        CompanyRegistryResult company;\n        try\n        {\n            company = await companyRegistryGateway.LookupAsync(cnpj, cancellationToken);\n        }\n        catch (CompanyRegistryUnavailableException)\n        {\n            return RegisterTenantResult.DependencyUnavailable;\n        }\n\n        if (!string.Equals(company.RegistrationStatus, \"ATIVA\", StringComparison.Ordinal))\n        {\n            return RegisterTenantResult.CompanyInactive;\n        }\n\n        if (!foodCnaePolicy.IsEligible(company))\n        {\n            return RegisterTenantResult.IneligibleCnae;\n        }\n\n        if (await transaction.TenantExistsByCnpjAsync(cnpj.Value, cancellationToken))\n        {\n            return RegisterTenantResult.Conflict;\n        }\n\n        var tenant = Tenant.Create(\n            cnpj.Value,\n            command.LegalName,\n            command.Category,\n            command.BusinessEmail,\n            command.BusinessPhone,\n            TenantAddress.Create(\n                command.Address.Street,\n                command.Address.Number,\n                command.Address.District,\n                command.Address.City,\n                command.Address.State,\n                command.Address.PostalCode,\n                command.Address.Complement),\n            command.TradeName,\n            command.LegalNature,\n            command.PrimaryCnae);\n        var fiscalProfile = TenantFiscalProfile.Create(\n            tenant.Id,\n            command.FiscalProfile.TaxRegime,\n            command.FiscalProfile.FiscalEmail,\n            command.FiscalProfile.StateRegistration,\n            command.FiscalProfile.MunicipalRegistration,\n            command.FiscalProfile.IsStateRegistrationExempt);\n        var membership = TenantMembership.CreateOwnerAdmin(\n            tenant.Id,\n            userId,\n            command.IsLegalRepresentative,\n            command.Position);\n        var result = RegisterTenantResult.Created(tenant.Id);\n        var responseBody = JsonSerializer.Serialize(result);\n        var now = DateTimeOffset.UtcNow;\n\n        transaction.AddTenantRegistration(tenant, fiscalProfile, membership);\n        transaction.AddIdempotencyRecord(userId, idempotencyKey, requestHash, now);\n        transaction.CompleteIdempotencyRecord(CreatedStatusCode, responseBody, now);\n\n        try\n        {\n            await transaction.SaveChangesAsync(cancellationToken);\n            await transaction.CommitAsync(cancellationToken);\n        }\n        catch (PersistenceConflictException)\n        {\n            return RegisterTenantResult.Conflict;\n        }\n\n        return result;\n    }\n\n    private static RegisterTenantResult ReplayStoredResult(\n        StoredIdempotencyRecord storedRecord,\n        string requestHash)\n    {\n        if (!string.Equals(storedRecord.RequestHash, requestHash, StringComparison.Ordinal) ||\n            !storedRecord.IsCompleted ||\n            storedRecord.ResponseStatusCode != CreatedStatusCode ||\n            string.IsNullOrWhiteSpace(storedRecord.ResponseBody))\n        {\n            return RegisterTenantResult.Conflict;\n        }\n\n        return JsonSerializer.Deserialize<RegisterTenantResult>(storedRecord.ResponseBody)\n            ?? throw new InvalidOperationException(\"A resposta idempotente persistida é inválida.\");\n    }\n\n    private static string ComputeRequestHash(RegisterTenantCommand command, string canonicalCnpj)\n    {\n        var canonicalPayload = new\n        {\n            Cnpj = canonicalCnpj,\n            LegalName = NormalizeRequired(command.LegalName),\n            TradeName = NormalizeOptional(command.TradeName),\n            LegalNature = NormalizeOptional(command.LegalNature),\n            PrimaryCnae = NormalizeOptional(command.PrimaryCnae),\n            command.Category,\n            BusinessEmail = NormalizeRequired(command.BusinessEmail),\n            BusinessPhone = NormalizeRequired(command.BusinessPhone),\n            Address = new\n            {\n                Street = NormalizeRequired(command.Address.Street),\n                Number = NormalizeRequired(command.Address.Number),\n                District = NormalizeRequired(command.Address.District),\n                City = NormalizeRequired(command.Address.City),\n                State = NormalizeRequired(command.Address.State),\n                PostalCode = NormalizeRequired(command.Address.PostalCode),\n                Complement = NormalizeOptional(command.Address.Complement),\n            },\n            FiscalProfile = new\n            {\n                command.FiscalProfile.TaxRegime,\n                FiscalEmail = NormalizeRequired(command.FiscalProfile.FiscalEmail),\n                StateRegistration = NormalizeOptional(command.FiscalProfile.StateRegistration),\n                MunicipalRegistration = NormalizeOptional(command.FiscalProfile.MunicipalRegistration),\n                command.FiscalProfile.IsStateRegistrationExempt,\n            },\n            command.IsLegalRepresentative,\n            Position = NormalizeRequired(command.Position),\n        };\n        var serializedPayload = JsonSerializer.SerializeToUtf8Bytes(canonicalPayload);\n        return Convert.ToHexString(SHA256.HashData(serializedPayload)).ToLowerInvariant();\n    }\n\n    private static string NormalizeRequired(string value) => value?.Trim() ?? string.Empty;\n\n    private static string? NormalizeOptional(string? value) =>\n        string.IsNullOrWhiteSpace(value) ? null : value.Trim();\n}\n\r\nusing Agendamento.Domain.Identity;\nusing Agendamento.Domain.Tenants;\nusing Microsoft.EntityFrameworkCore;\nusing Microsoft.EntityFrameworkCore.Design;\n\nnamespace Agendamento.Infrastructure.Persistence;\n\npublic sealed class AgendamentoDbContext(DbContextOptions<AgendamentoDbContext> options) : DbContext(options)\n{\n    public DbSet<Tenant> Tenants => Set<Tenant>();\n\n    public DbSet<TenantFiscalProfile> TenantFiscalProfiles => Set<TenantFiscalProfile>();\n\n    public DbSet<TenantMembership> TenantMemberships => Set<TenantMembership>();\n\n    public DbSet<IdempotencyRecord> IdempotencyRecords => Set<IdempotencyRecord>();\n\n    protected override void OnModelCreating(ModelBuilder modelBuilder)\n    {\n        base.OnModelCreating(modelBuilder);\n        modelBuilder.ApplyConfigurationsFromAssembly(typeof(AgendamentoDbContext).Assembly);\n        ConfigureExistingUsers(modelBuilder);\n    }\n\n    private static void ConfigureExistingUsers(ModelBuilder modelBuilder)\n    {\n        var users = modelBuilder.Entity<User>();\n        users.ToTable(\"Users\", table => table.ExcludeFromMigrations());\n        users.HasKey(user => user.Id);\n        users.Property(user => user.Id).HasColumnName(\"Id\").ValueGeneratedNever();\n        users.Property(user => user.Cpf).HasColumnName(\"Cpf\").HasMaxLength(11).IsRequired();\n        users.Property(user => user.Email).HasColumnName(\"Email\").HasMaxLength(320).IsRequired();\n        users.Property(user => user.PasswordHash).HasColumnName(\"PasswordHash\").IsRequired();\n        users.Property(user => user.Status).HasColumnName(\"Status\").IsRequired();\n        users.Property(user => user.CreatedAtUtc).HasColumnName(\"CreatedAtUtc\").IsRequired();\n        users.Property(user => user.EmailVerifiedAtUtc).HasColumnName(\"EmailVerifiedAtUtc\");\n    }\n}\n\ninternal sealed class AgendamentoDbContextFactory : IDesignTimeDbContextFactory<AgendamentoDbContext>\n{\n    public AgendamentoDbContext CreateDbContext(string[] args)\n    {\n        var options = new DbContextOptionsBuilder<AgendamentoDbContext>()\n            .UseNpgsql(\"Host=localhost;Database=agendamento\")\n            .Options;\n\n        return new AgendamentoDbContext(options);\n    }\n}\n\r\nusing Microsoft.AspNetCore.Mvc.Testing;\r\n\r\nnamespace Agendamento.IntegrationTests.Infrastructure;\r\n\r\npublic sealed class AgendamentoApiFactory : WebApplicationFactory<Program>;\r\n\r\nusing System.Text;\r\nusing System.Net.Http.Json;\r\nusing Agendamento.Application.Identity;\r\nusing Agendamento.Application.Identity.CreateSession;\r\nusing Agendamento.Api.Features.Identity;\r\nusing Agendamento.Infrastructure.Identity;\r\nusing Agendamento.IntegrationTests.Infrastructure;\r\nusing Microsoft.AspNetCore.Hosting;\r\nusing Microsoft.AspNetCore.TestHost;\r\nusing Microsoft.Extensions.DependencyInjection;\r\nusing Xunit;\r\n\r\nnamespace Agendamento.IntegrationTests.Identity;\r\n\r\npublic sealed class SessionEndpointTests\r\n{\r\n    [Fact(DisplayName = \"@spec:AC-012 endpoint blocks a session for an unverified email\")]\r\n    public async Task Unverified_email_cannot_create_a_session()\r\n    {\r\n        using var client = CreateClient(isEmailVerified: false);\r\n\r\n        var outcome = await client.PostAsJsonAsync(\"/api/v1/auth/sessions\", new { email = \"admin@example.com\", password = \"senha-segura-12\" });\r\n\r\n        Assert.Equal(System.Net.HttpStatusCode.Forbidden, outcome.StatusCode);\r\n        Assert.Equal(\"application/problem+json\", outcome.Content.Headers.ContentType!.MediaType);\r\n    }\r\n\r\n    [Fact(DisplayName = \"@spec:AC-013 @principle:P-003 @principle:P-005 valid login emits only user_tenant_and_role\")]\r\n    public async Task Valid_login_emits_a_minimized_session_without_request_tenant_selection()\r\n    {\r\n        using var client = CreateClient(isEmailVerified: true);\r\n\r\n        var response = await client.PostAsJsonAsync(\"/api/v1/auth/sessions\", new\r\n        {\r\n            email = \"admin@example.com\",\r\n            password = \"senha-segura-12\",\r\n            tenantId = Guid.Parse(\"aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa\"),\r\n        });\r\n        var body = await response.Content.ReadFromJsonAsync<SessionResponse>();\r\n        var payload = DecodePayload(body!.AccessToken);\r\n\r\n        Assert.Equal(System.Net.HttpStatusCode.OK, response.StatusCode);\r\n        Assert.Contains(\"sub\", payload, StringComparison.Ordinal);\r\n        Assert.Contains(\"tenant_id\", payload, StringComparison.Ordinal);\r\n        Assert.Contains(\"d179ed2b-ca14-4507-8099-43d8183795a9\", payload, StringComparison.Ordinal);\r\n        Assert.DoesNotContain(\"aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa\", payload, StringComparison.Ordinal);\r\n        Assert.Contains(\"role\", payload, StringComparison.Ordinal);\r\n        Assert.DoesNotContain(\"cpf\", payload, StringComparison.OrdinalIgnoreCase);\r\n        Assert.DoesNotContain(\"password\", payload, StringComparison.OrdinalIgnoreCase);\r\n    }\r\n\r\n    private static HttpClient CreateClient(bool isEmailVerified)\r\n    {\r\n        var membership = new ActiveTenantMembership(Guid.Parse(\"d179ed2b-ca14-4507-8099-43d8183795a9\"), \"administrator\");\r\n        var identity = new AuthenticationIdentity(\r\n            Guid.Parse(\"b5578db1-1d94-4255-a4af-a9d2a60ce61b\"),\r\n            \"password-hash\",\r\n            isEmailVerified,\r\n            true,\r\n            membership);\r\n        return new AgendamentoApiFactory().WithWebHostBuilder(builder => builder.ConfigureTestServices(services =>\r\n        {\r\n            services.AddSingleton<IIdentityAuthenticationStore>(new InMemoryIdentityStore(identity));\r\n            services.AddSingleton<IPasswordService, AcceptingPasswordService>();\r\n            services.AddSingleton<ISessionIssuer>(new JwtSessionIssuer(\r\n                JwtSessionIssuerOptions.Create(\"a-test-only-signing-key-that-is-not-production\")));\r\n            services.AddTransient<CreateSessionHandler>();\r\n        })).CreateClient();\r\n    }\r\n\r\n    private static string DecodePayload(string token)\r\n    {\r\n        var encoded = token.Split('.')[1].Replace('-', '+').Replace('_', '/');\r\n        encoded = encoded.PadRight(encoded.Length + ((4 - encoded.Length % 4) % 4), '=');\r\n        return Encoding.UTF8.GetString(Convert.FromBase64String(encoded));\r\n    }\r\n\r\n    private sealed class InMemoryIdentityStore(AuthenticationIdentity identity) : IIdentityAuthenticationStore\r\n    {\r\n        public Task<AuthenticationIdentity?> FindByNormalizedEmailAsync(string normalizedEmail, CancellationToken cancellationToken) =>\r\n            Task.FromResult<AuthenticationIdentity?>(normalizedEmail == \"admin@example.com\" ? identity : null);\r\n    }\r\n\r\n    private sealed class AcceptingPasswordService : IPasswordService\r\n    {\r\n        public string Hash(string password) => \"password-hash\";\r\n\r\n        public bool Verify(string passwordHash, string password) =>\r\n            passwordHash == \"password-hash\" && password == \"senha-segura-12\";\r\n    }\r\n}\r\n\r\n<Project Sdk=\"Microsoft.NET.Sdk\">\r\n  <PropertyGroup>\r\n    <TargetFramework>net10.0</TargetFramework>\r\n    <ImplicitUsings>enable</ImplicitUsings>\r\n    <Nullable>enable</Nullable>\r\n    <IsPackable>false</IsPackable>\r\n    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>\r\n  </PropertyGroup>\r\n\r\n  <ItemGroup>\r\n    <PackageReference Include=\"Microsoft.AspNetCore.Mvc.Testing\" />\r\n    <PackageReference Include=\"Microsoft.NET.Test.Sdk\" />\r\n    <PackageReference Include=\"Testcontainers.PostgreSql\" />\r\n    <PackageReference Include=\"xunit\" />\r\n    <PackageReference Include=\"xunit.runner.visualstudio\"><PrivateAssets>all</Pri